{%- liquid
  assign layout = layout | default: 'vertical'
  assign clear_all_url = clear_all_url | default: request.path
-%}

{%- case layout -%}
  {%- when 'horizontal' -%}
    <form id="{{ form_id }}" action="{{ request.path }}" method="get" class="facets facets--horizontal">
      {{ extra_hidden_inputs }}
      <div class="facets__toolbar">
        <span class="facets__toolbar-label">{{ 'search.filters' | t: default: 'Filter:' }}</span>

        {%- for filter in filters -%}
          <details class="facets__dropdown" data-facet-dropdown data-facet-toolbar-dropdown data-facet-key="{{ filter.label | handleize }}">
            <summary class="facets__dropdown-trigger">
              {{ filter.label }}
              {%- if filter.active_values.size > 0 -%}
                <span class="facets__badge">{{ filter.active_values.size }}</span>
              {%- endif -%}
            </summary>
            <div class="facets__dropdown-panel">
              <div class="facets__dropdown-panel-header">
                <span>
                  {{ filter.active_values.size }}
                  {{ 'search.selected' | t: default: 'selected' }}
                </span>
                <button type="button" class="facets__dropdown-reset" data-facet-reset>
                  {{ 'collections.general.clear_filter' | t: default: 'Reset' }}
                </button>
              </div>
              {%- render 'facets-fields', filter: filter, form_id: form_id -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
      <noscript
        ><button type="submit">{{ 'search.apply' | t: default: 'Apply filters' }}</button></noscript
      >
    </form>

  {%- when 'drawer' -%}
    {%- assign active_count = 0 -%}
    {%- for filter in filters -%}
      {%- assign active_count = active_count | plus: filter.active_values.size -%}
      {%- if filter.type == 'price_range' and filter.min_value.value != blank or filter.max_value.value != blank -%}
        {%- assign active_count = active_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    <button
      type="button"
      class="facets-drawer-trigger"
      data-facets-drawer-trigger
      aria-haspopup="dialog"
      aria-controls="FacetsDrawer-{{ form_id }}"
    >
      {{ 'search.filters' | t: default: 'Filter' }}
      {%- if active_count > 0 -%}
        <span class="facets__badge">{{ active_count }}</span>
      {%- endif -%}
    </button>

    <dialog id="FacetsDrawer-{{ form_id }}" class="facets-drawer" data-facets-drawer>
      <div class="facets-drawer__panel">
        <div class="facets-drawer__header">
          <p class="facets-drawer__title">{{ 'search.filters' | t: default: 'Filters' }}</p>
          <button
            type="button"
            class="facets-drawer__close"
            data-facets-drawer-close
            aria-label="{{ 'accessibility.close' | t: default: 'Close' }}"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <form
          id="{{ form_id }}"
          action="{{ request.path }}"
          method="get"
          class="facets facets--vertical facets-drawer__form"
        >
          {{ extra_hidden_inputs }}
          {%- for filter in filters -%}
            <div class="facets__group">
              <p class="facets__title">{{ filter.label }}</p>
              {%- render 'facets-fields', filter: filter, form_id: form_id -%}
            </div>
          {%- endfor -%}
        </form>

        <div class="facets-drawer__footer">
          <button type="submit" form="{{ form_id }}" class="facets-drawer__apply">
            {{ 'search.apply' | t: default: 'Apply filters' }}
          </button>
        </div>
      </div>
    </dialog>

  {%- else -%}

    {%- assign has_active_filters = false -%}
    {%- for filter in filters -%}
      {%- if filter.active_values.size > 0 -%}
        {%- assign has_active_filters = true -%}
      {%- endif -%}
      {%- if filter.type == 'price_range' and filter.min_value.value != blank or filter.max_value.value != blank -%}
        {%- assign has_active_filters = true -%}
      {%- endif -%}
    {%- endfor -%}

    <form id="{{ form_id }}" action="{{ request.path }}" method="get" class="facets facets--vertical">
      {{ extra_hidden_inputs }}

      <div class="facets__header">
        <p class="facets__header-title">{{ 'search.filters' | t: default: 'Filters' }}</p>
        {%- if has_active_filters -%}
          <a href="{{ clear_all_url }}" class="facets__header-clear" data-clear-all>
            {{ 'collections.general.clear_filter' | t: default: 'Clear all' }}
          </a>
        {%- endif -%}
      </div>

      {%- for filter in filters -%}
        {%- assign group_active = false -%}
        {%- if filter.active_values.size > 0 -%}
          {%- assign group_active = true -%}
        {%- endif -%}
        {%- if filter.type == 'price_range' and filter.min_value.value != blank or filter.max_value.value != blank -%}
          {%- assign group_active = true -%}
        {%- endif -%}

        <details
          class="facets__accordion"
          data-facet-dropdown
          data-facet-key="{{ filter.label | handleize }}"
          {% if group_active %}
            open
          {% endif %}
        >
          <summary class="facets__accordion-trigger">
            <span class="facets__accordion-label">{{ filter.label }}</span>
            {%- if filter.active_values.size > 0 -%}
              <span class="facets__badge">{{ filter.active_values.size }}</span>
            {%- endif -%}
          </summary>
          <div class="facets__accordion-panel">
            {%- render 'facets-fields', filter: filter, form_id: form_id -%}
          </div>
        </details>
      {%- endfor -%}

      <noscript>
        <button type="submit">{{ 'search.apply' | t: default: 'Apply filters' }}</button>
      </noscript>
    </form>
{%- endcase -%}
