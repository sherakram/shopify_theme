<form id="{{ form_id }}" class="facets">
  {{ extra_hidden_inputs }}

  {%- for filter in filters -%}
    <div class="facets__group">
      <p class="facets__title">{{ filter.label }}</p>

      {%- case filter.type -%}
        {%- when 'list' -%}
          <ul class="facets__list">
            {%- for value in filter.values -%}
              <li>
                <label>
                  <input
                    type="checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    {% if value.active %}
                      checked
                    {% endif %}
                    {% if value.count == 0 and value.active == false %}
                      disabled
                    {% endif %}
                    onchange="document.getElementById('{{ form_id }}').submit()"
                  >
                  {{ value.label }} ({{ value.count }})
                </label>
              </li>
            {%- endfor -%}
          </ul>

        {%- when 'price_range' -%}
          <div class="facets__price">
            <label class="visually-hidden" for="{{ form_id }}-PriceMin">
              {{- 'search.min_price' | t: default: 'Min price' -}}
            </label>
            <input
              type="number"
              id="{{ form_id }}-PriceMin"
              name="{{ filter.min_value.param_name }}"
              value="{{ filter.min_value.value }}"
              placeholder="{{ filter.range_min | money_without_currency }}"
              min="0"
            >
            <span aria-hidden="true">–</span>
            <label class="visually-hidden" for="{{ form_id }}-PriceMax">
              {{- 'search.max_price' | t: default: 'Max price' -}}
            </label>
            <input
              type="number"
              id="{{ form_id }}-PriceMax"
              name="{{ filter.max_value.param_name }}"
              value="{{ filter.max_value.value }}"
              placeholder="{{ filter.range_max | money_without_currency }}"
              min="0"
            >
          </div>

        {%- when 'boolean' -%}
          <ul class="facets__list">
            {%- for value in filter.values -%}
              <li>
                <label>
                  <input
                    type="checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    {% if value.active %}
                      checked
                    {% endif %}
                    onchange="document.getElementById('{{ form_id }}').submit()"
                  >
                  {{ value.label }} ({{ value.count }})
                </label>
              </li>
            {%- endfor -%}
          </ul>
      {%- endcase -%}
    </div>
  {%- endfor -%}

  <noscript
    ><button type="submit">{{ 'search.apply' | t: default: 'Apply filters' }}</button></noscript
  >
</form>
