<article class="blog-card">
  <a href="{{ article.url }}" class="blog-card__link">
    <div class="blog-card__media">
      {% if article.image %}
        <img
          class="blog-card__image"
          src="{{ article.image | image_url: width: 600 }}"
          srcset="
            {{ article.image | image_url: width: 400 }} 400w,
            {{ article.image | image_url: width: 600 }} 600w,
            {{ article.image | image_url: width: 800 }} 800w
          "
          sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
          alt="{{ article.image.alt | default: article.title | escape }}"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="blog-card__placeholder">
          {{ 'image' | placeholder_svg_tag: 'blog-card__placeholder-svg' }}
        </div>
      {% endif %}
    </div>

    <div class="blog-card__content">
      {% if show_tags and article.tags.size > 0 %}
        <span class="blog-card__tag">{{ article.tags.first }}</span>
      {% endif %}

      <h3 class="blog-card__title">{{ article.title }}</h3>

      {% if show_excerpt %}
        <p class="blog-card__excerpt">
          {% if article.excerpt.size > 0 %}
            {{ article.excerpt | strip_html | truncatewords: 20 }}
          {% else %}
            {{ article.content | strip_html | truncatewords: 20 }}
          {% endif %}
        </p>
      {% endif %}

      {% if show_author or show_date %}
        <div class="blog-card__meta">
          {% if show_author %}
            <span class="blog-card__author">{{ article.author }}</span>
          {% endif %}
          {% if show_author and show_date %}
            <span class="blog-card__divider" aria-hidden="true">&middot;</span>
          {% endif %}
          {% if show_date %}
            <time class="blog-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
              {{ article.published_at | date: '%B %d, %Y' }}
            </time>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </a>
</article>