{%- comment -%} snippets/product-media.liquid - expects `media` variable {%- endcomment -%}

<div class="product-media-item">
  {% assign media_type = media.media_type %}
  {% case media_type %}
    {% when 'image' %}
      <div class="swiper-zoom-container">
        {% if forloop.first %}
          {{
            media
            | image_url: width: 2048
            | image_tag:
            class: 'product-media__image',
            alt: media.alt | default: product.title,
            loading: 'eager',
            fetchpriority: 'high',
            widths: '360,540,720,900,1080,1440,1800,2048',
            sizes: '(max-width: 768px) 100vw, 50vw'
          }}
        {% else %}
          {{
            media
            | image_url: width: 2048
            | image_tag:
            class: 'product-media__image',
            alt: media.alt | default: product.title,
            loading: 'lazy',
            fetchpriority: 'auto',
            widths: '360,540,720,900,1080,1440,1800,2048',
            sizes: '(max-width: 768px) 100vw, 50vw'
          }}
        {% endif %}

      </div>

    {% when 'video' %}
      <div class="product-video">
        {{ media | video_tag: 
            autoplay: true, 
            loop: true, 
            muted: true, 
            playsinline: true, 
            controls: true, 
            class: 'media-video' 
        }}
      </div>

    {% when 'external_video' %}
      <div class="product-external-video">
        {%- if media.host == 'youtube' -%}
          {{ media | external_video_tag: autoplay: true, loop: true, playlist: media.external_id, class: 'media-video' }}
        {%- else -%}
          {{ media | external_video_tag: autoplay: true, loop: true, class: 'media-video' }}
        {%- endif -%}
      </div>

    {% when 'model' %}
      <div class="product-model" data-media-id="{{ media.id }}">
        {{ media | model_viewer_tag: 
            reveal: 'interaction', 
            toggleable: true, 
            data-model-id: media.id, 
            class: 'media-model-viewer',
            camera-controls: true,
            auto-rotate: true
        }}
      </div>

    {% else %}
      {{ media | image_url: width: 208 | image_tag: class: 'product-media__image', alt: media.alt | default: product.title, loading: 'lazy', fetchpriority: 'auto', widths: '360,540,720,900,1080,1440,1800,2048', sizes: '(max-width: 768px) 100vw, 50vw' }}
  {% endcase %}
</div>
