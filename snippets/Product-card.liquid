{%- comment -%}
  Snippet : product-card.liquid
  Accepts :
    product      {object}  – required
    show_vendor  {bool}    – optional, default false
    show_reviews {bool}    – optional, default false
    show_quick_add {bool}  – optional, default false
    lazy         {number}  – forloop.index; first 4 cards load eagerly
{%- endcomment -%}

{%- liquid
  assign show_vendor = show_vendor | default: settings.show_vendor
  assign show_reviews = show_reviews | default: settings.show_reviews
  assign show_quick_add = show_quick_add | default: settings.show_quick_add
  assign show_secondary_image = show_secondary_image | default: settings.show_secondary_image
  assign quick_add_hover_only = quick_add_hover_only | default: settings.enable_quick_button_on_hover
  assign quick_multiple_options = quick_multiple_options | default: settings.enable_selected_varaint_quick_add

  assign loading = 'lazy'
  if lazy <= 4
    assign loading = 'eager'
  endif

  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
    assign savings_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
  endif

  assign sold_out = false
  unless product.available
    assign sold_out = true
  endunless

  assign any_quick_button = false
  if sold_out == false
    if product.variants.size == 1 and show_quick_add
      assign any_quick_button = true
    endif
    if product.variants.size > 1 and quick_multiple_options
      assign any_quick_button = true
    endif
  endif
-%}

<article
  class="pc{% if sold_out %} pc--sold-out{% endif %}{% if quick_add_hover_only and any_quick_button %} pc--quick-hover{% endif %}"
  style="--image-ratio: var(--product-card-image-ratio, 1/1);"
  aria-label="{{ product.title | escape }}"
>
  {{- '<!-- Product Card: ' | append: product.title | append: ' -->' -}}

  {%- comment -%} ── Image ── {%- endcomment -%}
  <a href="{{ product.url }}" class="pc__media" aria-hidden="true" tabindex="-1">
    <div class="pc__image-wrap">
      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 600
          | image_tag:
            class: 'pc__image',
            loading: loading,
            widths: '300, 400, 500, 600',
            sizes: '(max-width: 767px) 50vw, 25vw',
            alt: product.featured_image.alt
          | default: product.title
        }}

        {%- if product.images[1] and show_secondary_image -%}
          {{
            product.images[1]
            | image_url: width: 600
            | image_tag:
              class: 'pc__image pc__image--hover',
              loading: 'lazy',
              widths: '300, 400, 500, 600',
              sizes: '(max-width: 767px) 50vw, 25vw',
              alt: product.images[1].alt
            | default: product.title
          }}
        {%- endif -%}

      {%- else -%}
        <span class="pc__placeholder">
          {{ 'product-apparel-3' | placeholder_svg_tag: 'pc__placeholder-svg' }}
        </span>
      {%- endif -%}
    </div>

    <div class="pc__badges pc__badges--{{ settings.badge_position }}">
      {%- if sold_out -%}
        <span class="pc__badge badge pc__badge--sold-out color-scheme-{{ settings.badge_soldout_scheme }}">{{ 'products.sold_out_label' | t }}</span>
      {%- elsif product.metafields.custom.badge_text != blank -%}
        <span class="pc__badge badge pc__badge--sale color-scheme-{{ settings.badge_sale_scheme }}">{{ product.metafields.custom.badge_text }}</span>
        
      {%- elsif on_sale -%}
        {%- case settings.sale_badge_type -%}

          {%- when 'percent' -%}
            <span class="pc__badge badge pc__badge--sale color-scheme-{{ settings.badge_sale_scheme }}"> -{{ savings_pct }}% </span>

          {%- when 'text' -%}
            <span class="pc__badge badge pc__badge--sale color-scheme-{{ settings.badge_sale_scheme }}">
              {{ settings.sale_badge_text }}
            </span>

          {%- when 'save_amount' -%}
            {%- assign save_amount = product.compare_at_price | minus: product.price -%}
            <span class="pc__badge badge pc__badge--sale color-scheme-{{ settings.badge_sale_scheme }}"> Save {{ save_amount | money }} </span>
        {%- endcase -%}
      {%- endif -%}
    </div>

    {%- comment -%} ── Quick add ── {%- endcomment -%}
    {%- if sold_out == false -%}
      {%- if product.variants.size == 1 and show_quick_add -%}
        <div class="pc__quick-add">
          <form action="{{ routes.cart_add_url }}" method="post">
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
            <button type="submit" class="pc__quick-btn" aria-label="{{ 'products.add_to_cart' | t }}">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                <line x1="3" y1="6" x2="21" y2="6"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
              <span>{{ 'products.add_to_cart' | t }}</span>
            </button>
          </form>
        </div>
      {% endif %}

      {% if product.variants.size > 1 and quick_multiple_options %}
        <div class="pc__quick-add">
          <button
            type="button"
            class="pc__quick-btn"
            onclick="window.location.href='{{ product.url }}'"
            aria-label="{{ 'products.select_options' | t }}"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <span>{{ 'products.select_options' | t }}</span>
          </button>
        </div>
      {% endif %}
    {%- endif -%}
  </a>

  {%- comment -%} ── Info ── {%- endcomment -%}
  <div class="pc__info">
    {%- if show_vendor and product.vendor != blank -%}
      <p class="pc__vendor">{{ product.vendor }}</p>
    {%- endif -%}

    <h3 class="pc__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    <div class="pc__price price">
      {%- if on_sale -%}
        <span class="pc__price-compare">{{ product.compare_at_price | money }}</span>
        <span class="pc__price-sale">{{ product.price | money }}</span>
      {%- elsif sold_out -%}
        <span class="pc__price-soldout">{{ 'products.sold_out_label' | t }}</span>
      {%- else -%}
        <span class="pc__price-regular">{{ product.price | money }}</span>
      {%- endif -%}
    </div>

    {%- if show_reviews -%}
      <div class="pc__reviews" aria-label="Product reviews">
        {%- comment -%} {% render 'star-rating', product: product %} {%- endcomment -%}
      </div>
    {%- endif -%}
  </div>
</article>
