<div class="product-media-layout product-media-layout--carousel">
  <div class="product-media-wrapper product-media-{{ section.settings.thumb_position }}">
    <div class="product-media-column">
      <div class="product-swiper product-swiper--carousel">
        <div class="swiper-wrapper">
          {% for media in product.media %}

            <div class="swiper-slide" data-media-id="{{ media.id }}" {% if media.media_type == 'image' and media.variant_ids.size > 0 %}
                data-variant-ids="{{ media.variant_ids | join: ',' }}"
              {% endif %}>
              {% render 'product-media', media: media %}
            </div>
          {% endfor %}
        </div>

        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      </div>
    </div>
  </div>
</div>
