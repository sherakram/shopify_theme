<a class="collection-card" href="{{ collection.url }}" aria-label="{{ collection.title }}">
  <div class="collection-card__media">
    {% if collection.featured_image %}
      {%
        render 'image',
        class: 'collection-card__image',
        image: collection.featured_image,
        alt: collection.featured_image.alt | default: collection.title,
        width: 800
      %}
    {% else %}
      {{ 'collection-apparel-4' | placeholder_svg_tag: 'collection-card__image' }}
    {% endif %}
  </div>

  <div class="collection-card__overlay"></div>

  <div class="collection-card__body">
    <div class="collection-card__text">
      <h2 class="collection-card__title">{{ collection.title }}</h2>
      {% if section.settings.show_product_count %}
        <span class="collection-card__count">
          {{ collection.all_products_count }}
          {{ 'collections.general.collection_product_count' | t }}
        </span>
      {% endif %}
    </div>
    <span class="collection-card__arrow" aria-hidden="true">↗</span>
  </div>
</a>
