<a class="collection-card" href="{{ collection.url }}" style="--collection-card-bg: {{ section.settings.card_background }};">
      {% if collection.featured_image %}
        {% render 'image',
          class: 'collection-card__image',
          image: collection.featured_image,
          width: 600,
          height: 600,
          crop: 'center'
        %}
      {% else %}
        {{ 'collection-apparel-4' | placeholder_svg_tag: 'collection-card__image' }}
      {% endif %}

      <div class="collection-card__content" style="--card-text-align:{{ section.settings.title_alignment }}">
        <h2 class="collection-title" style="--hover-color:{{ section.settings.card_hover_color }};">{{ collection.title }}</h2> 

        {% if collection.description %}
          <p class="des">{{ collection.description | strip_html | truncatewords: 15 }}</p>
        {% endif %}

        <span class="count">{{ collection.all_products_count }} {{ 'collections.general.collection_product_count' | t }}</span>
      </div>
</a>

{% style %}
  /* =========================
   Collection Card
   ========================= */
.collection-card {
  display: flex;
  flex-direction: column;
  background: var(--collection-card-bg);
  border-radius: var(--style-border-radius);
  overflow: hidden;
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  text-decoration: none;
  box-shadow: var(--card-shadow-horizontal-offset, 0px) var(--card-shadow-vertical-offset, 0px) var(--card-shadow-blur, 10px) rgba(0, 0, 0, var(--card-shadow-opacity, 0.1));
  /* transition: transform 0.3s ease, box-shadow 0.3s ease; */
}

/* Desktop max-width */
@media (min-width: 993px) {
  .collection-card {
    max-width: var(--grid-cards-max-width-desktop);
  }
}

/* Tablet max-width */
@media (max-width: 992px) and (min-width: 577px) {
  .collection-card {
    max-width: var(--grid-cards-max-width-tablet);
  }
}

/* Mobile max-width */
@media (max-width: 576px) {
  .collection-card {
    max-width: var(--grid-cards-max-width-mobile);
  }
}

.collection-card__image {
  width: 100%;
  height: auto;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease-in-out;
}

.collection-card__image:hover {
  transform: scale(1.05);
}

/* =========================
   Collection Content
   ========================= */
.collection-card__content {
  padding: 20px;
  text-align: var(--card-text-align);
}

.collection-title {
  font-size: 1.25rem;
  font-weight: 700;
  margin: 0 0 10px;
  line-height: 1.3;
  text-transform: uppercase;
  transition: color 0.3s ease;
}

@media (max-width: 768px) {
    .collection-title {
        font-size: 0.9rem;
    }
}

.collection-card:hover .collection-title {
  color: var(--hover-color); /* modern accent blue */
}

.des {
  font-size: 0.95rem;
}

.count {
    font-size: small;
    color: #9999;
}
{% endstyle %}