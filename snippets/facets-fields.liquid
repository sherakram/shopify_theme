{%- case filter.type -%}
  {%- when 'list' -%}
    <ul class="facets__list">
      {%- for value in filter.values -%}
        <li>
          <label>
            <input
              type="checkbox"
              class="facets__checkbox"
              name="{{ value.param_name }}"
              value="{{ value.value }}"
              {% if value.active %}
                checked
              {% endif %}
              {% if value.count == 0 and value.active == false %}
                disabled
              {% endif %}
            >
            {{ value.label }} ({{ value.count }})
          </label>
        </li>
      {%- endfor -%}
    </ul>

  {%- when 'price_range' -%}
    <div class="facets__price">
      <label class="visually-hidden" for="{{ form_id }}-PriceMin-{{ filter.param_name | handleize }}">
        {{- 'search.min_price' | t: default: 'Min price' -}}
      </label>
      <input
        type="number"
        id="{{ form_id }}-PriceMin-{{ filter.param_name | handleize }}"
        name="{{ filter.min_value.param_name }}"
        value="{% unless filter.min_value.value == blank %}{{ filter.min_value.value | divided_by: 100.0 | round: 2 }}{% endunless %}"
        placeholder="{{ filter.range_min | money_without_currency }}"
        min="0"
        data-facet-price-input
      >
      <span aria-hidden="true">–</span>
      <label class="visually-hidden" for="{{ form_id }}-PriceMax-{{ filter.param_name | handleize }}">
        {{- 'search.max_price' | t: default: 'Max price' -}}
      </label>
      <input
        type="number"
        id="{{ form_id }}-PriceMax-{{ filter.param_name | handleize }}"
        name="{{ filter.max_value.param_name }}"
        value="{% unless filter.max_value.value == blank %}{{ filter.max_value.value | divided_by: 100.0 | round: 2 }}{% endunless %}"
        placeholder="{{ filter.range_max | money_without_currency }}"
        min="0"
        data-facet-price-input
      >
    </div>
    <button type="button" class="facets__price-apply" data-facet-price-apply>
      {{ 'search.apply' | t: default: 'Apply' }}
    </button>

  {%- when 'boolean' -%}
    <ul class="facets__list">
      {%- for value in filter.values -%}
        <li>
          <label>
            <input
              type="checkbox"
              class="facets__checkbox"
              name="{{ value.param_name }}"
              value="{{ value.value }}"
              {% if value.active %}
                checked
              {% endif %}
            >
            {{ value.label }} ({{ value.count }})
          </label>
        </li>
      {%- endfor -%}
    </ul>
{%- endcase -%}
