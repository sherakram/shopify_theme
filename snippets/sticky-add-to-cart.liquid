<div
  id="product-sticky-cart-{{ section.id }}"
  class="product__sticky-cart is-hidden"
  aria-hidden="true"
  aria-label="{{ 'products.product.sticky_cart_label' | t | default: 'Sticky add to cart' }}"
  role="region"
  inert
>
  <div class="product__sticky-cart-wrapper">

    {%- comment -%} ── Product thumbnail ── {%- endcomment -%}
    {%- if product.featured_image -%}
      <div class="product__sticky-cart-media" aria-hidden="true">
        {{
          product.featured_image
          | image_url: width: 128
          | image_tag:
            width: 64,
            height: 64,
            loading: 'lazy',
            alt: ''
        }}
      </div>
    {%- endif -%}

    {%- comment -%} ── Title + price + selected options ── {%- endcomment -%}
    <div class="product__sticky-cart-info">
      <p class="product__sticky-cart-title">{{ product.title }}</p>

      <div class="product__sticky-cart-meta" aria-live="polite" aria-atomic="true">
        <span class="product__sticky-cart-price" data-sticky-price>
          {%- if product.compare_at_price_max > product.price -%}
            <s class="price--compare">{{ product.compare_at_price_max | money }}</s>
          {%- endif -%}
          <span class="price--current">{{ product.price | money }}</span>
        </span>

        {%- for option in product.options_with_values -%}
          <span class="product__sticky-cart-separator" aria-hidden="true"></span>
          <span
            class="product__sticky-cart-option"
            data-sticky-option="{{ option.name | handleize }}"
          >
            {{- product.selected_or_first_available_variant.options[forloop.index0] -}}
          </span>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ── Add to cart button — submits the existing product form ── {%- endcomment -%}
    <div class="product__sticky-cart-action">
      <button
        type="submit"
        name="add"
        form="product-form-{{ section.id }}"
        class="button button--filled product__sticky-cart-btn"
        data-sticky-add-btn
        {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        aria-label="{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }} — {{ product.title | escape }}"
      >
        {%- comment -%} Cart icon — inline SVG so no extra HTTP request {%- endcomment -%}
        <svg
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M15 8V6C15 4.343 13.657 3 12 3S9 4.343 9 6v2M18 16v3m0 0v3m0-3h-3m3 0h3M11 21H4.5L6.5 8h11l.597 3.882"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>

        <span class="product__sticky-cart-btn-text">
          {%- if product.selected_or_first_available_variant.available -%}
            {{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}
          {%- else -%}
            {{ 'products.product.sold_out' | t | default: 'Sold out' }}
          {%- endif -%}
        </span>
      </button>
    </div>

  </div>
</div>


{% stylesheet %}

.product__sticky-cart {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background-color: var(--color-background, #ffffff);
  border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.12));
  box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.07);

  /* Slide up to reveal, slide down to hide */
  transform: translateY(0);
  transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform;
}

.product__sticky-cart.is-hidden {
  transform: translateY(110%);  /* slightly over 100% so shadow never peeks */
  pointer-events: none;         /* prevent accidental click-through when hidden */
}

/* Respect user's motion preference — no animation at all */
@media (prefers-reduced-motion: reduce) {
  .product__sticky-cart,
  .product__sticky-cart.is-hidden {
    transition: none;
  }
}

/* -----------------------------------------------------------------------------
   Inner wrapper — centred, max-width matches your theme's page width
   ----------------------------------------------------------------------------- */
.product__sticky-cart-wrapper {
  display: flex;
  align-items: center;
  gap: 16px;
  max-width: var(--page-width, 1200px);
  margin: 0 auto;
  padding: 12px var(--page-width-margin, 20px);
}

/* -----------------------------------------------------------------------------
   Thumbnail
   ----------------------------------------------------------------------------- */
.product__sticky-cart-media {
  flex-shrink: 0;
  width: 52px;
  height: 52px;
  border-radius: var(--media-border-radius, 4px);
  overflow: hidden;
  border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
}

.product__sticky-cart-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* -----------------------------------------------------------------------------
   Info block — title, price, selected options
   ----------------------------------------------------------------------------- */
.product__sticky-cart-info {
  flex: 1;
  min-width: 0; /* allows text-overflow: ellipsis to work in a flex child */
}

.product__sticky-cart-title {
  margin: 0 0 4px;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-foreground, #1a1a1a);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product__sticky-cart-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
  font-size: 0.8125rem;
  color: var(--color-foreground, #1a1a1a);
}

/* Sale price */
.product__sticky-cart-price .price--compare {
  color: var(--color-foreground-secondary, #767676);
  text-decoration: line-through;
  margin-right: 2px;
}

.product__sticky-cart-price .price--current {
  font-weight: 600;
}

/* Visual divider between price and option labels */
.product__sticky-cart-separator {
  display: inline-block;
  width: 1px;
  height: 12px;
  background-color: var(--color-border, rgba(0, 0, 0, 0.2));
  vertical-align: middle;
  flex-shrink: 0;
}

.product__sticky-cart-option {
  color: var(--color-foreground-secondary, #555555);
}

/* -----------------------------------------------------------------------------
   CTA button
   ----------------------------------------------------------------------------- */
.product__sticky-cart-action {
  flex-shrink: 0;
}

.product__sticky-cart-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
}

/* Sold-out / unavailable state */
.product__sticky-cart-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  pointer-events: none;
}

/* -----------------------------------------------------------------------------
   Responsive
   ----------------------------------------------------------------------------- */

/* On small phones, hide the thumbnail to give the button more room */
@media screen and (max-width: 480px) {
  .product__sticky-cart-media {
    display: none;
  }

  .product__sticky-cart-title {
    font-size: 0.8125rem;
  }
}

/* On very narrow screens, stack info above button */
@media screen and (max-width: 360px) {
  .product__sticky-cart-wrapper {
    flex-wrap: wrap;
  }

  .product__sticky-cart-info {
    width: 100%;
  }
}

{% endstylesheet %}