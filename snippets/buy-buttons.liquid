{% assign section_id = section_id | default: 'global' %}

<div class="product-form" data-product-form-wrapper="{{ section_id }}">
  {% form 'product', product, id: "product-form-{{ section_id }}", class: "product-form-element" %}
    
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

    <div class="product-form-buttons spacing-style product-form-buttons--stacked">
      <div class="qty-cart qty-cart--{{ block.settings.qty_cart_layout }}">

        <!-- Quantity Selector -->
        <div class="quantity-selector" data-quantity>
          <button type="button" class="quantity-btn minus" aria-label="Decrease quantity">−</button>
          <input id="quantity-{{ section_id }}" type="number" name="quantity" value="1" min="1" step="1" aria-label="Quantity">
          <button type="button" class="quantity-btn plus" aria-label="Increase quantity">+</button>
        </div>

        <!-- Add to cart — type="button" rakho, type="submit" NAHI -->
        <button type="button" class="button add-to-cart-button" data-add-to-cart>
          <span class="add-to-cart-text">Add to cart</span>
          <span class="add-to-cart-added">✓ Added</span>
          <span
            class="add-to-cart-status visually-hidden"
            aria-live="polite"
            role="status"
            data-atc-status
          ></span>
        </button>
      </div>

      <!-- Buy it now -->
      <div class="accelerated-checkout-block">
        {{ form | payment_button }}
      </div>

    </div>
  {% endform %}
</div>

<script>
(function () {
  const wrapper = document.querySelector('[data-product-form-wrapper="{{ section_id }}"]');
  if (!wrapper) return;

  const form = wrapper.querySelector('form');
  if (!form) return;

  // Double init guard
  if (form.dataset.buyInit === 'true') return;
  form.dataset.buyInit = 'true';

  const variantInput = form.querySelector('input[name="id"]');
  const qtyInput     = form.querySelector('input[name="quantity"]');
  const minus        = form.querySelector('.quantity-btn.minus');
  const plus         = form.querySelector('.quantity-btn.plus');
  const addBtn       = form.querySelector('[data-add-to-cart]');

  // ✅ Quantity minus
  if (minus && qtyInput) {
    minus.addEventListener('click', function () {
      const val = parseInt(qtyInput.value, 10) || 1;
      if (val > 1) qtyInput.value = val - 1;
    });
  }

  // ✅ Quantity plus
  if (plus && qtyInput) {
    plus.addEventListener('click', function () {
      const val = parseInt(qtyInput.value, 10) || 1;
      qtyInput.value = val + 1;
    });
  }

  // ✅ variant:change
  document.addEventListener('variant:change', function (e) {
    const variant = e.detail && e.detail.variant;
    if (!variant) return;

    if (variantInput) variantInput.value = variant.id;

    if (addBtn) {
      const textEl = addBtn.querySelector('.add-to-cart-text');
      if (variant.available) {
        addBtn.disabled = false;
        if (textEl) textEl.textContent = 'Add to cart';
      } else {
        addBtn.disabled = true;
        if (textEl) textEl.textContent = 'Sold out';
      }
    }
  });

  // ✅ Add to cart — form submit nahi, sirf button click
  if (!addBtn) return;

  let isSubmitting = false;

  addBtn.addEventListener('click', function () {
    if (isSubmitting) return;

    isSubmitting = true;
    addBtn.disabled = true;

    // Form se fresh data lo
    const formData = new FormData();
    formData.append('id', variantInput ? variantInput.value : '');
    formData.append('quantity', qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1);

    fetch('/cart/add.js', { method: 'POST', body: formData })
      .then(function (r) {
        if (!r.ok) throw r;
        return r.json();
      })
      .then(function (item) {
        console.log('Added to cart:', item);
        addBtn.classList.add('added');
        const status = form.querySelector('[data-atc-status]');
        if (status) status.textContent = 'Added to cart';

        // ✅ Cart count live update
        fetch('/cart.js')
          .then(function (r) { return r.json(); })
          .then(function (cart) {
            const countEl = document.querySelector('.cart-count');
            if (countEl) {
              countEl.textContent = cart.item_count;
              if (cart.item_count > 0) {
                countEl.classList.remove('is-empty');
              } else {
                countEl.classList.add('is-empty');
              }
            }
          });

        setTimeout(function () {
          addBtn.classList.remove('added');
          addBtn.disabled = false;
          isSubmitting = false;
        }, 2000);
      })
      .catch(function (err) {
        console.error('Cart add failed:', err);
        addBtn.disabled = false;
        isSubmitting = false;
        window.location.href = '/cart';
      });
  });

})();
</script>