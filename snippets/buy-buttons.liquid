<style>
  .product-form__error-message-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    padding: 12px 16px;
    background-color: #ef2d2d08;
    border: 1px solid #EF2D2D;
    border-radius: 0px;
    font-size: 14px;
    color: #333;
    line-height: 1.5;
  }
  .product-form__error-message-wrapper::before {
    content: "⚠";
    font-size: 1em;
    flex-shrink: 0;
    color: #EF2D2D;
  }

  .product-form__error-message-wrapper[hidden] {
    display: none !important;
  }
</style>

{% assign section_id = section_id | default: 'global' %}

<product-form class="product-form" data-section-id="{{ section_id }}">

  <form
    id="atc-form-{{ section_id }}"
    class="product-form-element"
    novalidate>

    <input
      type="hidden"
      name="id"
      value="{{ product.selected_or_first_available_variant.id }}"
      class="product-variant-id">

    <div class="product-form-buttons spacing-style product-form-buttons--stacked">
      <div class="qty-cart qty-cart--{{ block.settings.qty_cart_layout }}">

        <div class="quantity-selector" data-quantity>
          <button type="button" class="quantity-btn minus" aria-label="Decrease quantity">−</button>
          <input type="number" name="quantity" value="1" min="1" step="1" aria-label="Quantity">
          <button type="button" class="quantity-btn plus" aria-label="Increase quantity">+</button>
        </div>

        <button
          type="submit"
          name="add"
          class="button add-to-cart-button"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          <span class="atc-text">
            {%- if product.selected_or_first_available_variant.available -%}
              Add to cart
            {%- else -%}
              Sold out
            {%- endif -%}
          </span>
        </button>

      </div>

      {% form 'product', product, id: "payment-form-{{ section_id }}" %}
        <input type="hidden" name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          class="payment-variant-id">
        <div class="accelerated-checkout-block">
          {{ form | payment_button }}
        </div>
      {% endform %}

    </div>
  </form>

  <div class="product-form__error-message-wrapper" role="alert" hidden>
    <span class="product-form__error-message"></span>
  </div>

</product-form>