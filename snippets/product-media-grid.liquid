<div class="product-media-layout product-media-layout--grid">
  <div class="main-product__media--grid">
    {% for media in product.media %}

      <div class="grid-media-item" data-media-id="{{ media.id }}" {% if media.media_type == 'image' and media.variant_ids.size > 0 %}
          data-variant-ids="{{ media.variant_ids | join: ',' }}"
        {% endif %}>
        {% render 'product-media', media: media %}

        {%- comment -%} Zoom button on every media type {%- endcomment -%}
          {% if section.settings.show_zoom_button %}
            <button type="button" class="product-zoom-btn" aria-label="Open {{ media.media_type }}">
              {{ 'icon-zoom.svg' | inline_asset_content }}
            </button>
          {% endif %}
      
      </div>
    {% endfor %}

  </div>
</div>
