<div class="product-media-layout product-media-layout--grid">
  <div class="main-product__media--grid">
    {% for media in product.media %}
      <div class="grid-media-item" data-media-id="{{ media.id }}">
        {% render 'product-media', media: media %}
      </div>
    {% endfor %}
  </div>
</div>
