{{ '404.css' | asset_url | stylesheet_tag }}

{% if template.name == '404' %}
  {% liquid
    assign bg_type = section.settings.background_type
    assign placeholder_image = 'lifestyle-1'

    if section.settings.bg_image != blank
      assign bg_image_url = section.settings.bg_image | image_url: width: 2000
      assign is_placeholder = false
    else
      assign is_placeholder = true
    endif

    assign content_align = 'center'
    if section.settings.alignment == 'left'
      assign content_align = 'flex-start'
    elsif section.settings.alignment == 'right'
      assign content_align = 'flex-end'
    endif

    assign container_align = 'center'
    if section.settings.container_position == 'left'
      assign container_align = 'flex-start'
    elsif section.settings.container_position == 'right'
      assign container_align = 'flex-end'
    endif
  %}

  {% style %}
    #notfound-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top }}px;
      --padding-bottom: {{ section.settings.padding_bottom }}px;
      --container-position: {{ container_align }};
    }

    #notfound-{{ section.id }} .bg-overlay {
      opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      background: {{ section.settings.overlay_color | default: '#000000' }};
    }

    #notfound-{{ section.id }} .notfound-container {
      --container-align:{{ section.settings.alignment }};
      --container-align-items: {{ content_align }};
    }

    {% if section.settings.transparent_background %}
      #notfound-{{ section.id }} .notfound-container {
        background-color: transparent;
        backdrop-filter: none;
        box-shadow: none;
      }
    {% endif %}
  {% endstyle %}

  <div
    id="notfound-{{ section.id }}"
    class="notfound-page notfound-page--{{ section.settings.background_height }} full-width color-{{ section.settings.color_scheme }}"
  >
    {% if bg_type == 'image' %}
      <div class="page-background">
        {% if is_placeholder %}
          {{ placeholder_image | placeholder_svg_tag: '2000x1500' }}
        {% else %}
          <img
            src="{{ bg_image_url }}"
            alt=""
            role="presentation"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            width="2000"
            height="1500"
            srcset="
              {{ section.settings.bg_image | image_url: width: 750 }} 750w,
              {{ section.settings.bg_image | image_url: width: 1100 }} 1100w,
              {{ section.settings.bg_image | image_url: width: 1500 }} 1500w,
              {{ section.settings.bg_image | image_url: width: 2000 }} 2000w,
              {{ section.settings.bg_image | image_url: width: 2500 }} 2500w
            "
            sizes="100vw"
          >
        {% endif %}
        <div class="bg-overlay"></div>
      </div>

    {% elsif bg_type == 'video' %}
      <div class="notfound-video-wrapper">
        {% assign video = section.settings.bg_video %}
        {% if video != blank %}
          <video
            class="notfound-bg-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            {% if section.settings.bg_image != blank %}
              poster="{{ bg_image_url }}"
            {% endif %}
          >
            {% if video.sources %}
              {% for source in video.sources %}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {% endfor %}
            {% else %}
              <source src="{{ video | file_url }}" type="video/mp4">
            {% endif %}
          </video>
        {% else %}
          {{ placeholder_image | placeholder_svg_tag: '2000x1500' }}
        {% endif %}
        <div class="bg-overlay"></div>
      </div>
    {% endif %}

    <div class="notfound-container{% if section.settings.enable_shadow %} notfound-container--shadow{% endif %}">
      <span class="notfound-code" aria-hidden="true">404</span>

      <h1 class="notfound-heading">{{ section.settings.heading }}</h1>

      {% if section.settings.message != blank %}
        <p class="notfound-subtext">{{ section.settings.message }}</p>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <div class="notfound-actions">
          <a href="{{ section.settings.button_link | default: routes.root_url }}" class="notfound-button">
            {{ section.settings.button_text }}
          </a>
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <nav class="notfound-quicklinks" aria-label="{{ '404.quick_links' | t: default: 'Popular pages' }}">
          <ul>
            {% for block in section.blocks %}
              {% if block.type == 'quick_link' and block.settings.title != blank %}
                <li {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.title }}</a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:general.404",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "container_position",
      "label": "t:labels.container_position",
      "options": [
        {
          "label": "t:options.alignment.left",
          "value": "left"
        },
        {
          "label": "t:options.alignment.center",
          "value": "center"
        },
        {
          "label": "t:options.alignment.right",
          "value": "right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "label": "t:options.alignment.left",
          "value": "left"
        },
        {
          "label": "t:options.alignment.center",
          "value": "center"
        },
        {
          "label": "t:options.alignment.right",
          "value": "right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "background_height",
      "label": "Section height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full screen"
        }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "t:content.container"
    },
    {
      "type": "checkbox",
      "id": "transparent_background",
      "label": "t:labels.background",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.background_type"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:labels.background_select",
      "options": [
        {
          "value": "image",
          "label": "t:labels.image"
        },
        {
          "value": "video",
          "label": "t:labels.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "t:labels.background_image",
      "info": "t:informative_content.video_frame",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "bg_video",
      "label": "t:labels.background_video",
      "visible_if": "{{ section.settings.background_type == 'video' }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:settings.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Oops, page not found"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "The page you're looking for doesn't exist or has been moved."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Back to home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to homepage if left blank"
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Enable card shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.section_settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "quick_link",
      "name": "Quick link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Shop all"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["404"]
  }
}
{% endschema %}
