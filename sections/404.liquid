{{ 'base.css' | asset_url | stylesheet_tag }}
{{ '404.css' | asset_url | stylesheet_tag }}

{% if template.name == '404' %}
  {%- liquid
    assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  -%}

  <div
    class="notfound-hero color-{{ section.settings.color_scheme }} notfound-hero--{{ section.settings.background_height }}"
    style="--notfound-overlay-opacity: {{ overlay_alpha }}; --notfound-padding-top: {{ section.settings.padding_top }}px; --notfound-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >

    {%- if section.settings.background_type == 'image' and section.settings.background_image -%}
      <div class="notfound-hero__media" aria-hidden="true">
        <img
          src="{{ section.settings.background_image | image_url: width: 2000 }}"
          srcset="{{ section.settings.background_image | image_url: width: 750 }} 750w,
                  {{ section.settings.background_image | image_url: width: 1100 }} 1100w,
                  {{ section.settings.background_image | image_url: width: 1500 }} 1500w,
                  {{ section.settings.background_image | image_url: width: 2000 }} 2000w,
                  {{ section.settings.background_image | image_url: width: 2500 }} 2500w"
          sizes="100vw"
          width="{{ section.settings.background_image.width }}"
          height="{{ section.settings.background_image.height }}"
          alt=""
          loading="eager"
          fetchpriority="high"
        >
        <div class="notfound-hero__overlay"></div>
      </div>

    {%- elsif section.settings.background_type == 'video' and section.settings.background_video -%}
      <div class="notfound-hero__media notfound-hero__media--video" aria-hidden="true">
        {{
          section.settings.background_video
          | video_tag:
            image_size: '1920x',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            class: 'notfound-hero__video'
        }}
        <div class="notfound-hero__overlay"></div>
      </div>
    {%- endif -%}

    <div class="notfound-hero__content page-width">
      <div class="notfound-hero__card{% if section.settings.enable_shadow %} notfound-hero__card--shadow{% endif %}">

        <span class="notfound-hero__code" aria-hidden="true">404</span>

        <h1 class="notfound-hero__heading">{{ section.settings.heading }}</h1>

        {%- if section.settings.message != blank -%}
          <p class="notfound-hero__message">{{ section.settings.message }}</p>
        {%- endif -%}

        {%- if section.settings.show_search -%}
          <div class="notfound-hero__search">
            {%- comment -%} Swap this for your predictive-search component if you have one {%- endcomment -%}
            <form action="{{ routes.search_url }}" method="get" role="search" class="notfound-hero__search-form">
              <label for="NotFoundSearch-{{ section.id }}" class="visually-hidden">
                {{ 'search.placeholder' | t: default: 'Search our store' }}
              </label>
              <input
                type="search"
                name="q"
                id="NotFoundSearch-{{ section.id }}"
                class="notfound-hero__search-input"
                placeholder="{{ 'search.placeholder' | t: default: 'Search our store' }}"
                autocomplete="off"
              >
              <input type="hidden" name="type" value="product">
              <button
                type="submit"
                class="notfound-hero__search-submit"
                aria-label="{{ 'search.submit' | t: default: 'Search' }}"
              >
                <span aria-hidden="true">&#8594;</span>
              </button>
            </form>
          </div>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <div class="notfound-hero__actions">
            
            <a  href="{{ section.settings.button_link | default: routes.root_url }}"
              class="notfound-hero__button"
            >
              {{ section.settings.button_text }}
            </a>
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <nav class="notfound-hero__quicklinks" aria-label="{{ '404.quick_links' | t: default: 'Popular pages' }}">
            <ul>
              {%- for block in section.blocks -%}
                {%- if block.type == 'quick_link' and block.settings.title != blank -%}
                  <li {{ block.shopify_attributes }}>
                    <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.title }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:general.404",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "options": [
        { 
          "value": "image", 
          "label": "Image" 
        },
        { 
          "value": "video", 
          "label": "Video" 
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Used when Background type is set to Image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Used when Background type is set to Video. Muted, autoplay, loops.",
      "visible_if": "{{ section.settings.background_type == 'video' }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30,
      "info": "Applies to image and video backgrounds only"
    },
    {
      "type": "select",
      "id": "background_height",
      "label": "Section height",
      "options": [
        { 
          "value": "small", 
          "label": "Small" 
        },
        { 
          "value": "medium", 
          "label": "Medium" 
        },
        { 
          "value": "large", 
          "label": "Large" 
        },
        { 
          "value": "full", 
          "label": "Full screen" 
        }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Oops, page not found"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "The page you're looking for doesn't exist or has been moved."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Back to home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to homepage if left blank"
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Enable card shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.section_settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "quick_link",
      "name": "Quick link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Shop all"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}