{{ 'product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fc_collection = section.settings.collection
  assign fc_products_to_show = section.settings.products_to_show
  assign fc_columns_desktop = section.settings.columns_desktop
  assign fc_columns_mobile = section.settings.columns_mobile
  assign fc_has_products = false
  if fc_collection != blank and fc_collection.products.size > 0
    assign fc_has_products = true
  endif
-%}

<div
  class="featured-collection color-{{ section.settings.color_scheme }}"
  style="
    --fc-columns-desktop: {{ fc_columns_desktop }};
    --fc-columns-mobile: {{ fc_columns_mobile }};
    --fc-padding-top: {{ section.settings.padding_top }}px;
    --fc-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-labelledby="FeaturedCollection-heading-{{ section.id }}"
>
  <div class="page-width">
    <div class="featured-collection__layout">

      <div class="featured-collection__header">
        {%- if section.settings.subheading != blank -%}
          <p class="subheading featured-collection__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        <h2 id="FeaturedCollection-heading-{{ section.id }}" class="featured-collection__heading">
          {{ section.settings.heading | default: 'Featured collection' }}
        </h2>

        {%- if section.settings.description != blank -%}
          <div class="featured-collection__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_button and fc_collection != blank -%}
          <a
            href="{{ fc_collection.url }}"
            class="btn btn--secondary featured-collection__button"
          >
            <span>{{ section.settings.button_label | default: 'View all' }}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        {%- endif -%}
      </div>

      <div class="featured-collection__grid-wrap">
        {%- if fc_has_products -%}
          <ul class="featured-collection__grid" role="list">
            {%- for product in fc_collection.products limit: fc_products_to_show -%}
              <li class="featured-collection__item">
                {%- render 'product-card',
                  product: product,
                  lazy: forloop.index
                -%}
              </li>
            {%- endfor -%}
          </ul>

        {%- else -%}
          <ul class="featured-collection__grid featured-collection__grid--placeholder" role="list" aria-hidden="true">
            {%- for i in (1..4) -%}
              <li class="featured-collection__item featured-collection__placeholder">
                {{ 'product-apparel-' | append: forloop.index | placeholder_svg_tag: 'featured-collection__placeholder-svg' }}
              </li>
            {%- endfor -%}
          </ul>
          <p class="featured-collection__empty-note">
            Select a collection to display products here.
            {% comment %} {{ 'sections.featured_collection.no_collection' | t: default: 'Select a collection to display products here.' }} {% endcomment %}
          </p>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% stylesheet %}
  .featured-collection {
    padding-top: var(--fc-padding-top, 48px);
    padding-bottom: var(--fc-padding-bottom, 48px);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .featured-collection__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .featured-collection__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .featured-collection__subheading {
    color: var(--color-primary);
    margin: 0;
  }

  .featured-collection__heading {
    color: var(--color-foreground-heading);
    margin: 0;
    line-height: 1.1;
  }

  .featured-collection__description {
    max-width: 44ch;
    color: var(--color-foreground);
    opacity: 0.85;
  }

  .featured-collection__description p {
    margin: 0;
  }

  .featured-collection__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.75rem 1.25rem;
    min-height: 44px;
    border-radius: var(--style-border-radius, 4px);
    background-color: var(--color-btn-secondary-bg);
    color: var(--color-btn-secondary-text);
    border: 1px solid var(--color-btn-secondary-border);
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .featured-collection__button svg {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .featured-collection__button:hover {
    background-color: var(--color-btn-secondary-hover-bg);
    color: var(--color-btn-secondary-hover-text);
    border-color: var(--color-btn-secondary-hover-border);
  }

  .featured-collection__button:hover svg {
    transform: translateX(3px);
  }

  .featured-collection__button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--fc-columns-mobile, 1), minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .featured-collection__item {
    min-width: 0;
  }

  .featured-collection__item {
    opacity: 1;
    transform: none;
  }

  .featured-collection[data-fc-animate="true"] .featured-collection__item {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    transition-delay: calc(var(--fc-item-index, 0) * 60ms);
  }

  .featured-collection[data-fc-animate="true"] .featured-collection__item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-collection[data-fc-animate="true"] .featured-collection__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .featured-collection__grid--placeholder {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .featured-collection__placeholder-svg {
    width: 100%;
    height: auto;
    aspect-ratio: var(--product-card-image-ratio, 1/1);
    fill: var(--color-border);
  }

  .featured-collection__empty-note {
    margin-top: 1rem;
    color: var(--color-foreground);
    opacity: 0.7;
    font-size: 0.9375rem;
  }

  @media (min-width: 750px) {
    .featured-collection__grid,
    .featured-collection__grid--placeholder {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (min-width: 990px) {
    .featured-collection__layout {
      grid-template-columns: minmax(240px, 320px) 1fr;
      gap: 3rem;
      align-items: start;
    }

    .featured-collection__header {
      position: sticky;
      top: 2rem;
    }

    .featured-collection__grid {
      grid-template-columns: repeat(var(--fc-columns-desktop, 3), minmax(0, 1fr));
      gap: 1.75rem;
    }

    .featured-collection__grid--placeholder {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var sections = document.querySelectorAll('.featured-collection');
    if (!sections.length) return;

    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion || !('IntersectionObserver' in window)) return;

    sections.forEach(function (section) {
      var items = section.querySelectorAll('.featured-collection__item');
      if (!items.length) return;

      section.setAttribute('data-fc-animate', 'true');

      items.forEach(function (item, index) {
        item.style.setProperty('--fc-item-index', index % 8);
      });

      var observer = new IntersectionObserver(
        function (entries, obs) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
      );

      items.forEach(function (item) {
        observer.observe(item);
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section featured-collection-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop the edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A short line about this collection — what makes it worth a look.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { 
          "value": "1", 
          "label": "1 column" 
        },
        { 
          "value": "2", 
          "label": "2 columns" 
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show \"View all\" button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Featured collection: Editorial Split",
      "category": "Products",
      "settings": {
        "products_to_show": 8,
        "columns_desktop": 3
      }
    }
  ]
}
{% endschema %}
