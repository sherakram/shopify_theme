{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

{%- style -%}
  .featured-collection-{{ section.id }} {
    padding: 3rem 1.5rem;
  }

  .featured-collection-{{ section.id }}__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .featured-collection-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: 1rem 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .featured-collection-{{ section.id }}__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: 2rem 1.5rem;
    }
  }

  .featured-collection-{{ section.id }}__card {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .featured-collection-{{ section.id }}__image-wrap {
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    border-radius: var(--card-radius, 6px);
    background: var(--color-image-bg, #f4f4f4);
  }

  .featured-collection-{{ section.id }}__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .featured-collection-{{ section.id }}__card:hover img {
      transform: scale(1.03);
    }
  }

  .featured-collection-{{ section.id }}__title {
    margin: 0.75rem 0 0.25rem;
    font-size: 1rem;
    font-weight: 500;
  }

  .featured-collection-{{ section.id }}__price {
    font-size: 0.95rem;
    color: var(--color-secondary-text, #555);
  }

  /* WCAG 2.4.7 focus-visible, not a color-only affordance */
  .featured-collection-{{ section.id }}__card:focus {
    outline: none;
  }
  .featured-collection-{{ section.id }}__card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: var(--card-radius, 6px);
  }

  .featured-collection-{{ section.id }}__view-all {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{%- endstyle -%}

<section class="featured-collection-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="featured-collection-{{ section.id }}__header">
    {%- if section.settings.title != blank -%}
      <{{ section.settings.heading_size }}>{{ section.settings.title | escape }}</{{ section.settings.heading_size }}>
    {%- endif -%}

    {%- if section.settings.show_view_all and collection != blank -%}
      <a
        href="{{ collection.url }}"
        class="featured-collection-{{ section.id }}__view-all"
        aria-label="View all products in {{ collection.title | escape }}"
      >
        View all
      </a>
    {%- endif -%}
  </div>

  {%- if collection != blank and collection.products.size > 0 -%}
    <ul class="featured-collection-{{ section.id }}__grid" role="list" style="list-style:none; padding:0; margin:0;">
      {%- for product in collection.products limit: limit -%}
        <li>
          <a
            href="{{ product.url }}"
            class="featured-collection-{{ section.id }}__card"
            aria-label="{{ product.title | escape }}, {{ product.price | money }}"
          >
            <div class="featured-collection-{{ section.id }}__image-wrap">
              {%- if product.featured_image -%}
                {{-
                  product.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '275, 550, 850, 1200',
                    sizes: '(min-width: 750px) 25vw, 50vw',
                    alt: product.featured_image.alt
                -}}
              {%- else -%}
                {{- 'product-1' | placeholder_svg_tag: 'featured-collection-placeholder' -}}
              {%- endif -%}
            </div>
            <p class="featured-collection-{{ section.id }}__title" aria-hidden="true">{{ product.title }}</p>
            <p class="featured-collection-{{ section.id }}__price" aria-hidden="true">
              {{- product.price | money -}}
            </p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p>Select a collection in the theme editor to display products here.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading level",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "4 / 3", "label": "Landscape" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
