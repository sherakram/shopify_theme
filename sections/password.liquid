{% assign bg_type = section.settings.background_type %}
{% assign placeholder_image = 'lifestyle-1' %}

{% if section.settings.bg_image != blank %}
  {% assign bg_image_url = section.settings.bg_image | image_url: width: 2000 %}
  {% assign is_placeholder = false %}
{% else %}
  {% assign bg_image_url = placeholder_image | placeholder_svg_tag: '2000x1500' %}
  {% assign is_placeholder = true %}
{% endif %}

{% liquid
  assign content_align = 'center'
  if section.settings.alignment == 'left'
    assign content_align = 'flex-start'
  elsif section.settings.alignment == 'right'
    assign content_align = 'flex-end'
  endif

  assign container_align = 'center'
  if section.settings.container_position == 'left'
    assign container_align = 'flex-start'
  elsif section.settings.container_position == 'right'
    assign container_align = 'flex-end'
  endif
%}

{% style %}
  #password-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --container-position: {{ container_align }};
  }

  #password-{{ section.id }} .bg-overlay {
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    background: {{ section.settings.overlay_color | default: '#000000' }};
  }

  #password-{{ section.id }} .password-container {
    --container-align:{{ section.settings.alignment }};
    --gap-elements:{{ section.settings.gap }}px;
    --container-align-items: {{ content_align }};
    --newsletter-justify: {{ content_align }};
  }

  {% if section.settings.transparent_background %}
    #password-{{ section.id }} .password-container {
      background-color: transparent;
      backdrop-filter: none;
      box-shadow: none;
    }
  {% endif %}
{% endstyle %}

<div id="password-{{ section.id }}" class="password-page full-width color-{{ section.settings.color_scheme }}">
  {% if bg_type == 'image' %}
    <div class="page-background">
      {% if is_placeholder %}
        {{ 'lifestyle-1' | placeholder_svg_tag: '2000x1500' }}
      {% else %}
        <img
          src="{{ bg_image_url }}"
          alt=""
          role="presentation"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          width="2000"
          height="1500"
          srcset="
            {{ section.settings.bg_image | image_url: width: 750 }} 750w,
            {{ section.settings.bg_image | image_url: width: 1100 }} 1100w,
            {{ section.settings.bg_image | image_url: width: 1500 }} 1500w,
            {{ section.settings.bg_image | image_url: width: 2000 }} 2000w,
            {{ section.settings.bg_image | image_url: width: 2500 }} 2500w
          "
          sizes="100vw"
        >
      {% endif %}
      <div class="bg-overlay"></div>
    </div>

  {% elsif bg_type == 'video' %}
    <div class="password-video-wrapper">
      {% assign video = section.settings.bg_video %}
      {% if video != blank %}
        <video
          class="password-bg-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          {% if section.settings.bg_image != blank %}
            poster="{{ bg_image_url }}"
          {% endif %}
        >
          {% if video.sources %}
            {% for source in video.sources %}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {% endfor %}
          {% else %}
            <source src="{{ video | file_url }}" type="video/mp4">
          {% endif %}
        </video>
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: '2000x1500' }}
      {% endif %}
      <div class="bg-overlay"></div>
    </div>
  {% endif %}

  <div class="password-container">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'logo' %}
          <div class="password-logo" {{ block.shopify_attributes }}>
            {% if settings.logo_image %}
              <img
                src="{{ settings.logo_image | image_url: width: 200 }}"
                alt="{{ shop.name }}"
                width="{{ settings.logo_image.width | default: 200 }}"
                height="{{ settings.logo_image.height | default: 80 }}"
                loading="eager"
                decoding="async"
              >
            {% else %}
              <h1 class="shop-name">{{ shop.name }}</h1>
            {% endif %}
          </div>

        {% when 'heading' %}
          <div
            class="password-heading"
            {{ block.shopify_attributes }}
            style="--block-pt:{{ block.settings.padding_top }}px; --block-pb:{{ block.settings.padding_bottom }}px; --block-pl:{{ block.settings.padding_left }}px; --block-pr:{{ block.settings.padding_right }}px;"
          >
            {{ block.settings.heading | default: 'Opening soon' }}
          </div>

        {% when 'subtext' %}
          <div
            class="password-subtext"
            style="--block-pt:{{ block.settings.padding_top }}px; --block-pb:{{ block.settings.padding_bottom }}px; --block-pl:{{ block.settings.padding_left }}px; --block-pr:{{ block.settings.padding_right }}px;"
            {{ block.shopify_attributes }}
          >
            {{
              block.settings.sub_text
              | default: 'Sign up for our newsletter to be the first to know when we launch.'
            }}
          </div>

        {% when 'newsletter' %}
          <div
            class="password-newsletter"
            style="--border-radius:{{ block.settings.border_radius }}px; --max-width:{{ block.settings.signup_width }}px; --block-pt:{{ block.settings.padding_top }}px; --block-pb:{{ block.settings.padding_bottom }}px; --block-pl:{{ block.settings.padding_left }}px; --block-pr:{{ block.settings.padding_right }}px;"
            {{ block.shopify_attributes }}
          >
            {% form 'customer', id: 'ContactPassword', class: 'password-form' %}
              {% if form.posted_successfully? %}
                <p class="form-success" role="status" aria-live="polite">Thank you for signing up!</p>
              {% else %}
                <label for="EmailInput" class="visually-hidden">Email</label>
                <input
                  id="EmailInput"
                  type="email"
                  name="contact[email]"
                  placeholder="Email address"
                  class="password-input"
                  autocomplete="email"
                  required
                >
                <button type="submit" class="password-submit">
                  {{ block.settings.button_label | default: 'Sign up' }}
                </button>
              {% endif %}
            {% endform %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</div>

