      </svg>
    </a>
  </p>

  <div class="password-links">
    <button
      type="button"
      class="password-enter-btn"
      onclick="document.querySelector('#password-modal')?.showModal()"
    >
      Enter using password
    </button>
    <p class="admin-link">
      Are you the store owner?
      <a href="/admin">Log in here</a>
    </p>
  </div>
</footer>

<!-- PASSWORD MODAL (native dialog + fallback) -->

<dialog id="password-modal" class="password-dialog" aria-labelledby="password-modal-title">
  <div class="password-dialog__header">
      <button
        type="button"
        class="button-unstyled close-button password-modal__close"
        aria-label="Close"
      >
        <span class="svg-wrapper svg-wrapper--small" title="Close">
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M12 2L2 12"
              stroke="currentColor"
              stroke-width="var(--icon-stroke-width, 1.5)"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M12 12L2 2"
              stroke="currentColor"
              stroke-width="var(--icon-stroke-width, 1.5)"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </button>
  </div>
  <form method="post" action="/password" class="password-dialog__form">

    <div class="password-dialog__content">
      <h3 id="password-modal-title" class="password-dialog__title">Enter password</h3>

      <div class="password-dialog__input-group">
        <label for="password-field" class="visually-hidden">Password</label>
        <input
          id="password-field"
          name="password"
          type="password"
          class="field__input field__input--button-radius field__input--button-padding"
          placeholder="Password"
          required
          autocomplete="current-password"
        >

        <button type="submit" class="button password-dialog__submit-button">Submit</button>
      </div>

      <div class="password-dialog__actions">
        <button type="button" class="button button--secondary password-modal__cancel">Cancel</button>
      </div>
    </div>
  </form>
</dialog>

<style>
  /* === Fullscreen Password Overlay === */

  /* Backdrop behind the white layer */
  .password-dialog::backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }

  /* Hidden by default */
  .password-dialog {
    border: none;
    padding: 1rem;
    margin: 0;
    width: 100%;
    height: 100%;
    background: #ffffff;
    display: none; /* 🔒 Hidden until showModal() */
    justify-content: center;
    align-items: center;
    position: fixed;
    top: 0;
    Left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.25s ease;
    overflow: hidden;
  }

  /* When dialog is open, make it visible */
  .password-dialog[open] {
    display: block;
    opacity: 1;
    animation: fadeIn 0.25s ease;
  }

  /* Ensure no scrollbars appear behind the modal */
  html:has(.password-dialog[open]),
  body:has(.password-dialog[open]) {
    overflow: hidden !important;
  }

  /* Fix <dialog> default UA styling */
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }

  dialog {
    max-width: none;
    max-height: none;
    inset: 0;
  }

  .password-dialog__header {
    display: flex;
    justify-content: right;
    align-items: center;
  }

  /* Close Button */
  button.button-unstyled.close-button.password-modal__close {
    padding: 20px;
    border: none;
    background: none;
    cursor: pointer;
  }

  /* Centered form */
  .password-dialog__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 80vh;
    gap: 20px;
    padding: 0 20px;
  }

  /* Title */
  .password-dialog__title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111;
  }

  /* Input + submit group */
  .password-dialog__input-group {
    display: flex;
    width: 100%;
    max-width: 350px;
  }

  .password-dialog__input-group input {
    flex: 1;
    border: 1px solid #ddd;
    border-radius: 9999px 0 0 9999px;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    outline: none;
  }
  .password-dialog__input-group input:focus {
    border-color: #000;
  }

  .password-dialog__submit-button {
    border: none;
    border-radius: 0 9999px 9999px 0;
    background: #000;
    color: #fff;
    padding: 0.75rem 1.25rem;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .password-dialog__submit-button:hover {
    background: #333;
  }

  button.button.button--secondary.password-modal__cancel {
    padding: 10px 20px;
    border: none;
    background: none;
    cursor: pointer;
    text-decoration: underline;
    font-weight: 600;
    letter-spacing: 0.1rem;
  }

  /* Close button */
  .password-dialog__close {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: #000;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }
  .password-dialog__close:hover {
    opacity: 1;
  }

  /* Fade-in animation */
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Utility */
  .visually-hidden {
    position: absolute !important;
    left: -9999px !important;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  (function () {
    var btn = document.querySelector('.password-enter-btn');
    // ensure button exists
    if (!btn) return;

    var dialog = document.getElementById('password-modal');

    // If browser supports <dialog>
    if (dialog && typeof dialog.showModal === 'function') {
      // open
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        dialog.showModal();
        // focus the password input
        var pw = dialog.querySelector('#password-field');
        if (pw) pw.focus();
      });

      // close buttons
      dialog.querySelectorAll('.password-modal__close, .password-modal__cancel').forEach(function (el) {
        el.addEventListener('click', function () {
          dialog.close();
        });
      });

      // close on escape handled by dialog by default; close on backdrop click:
      dialog.addEventListener('click', function (evt) {
        // if click is directly on dialog (backdrop), close
        var rect = dialog.getBoundingClientRect();
        var clickedInDialog =
          evt.clientX >= rect.left &&
          evt.clientX <= rect.right &&
          evt.clientY >= rect.top &&
          evt.clientY <= rect.bottom;
        if (!clickedInDialog) dialog.close();
      });
    } else {
      // Fallback for old browsers: open a simple modal div or redirect
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        // fallback: navigate to the built-in /password page
        window.location.href = '/password';
      });
    }
  })();
</script>

<style>
  .password-page {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 81vh;
    text-align: center;
    padding: 40px 0px;
    position: relative;
    color: #111;
    background-color: #fff;
  }

  .password-bg-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }

  .password-container {
    display: grid;
    text-align: center;
    gap: 12px;
  }

  .password-logo img {
    max-width: 120px;
    margin: 0 auto 20px;
    display: block;
  }

  .password-heading {
    font-size: 36px;
    font-weight: 700;
    margin: 0 0 12px;
  }

  .password-subtext {
    color: #555;
    font-size: 16px;
    margin-bottom: 30px;
  }

  .password-form {
    display: flex;
    max-width: 600px;
    margin: 0 auto 40px;
    background: #fff;
    border-radius: 50px;
    overflow: visible;
    border: 1px solid e5e5e5;
    box-shadow: 0 2px 8px #00000014;
  }

  .password-input {
    flex: 1;
    padding: 16px 28px;
    border: none;
    font-size: 15px;
    border-radius: 50px 0 0 50px;
    outline: none;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .password-input:focus-visible {
    outline: 2px solid #000;
    z-index: 2;
  }

  .password-submit {
    background: #000;
    color: #fff;
    border: none;
    border-radius: 0 50px 50px 0;
    padding: 16px 28px;
    font-size: 15px;
    cursor: pointer;
    transition: background 0.3s;
  }

  .password-submit:hover {
    background: #333;
  }

  .password-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding-block: 1.5rem;
  }

  .powered-by {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0;
    line-height: 1.4;
  }

  .password-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .powered-by svg {
    width: auto;
    height: 1em;
    vertical-align: middle;
  }

  .password-enter-btn {
    background: none;
    color: #000;
    cursor: pointer;
    font-size: 0.95rem;
    text-decoration: underline;
    padding: 0;
    border: none;
  }

  .password-links a {
    color: #000;
    text-decoration: underline;
    font-size: 0.95rem;
  }

  @media (max-width: 749px) {
    .password-links {
      flex-direction: column;
      gap: 0.5rem;
    }

    .password-form {
      flex-direction: column;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      border-radius: 0px;
      box-shadow: none;
    }

    .password-input {
      flex: 1;
      min-width: 220px;
      padding: 16px 28px;
      border-radius: 25px;
      border: 1px solid #ddd;
      font-size: 15px;
    }

    .password-submit {
      background: #000;
      color: #fff;
      border: none;
      border-radius: 25px;
      padding: 16px 28px;
      font-size: 15px;
      cursor: pointer;
      transition: background 0.3s;
    }

    .password-submit:hover {
      background: #333;
    }
  }
</style>

{% schema %}
{
  "name": "Password Page",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "bg_video",
      "label": "Background video"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading text",
          "default": "Opening soon"
        }
      ]
    },
    {
      "type": "subtext",
      "name": "Subtext",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Subheading text",
          "default": "Sign up for our newsletter to be the first to know when we launch."
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter signup",
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Sign up"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Password Page",
      "blocks": [
        { "type": "logo" },
        { "type": "heading" }, 
        { "type": "subtext" }, 
        { "type": "newsletter" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["password"]
  }
}
{% endschema %}
