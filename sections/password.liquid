<main
  id="MainContent"
  class="password-page"
  role="main"
  style="
    {% if section.settings.background_type == 'image' and section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
    {% elsif section.settings.background_type == 'video' and section.settings.bg_video != blank %}
      position: relative;
      overflow: hidden;
    {% endif %}
  "
>
  {% if section.settings.background_type == 'video' and section.settings.bg_video != blank %}
    <video
      class="password-bg-video"
      autoplay
      muted
      loop
      playsinline
    >
      <source src="{{ section.settings.bg_video | asset_url }}" type="video/mp4">
    </video>
  {% endif %}

  <div class="password-container">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'logo' -%}
          <div class="password-logo">
            {% if settings.logo_image %}
              <img
                src="{{ settings.logo_image | image_url: width: 200 }}"
                alt="{{ shop.name }}"
                width="{{ settings.logo_image.width | default: 200 }}"
                height="{{ settings.logo_image.height | default: 80 }}"
                loading="lazy"
              >
            {% else %}
              <h2 class="shop-name">{{ shop.name }}</h2>
            {% endif %}
          </div>

        {%- when 'heading' -%}
          <h1 class="password-heading">
            {{ block.settings.heading | default: 'Opening soon' }}
          </h1>

        {%- when 'subtext' -%}
          <div class="password-subtext">
            <p>{{ block.settings.text | default: 'Sign up to get notified when we launch.' }}</p>
          </div>

        {%- when 'newsletter' -%}
          <div class="password-newsletter">
            {% form 'customer', id: 'ContactPassword', class: 'password-form' %}
              {% if form.posted_successfully? %}
                <p class="form-success">Thank you for signing up!</p>
              {% else %}
                <label for="EmailInput" class="visually-hidden">Email</label>
                <input
                  id="EmailInput"
                  type="email"
                  name="contact[email]"
                  placeholder="Email address"
                  class="password-input"
                  required
                >
                <button type="submit" class="password-submit">
                  {{ block.settings.button_label | default: 'Sign up' }}
                </button>
              {% endif %}
            {% endform %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</main>

