.7-4.6 4.7-7.8 0-1.3-.5-2.7-2-2.7-1.7 0-3.4 2-4 5.1zm12.2 4.2 3.4-17.7h5.1l-3.4 17.7zm6.5-19.6c-1.4 0-2.4-1.1-2.4-2.6 0-1.6 1.3-2.9 2.9-2.9 1.5 0 2.5 1.1 2.5 2.6 0 1.8-1.4 2.9-3 2.9m2.9 19.6 2.7-14h-2.3l.7-3.7h2.3l.1-.8c.4-2.1 1.2-4.2 2.9-5.6 1.3-1.1 3.1-1.6 4.9-1.6 1.2 0 2.1.2 2.7.4l-1 3.9c-.4-.1-.9-.3-1.6-.3-1.7 0-2.7 1.5-3 3.2l-.2.8h3.5l-.7 3.7h-3.5l-2.7 14zm18-17.7.8 7.9c.2 1.8.4 3.3.4 4.2h.1c.4-.9.8-2.3 1.5-4.2l3.1-7.9h5.2l-6.1 13.1c-2.2 4.5-4.3 7.7-6.6 9.9-1.8 1.7-3.9 2.5-4.9 2.7l-1.4-4.2c.8-.3 1.9-.7 2.8-1.4 1.2-.8 2.1-1.9 2.7-3 .1-.3.2-.5.1-1.9l-3-15.2z"></path>
      </svg>
    </a>
  </p>

  <div class="password-links">
    <button
      type="button"
      class="password-enter-btn"
      data-password-trigger
    >
      Enter using password
    </button>
    <p class="admin-link">
      Are you the store owner?
      <a href="/admin">Log in here</a>
    </p>
  </div>
</footer>

<dialog
  id="password-modal"
  class="password-dialog color-{{ section.settings.color_scheme }}"
  aria-labelledby="password-modal-title"
>
  <div class="password-dialog__header">
    <button type="button" class="password-dialog__close" data-password-close aria-label="Close">
      <span class="svg-wrapper svg-wrapper--small">
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M12 2L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M12 12L2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </button>
  </div>

  <form method="post" action="/password" class="password-dialog__form">
    <div class="password-dialog__content">
      <h3 id="password-modal-title" class="password-dialog__title">Enter password</h3>

      <div class="password-dialog__input-group">
        <label for="password-field" class="visually-hidden">Password</label>
        <input
          id="password-field"
          name="password"
          type="password"
          class="field__input password-dialog__input"
          placeholder="Password"
          required
          autocomplete="current-password"
        >
        <button type="submit" class="password-dialog__submit-button">Submit</button>
      </div>

      <div class="password-dialog__actions">
        <button type="button" class="password-dialog__cancel" data-password-close>Cancel</button>
      </div>
    </div>
  </form>
</dialog>

{% schema %}
{
  "name": "t:general.password",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "container_position",
      "label": "t:labels.container_position",
      "options": [
        {
          "label": "t:options.alignment.left",
          "value": "left"
        },
        {
          "label": "t:options.alignment.center",
          "value": "center"
        },
        {
          "label": "t:options.alignment.right",
          "value": "right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "label": "t:options.alignment.left",
          "value": "left"
        },
        {
          "label": "t:options.alignment.center",
          "value": "center"
        },
        {
          "label": "t:options.alignment.right",
          "value": "right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.container"
    },
    {
      "type": "checkbox",
      "id": "transparent_background",
      "label": "t:labels.background",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.background_type"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:labels.background_select",
      "options": [
        {
          "value": "image",
          "label": "t:labels.image"
        },
        {
          "value": "video",
          "label": "t:labels.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "t:labels.background_image",
      "info": "t:informative_content.video_frame",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "bg_video",
      "label": "t:labels.background_video",
      "visible_if": "{{ section.settings.background_type == 'video' }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:settings.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:content.section_settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
