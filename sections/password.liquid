{{ "password.css" | asset_url | stylesheet_tag }}

{% assign bg_type = section.settings.background_type %}

{% assign placeholder_image = 'lifestyle-1' %}

{% if section.settings.bg_image != blank %}
  
  {%- comment -%} Real user image {%- endcomment -%}
  {% assign bg_image_url = section.settings.bg_image | image_url: width: 2000 %}
  {% assign is_placeholder = false %}

{% else %}

  {%- comment -%} Use placeholder from assets folder {%- endcomment -%}
  {% assign bg_image_url = placeholder_image | placeholder_svg_tag: '2000x1500' %}
  {% assign is_placeholder = true %}

{% endif %}

<main
  id="MainContent"
  class="password-page full-width" style="--padding-top:{{section.settings.padding_top}}px; --padding-bottom:{{section.settings.padding_bottom}}px;">

    {% if bg_type == 'image' %}
      <div class="page-background">
        {% if is_placeholder %}
          {{ 'lifestyle-1' | placeholder_svg_tag: '2000x1500' }}
        {% else %}

          <img 
              src="{{ bg_image_url }}"
              alt="Page background"
              loading="lazy"
              width="2000"
              height="1500"
              srcset="
                  {{ section.settings.bg_image | image_url: width: 750 }} 750w,
                  {{ section.settings.bg_image | image_url: width: 1100 }} 1100w,
                  {{ section.settings.bg_image | image_url: width: 1500 }} 1500w,
                  {{ section.settings.bg_image | image_url: width: 2000 }} 2000w,
                  {{ section.settings.bg_image | image_url: width: 2500 }} 2500w
                "
              sizes="100vw"
          >
        {% endif %}

        <div class="bg-overlay" 
          style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; background: {{ section.settings.overlay_color | default: '#000000' }};">
        </div>

      </div>
    {% elsif bg_type == 'color' %}
      <div class="page-background bg-color" style="background-color: {{ section.settings.bg_color }};"></div>
    {% elsif bg_type == 'video' %}
      <div class="password-video-wrapper">

        {% assign video = section.settings.bg_video %}

        {% if video != blank %}
          <video class="password-bg-video" autoplay muted loop playsinline>
            {% if video.sources %}
              {% for source in video.sources %}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {% endfor %}
            {% else %}
              <source src="{{ video | file_url }}" type="video/mp4">
            {% endif %}
          </video>
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: '2000x1500' }}
        {% endif %}

        <div class="bg-overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; background: {{ section.settings.overlay_color | default: '#000000' }};"></div>

      </div> 
    {% endif %}


  <div class="password-container" 
    style="
      --container-align:{{ section.settings.alignment }};
      --gap-elements:{{ section.settings.gap }}px;
      --container-align-items:
        {% if section.settings.alignment == 'left' %}flex-start{% elsif section.settings.alignment == 'right' %}flex-end{% else %}center{% endif %};
      --newsletter-justify:
        {% if section.settings.alignment == 'left' %}flex-start{% elsif section.settings.alignment == 'right' %}flex-end{% else %}center{% endif %};
    "
  >

    {% for block in section.blocks %}
      {% case block.type %}

      {% when 'logo' %}
        <div class="password-logo">
          {% if settings.logo_image %}
            <img
                src="{{ settings.logo_image | image_url: width: 200 }}"
                alt="{{ shop.name }}"
                width="{{ settings.logo_image.width | default: 200 }}"
                height="{{ settings.logo_image.height | default: 80 }}"
                loading="lazy"
            >
          {% else %}
            <h1 class="shop-name">{{ shop.name }}</h1>
          {% endif %}
        </div>

      {% when 'heading' %}
        <div class="password-heading" style="padding-top:{{ block.settings.padding_top }}px; padding-bottom:{{ block.settings.padding_bottom }}px; padding-left:{{ block.settings.padding_left }}px; padding-right:{{ block.settings.padding_right }}px;">
          {{ block.settings.heading | default: 'Opening soon' }}
        </div>

      {% when 'subtext' %}
        <div class="password-subtext" style="padding-top:{{ block.settings.padding_top }}px; padding-bottom:{{ block.settings.padding_bottom }}px; padding-left:{{ block.settings.padding_left }}px; padding-right:{{ block.settings.padding_right }}px;">
          <p>{{ block.settings.sub_text | default: 'Sign up for our newsletter to be the first to know when we launch.' }}</p>
        </div>

      {% when 'newsletter' %}
        <div class="password-newsletter" style="--border-radius:{{block.settings.border_radius}}px;  --max-width:{{block.settings.signup_width}}px; padding-top:{{ block.settings.padding_top }}px; padding-bottom:{{ block.settings.padding_bottom }}px; padding-left:{{ block.settings.padding_left }}px; padding-right:{{ block.settings.padding_right }}px;">
          {% form 'customer', id: 'ContactPassword', class: 'password-form' %}
            {% if form.posted_successfully? %}
              <p class="form-success">Thank you for signing up!</p>
            {% else %}
              <label for="EmailInput" class="visually-hidden">Email</label>
              <input id="EmailInput" type="email" name="contact[email]"
                placeholder="Email address" class="password-input" required>
              <button type="submit" class="password-submit">
                {{ block.settings.button_label | default: 'Sign up' }}
              </button>
            {% endif %}
          {% endform %}
        </div>
      {% endcase %}
    {% endfor %}

  </div>
</main>

