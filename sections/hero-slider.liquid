<div
  class="hero-slider hero-slider--height-{{ section.settings.desktop_height }}  hero-slider--mobile-height-{{ section.settings.mobile_height }}"
  data-slider
  role="region"
  aria-roledescription="carousel"
  aria-label="Featured slides"
>
  <div class="slider__viewport">
    <div class="slider__track">
      {% for block in section.blocks %}
        <div
          class="slider__slide"
          role="group"
          aria-roledescription="slide"
          aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}"
          {{ block.shopify_attributes }}
        >
          <div class="slider__media">
            {% if block.settings.background_type == 'image' and block.settings.bg_image %}
              <picture>
                {% if block.settings.mobile_image %}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ block.settings.mobile_image | image_url: width: 400 }} 400w,
                      {{ block.settings.mobile_image | image_url: width: 600 }} 600w,
                      {{ block.settings.mobile_image | image_url: width: 800 }} 800w
                    "
                    sizes="100vw"
                  >
                {% endif %}

                {{
                  block.settings.bg_image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '400, 600, 800, 1200, 1600',
                    sizes: '100vw',
                    loading: 'lazy',
                    alt: block.settings.bg_image.alt
                }}
              </picture>
            {% endif %}
          </div>
          <h2>Slide {{ forloop.index }}</h2>
        </div>
      {% endfor %}
    </div>

    <div class="slider__pagination" data-slider-pagination>
      {% for block in section.blocks %}
        <button
          type="button"
          data-slider-dot="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {% endfor %}
    </div>
  </div>

  <button type="button" data-slider-previous>Previous</button>

  <button type="button" data-slider-next>Next</button>

  <div
    class="visually-hidden slider__announcement"
    data-slider-announcement
    aria-live="polite"
    aria-atomic="true"
  ></div>
</div>

{% stylesheet %}
  .hero-slider {
    width: 100%;
  }

  .hero-slider .slider__media {
    width: 100%;
    height: 560px;
    overflow: hidden;
  }

  .hero-slider--height-small .slider__media {
    height: 420px;
  }

  .hero-slider--height-medium .slider__media {
    height: 560px;
  }

  .hero-slider--height-large .slider__media {
    height: 700px;
  }

  @media screen and (max-width: 749px) {
    .hero-slider--mobile-height-small .slider__media {
      height: 320px;
    }

    .hero-slider--mobile-height-medium .slider__media {
      height: 420px;
    }

    .hero-slider--mobile-height-large .slider__media {
      height: 520px;
    }
  }

  .slider__viewport {
    overflow: hidden;
  }

  .slider__track {
    display: flex;
    transition: transform 400ms ease;
    touch-action: pan-y;
    user-select: none;
    cursor: grab;
  }

  .slider__track:active {
    cursor: grabbing;
  }

  .slider__slide {
    flex: 0 0 100%;
    min-width: 0;
  }

  .slider__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .slider__track {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  console.log('SLIDER JS LOADED');

  class Slider {
    constructor(element) {
      console.log('SLIDER CONSTRUCTOR', element);

      this.element = element;

      this.track = element.querySelector('.slider__track');
      this.slides = [...element.querySelectorAll('.slider__slide')];
      this.viewport = element.querySelector('.slider__viewport');

      this.previousButton = element.querySelector('[data-slider-previous]');
      this.nextButton = element.querySelector('[data-slider-next]');

      this.pagination = element.querySelector('[data-slider-pagination]');
      this.dots = element.querySelectorAll('[data-slider-dot]');

      this.announcement = element.querySelector('[data-slider-announcement]');

      this.currentIndex = 0;
      this.visualIndex = 1;

      this.isAnimating = false;
      this.isDragging = false;
      this.hasDragged = false;

      this.startX = 0;
      this.currentX = 0;

      this.isHorizontalDrag = null;

      this.autoplayTimer = null;

      this.autoplayPaused = {
        hover: false,
        focus: false,
        visibility: false,
        drag: false,
      };

      this.prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!this.track || !this.viewport || this.slides.length === 0) {
        return;
      }

      if (this.slides.length < 2) {
        this.goToVisualIndex(0, false);
        this.updatePagination();
        return;
      }

      this.createClones();

      this.setupNavigation();
      this.setupTransition();
      this.setupAutoplay();
      this.setupDrag();

      this.goToVisualIndex(this.visualIndex, false);

      this.updatePagination();
      this.updateSlideAccessibility();
      this.updateAutoplay();
    }

    /* ----------------------------------------
       TRANSITION
    ---------------------------------------- */

    setTransition(enabled) {
      this.track.style.transition = enabled ? '' : 'none';
    }

    goToVisualIndex(index, animate = true) {
      this.visualIndex = index;

      const offset = index * -100;

      const shouldAnimate = animate && !this.prefersReducedMotion;

      this.setTransition(shouldAnimate);

      this.track.style.transform = `translateX(${offset}%)`;

      if (!shouldAnimate) {
        this.track.offsetHeight;
        this.setTransition(true);
      }
    }

    /* ----------------------------------------
       NAVIGATION
    ---------------------------------------- */

    announceSlide() {
      if (!this.announcement) {
        return;
      }

      this.announcement.textContent = `Slide ${this.currentIndex + 1} of ${this.slides.length}`;
    }

    goToSlide(index, visualIndex = index + 1, announce = true) {
      if (this.isAnimating) {
        return;
      }

      if (index < 0 || index >= this.slides.length) {
        return;
      }

      this.currentIndex = index;
      this.visualIndex = visualIndex;

      this.isAnimating = true;

      this.setTransition(true);

      this.goToVisualIndex(this.visualIndex);

      this.updatePagination();

      this.updateSlideAccessibility();
      if (announce) {
        this.announceSlide();
      }
    }

    next(announce = true) {
      if (this.isAnimating) {
        return;
      }

      const nextIndex = (this.currentIndex + 1) % this.slides.length;

      const nextVisualIndex = this.visualIndex + 1;

      this.goToSlide(nextIndex, nextVisualIndex, announce);
    }

    previous(announce = true) {
      if (this.isAnimating) {
        return;
      }

      const previousIndex = (this.currentIndex - 1 + this.slides.length) % this.slides.length;

      const previousVisualIndex = this.visualIndex - 1;

      this.goToSlide(previousIndex, previousVisualIndex, announce);
    }

    /* ----------------------------------------
       NAVIGATION EVENTS
    ---------------------------------------- */

    setupNavigation() {
      this.previousButton?.addEventListener('click', () => {
        this.previous();
      });

      this.nextButton?.addEventListener('click', () => {
        this.next();
      });

      this.dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const index = Number(dot.dataset.sliderDot);

          if (index === this.currentIndex) {
            return;
          }

          this.goToSlide(index);
        });
      });
    }

    /* ----------------------------------------
       INFINITE LOOP
    ---------------------------------------- */

    createClones() {
      const firstSlide = this.slides[0];
      const lastSlide = this.slides[this.slides.length - 1];

      const firstClone = firstSlide.cloneNode(true);
      const lastClone = lastSlide.cloneNode(true);

      firstClone.dataset.clone = 'true';
      lastClone.dataset.clone = 'true';

      firstClone.setAttribute('aria-hidden', 'true');
      lastClone.setAttribute('aria-hidden', 'true');

      firstClone.inert = true;
      lastClone.inert = true;

      this.track.appendChild(firstClone);
      this.track.insertBefore(lastClone, this.track.firstChild);
    }

    setupTransition() {
      this.track.addEventListener('transitionend', (event) => {
        if (event.propertyName !== 'transform') {
          return;
        }

        this.handleTransitionEnd();

        this.isAnimating = false;
      });
    }

    handleTransitionEnd() {
      const lastCloneIndex = this.slides.length + 1;

      if (this.visualIndex === lastCloneIndex) {
        this.currentIndex = 0;

        this.goToVisualIndex(1, false);

        this.updatePagination();
        this.updateSlideAccessibility();

        return;
      }

      if (this.visualIndex === 0) {
        this.currentIndex = this.slides.length - 1;

        this.goToVisualIndex(this.slides.length, false);

        this.updatePagination();
        this.updateSlideAccessibility();
      }
    }

    /* ----------------------------------------
       PAGINATION
    ---------------------------------------- */

    updatePagination() {
      this.dots.forEach((dot, index) => {
        const isActive = index === this.currentIndex;

        dot.classList.toggle('is-active', isActive);

        if (isActive) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    }

    updateSlideAccessibility() {
      this.slides.forEach((slide, index) => {
        const isActive = index === this.currentIndex;

        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');

        slide.inert = !isActive;
      });
    }

    /* ----------------------------------------
       AUTOPLAY
    ---------------------------------------- */

    setupAutoplay() {
      this.element.addEventListener('mouseenter', () => {
        this.autoplayPaused.hover = true;
        this.updateAutoplay();
      });

      this.element.addEventListener('mouseleave', () => {
        this.autoplayPaused.hover = false;
        this.updateAutoplay();
      });

      this.element.addEventListener('focusin', () => {
        this.autoplayPaused.focus = true;
        this.updateAutoplay();
      });

      this.element.addEventListener('focusout', (event) => {
        if (!this.element.contains(event.relatedTarget)) {
          this.autoplayPaused.focus = false;
          this.updateAutoplay();
        }
      });

      document.addEventListener('visibilitychange', () => {
        this.autoplayPaused.visibility = document.hidden;

        this.updateAutoplay();
      });
    }

    updateAutoplay() {
      const shouldPause =
        this.autoplayPaused.hover ||
        this.autoplayPaused.focus ||
        this.autoplayPaused.visibility ||
        this.autoplayPaused.drag ||
        this.prefersReducedMotion;

      if (shouldPause) {
        this.stopAutoplay();
        return;
      }

      this.startAutoplay();
    }

    startAutoplay() {
      if (this.autoplayTimer) {
        return;
      }

      this.autoplayTimer = setInterval(() => {
        this.next(false);
      }, 5000);
    }

    stopAutoplay() {
      if (!this.autoplayTimer) {
        return;
      }

      clearInterval(this.autoplayTimer);

      this.autoplayTimer = null;
    }

    /* ----------------------------------------
       DRAG / SWIPE
    ---------------------------------------- */

    setupDrag() {
      this.track.addEventListener('pointerdown', (event) => {
        this.handlePointerDown(event);
      });

      this.track.addEventListener('pointermove', (event) => {
        this.handlePointerMove(event);
      });

      this.track.addEventListener('pointerup', (event) => {
        this.handlePointerUp(event);
      });

      this.track.addEventListener('pointercancel', (event) => {
        this.handlePointerCancel(event);
      });

      this.track.addEventListener(
        'click',
        (event) => {
          if (!this.hasDragged) {
            return;
          }

          event.preventDefault();
          event.stopPropagation();

          this.hasDragged = false;
        },
        true
      );
    }

    handlePointerDown(event) {
      if (this.isAnimating) {
        return;
      }

      this.isDragging = true;
      this.hasDragged = false;
      this.isHorizontalDrag = null;

      this.startX = event.clientX;
      this.currentX = event.clientX;

      this.startY = event.clientY;
      this.currentY = event.clientY;

      this.setTransition(false);

      this.autoplayPaused.drag = true;
      this.updateAutoplay();

      this.track.setPointerCapture(event.pointerId);
    }

    handlePointerMove(event) {
      if (!this.isDragging) {
        return;
      }

      this.currentX = event.clientX;
      this.currentY = event.clientY;

      const distanceX = this.currentX - this.startX;

      const distanceY = this.currentY - this.startY;

      if (this.isHorizontalDrag === null) {
        const movementThreshold = 8;

        if (Math.abs(distanceX) < movementThreshold && Math.abs(distanceY) < movementThreshold) {
          return;
        }

        this.isHorizontalDrag = Math.abs(distanceX) > Math.abs(distanceY);
      }

      if (!this.isHorizontalDrag) {
        return;
      }

      this.hasDragged = true;

      const viewportWidth = this.viewport.offsetWidth;

      if (viewportWidth === 0) {
        return;
      }

      const rawDragPercentage = (distanceX / viewportWidth) * 100;

      const maxDragPercentage = 100;

      const dragPercentage = Math.max(-maxDragPercentage, Math.min(rawDragPercentage, maxDragPercentage));

      const baseOffset = this.visualIndex * -100;

      const offset = baseOffset + dragPercentage;

      this.track.style.transform = `translateX(${offset}%)`;
    }

    handlePointerUp(event) {
      if (!this.isDragging) {
        return;
      }

      const distance = this.currentX - this.startX;

      const isHorizontal = this.isHorizontalDrag === true;

      const threshold = this.viewport.offsetWidth * 0.2;

      this.resetDrag();

      if (this.track.hasPointerCapture(event.pointerId)) {
        this.track.releasePointerCapture(event.pointerId);
      }

      this.autoplayPaused.drag = false;
      this.updateAutoplay();

      if (!isHorizontal) {
        this.snapToVisualIndex(this.visualIndex);

        return;
      }

      this.setTransition(true);

      if (Math.abs(distance) < threshold) {
        this.snapToVisualIndex(this.visualIndex);

        return;
      }

      if (distance < 0) {
        this.next();
        return;
      }

      this.previous();
    }

    handlePointerCancel(event) {
      if (!this.isDragging) {
        return;
      }

      this.resetDrag();

      if (this.track.hasPointerCapture(event.pointerId)) {
        this.track.releasePointerCapture(event.pointerId);
      }

      this.autoplayPaused.drag = false;
      this.updateAutoplay();

      this.snapToVisualIndex(this.visualIndex);
    }

    snapToVisualIndex(index) {
      this.setTransition(true);

      this.goToVisualIndex(index);
    }

    resetDrag() {
      this.isDragging = false;

      this.startX = 0;
      this.currentX = 0;

      this.startY = 0;
      this.currentY = 0;

      this.isHorizontalDrag = null;
    }
  }

  const sliderElements = document.querySelectorAll('[data-slider]');

  sliderElements.forEach((element) => {
    new Slider(element);
  });
{% endjavascript %}

{% schema %}
{
  "name": "Hero Slideshow",
  "tag": "section",
  "class": "hero-slider-section",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        {
          "type": "select",
          "id": "background_type",
          "label": "Background Type",
          "options": [
            {
              "label": "Image",
              "value": "image"
            },
            {
              "label": "Video",
              "value": "video"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "Background Image",
          "visible_if": "{{ block.settings.background_type == 'image' }}"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image",
          "info": "Optional. If empty, the desktop image will be used on mobile.",
          "visible_if": "{{ block.settings.background_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "bg_video",
          "label": "Background Video",
          "visible_if": "{{ block.settings.background_type == 'video' }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow",
      "category": "Banners"
    }
  ]
}
{% endschema %}
