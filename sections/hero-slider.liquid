<div
  class="hero-slider hero-slider--height-{{ section.settings.desktop_height }} hero-slider--mobile-height-{{ section.settings.mobile_height }}"
  data-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="slider__viewport">
    <div class="slider__track">
      {% for block in section.blocks %}
        <article
          class="slider__slide"
          data-slide-index="{{ forloop.index0 }}"
          role="group"
          aria-roledescription="slide"
          aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}"
          {{ block.shopify_attributes }}
        >
          <div class="slider__media">
            {% if block.settings.background_type == 'image' and block.settings.bg_image %}
              <picture>
                {% if block.settings.mobile_image %}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ block.settings.mobile_image | image_url: width: 400 }} 400w,
                      {{ block.settings.mobile_image | image_url: width: 600 }} 600w,
                      {{ block.settings.mobile_image | image_url: width: 800 }} 800w
                    "
                    sizes="100vw"
                  >
                {% endif %}

                {{
                  block.settings.bg_image
                  | image_url: width: 2000
                  | image_tag:
                    widths: '400, 600, 800, 1000, 1200, 1600, 2000',
                    sizes: '100vw',
                    loading: 'lazy',
                    alt: block.settings.bg_image.alt
                }}
              </picture>
            {% elsif block.settings.background_type == 'video' and block.settings.bg_video %}
              {{
                block.settings.bg_video
                | video_tag:
                  class: 'slider__video',
                  autoplay: false,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  preload: 'metadata'
              }}
            {% else %}
              <div class="slider__media-placeholder" aria-hidden="true"></div>
            {% endif %}
          </div>

          <div class="slider__content slider__content--{{ block.settings.content_position }}">
            {% if block.settings.eyebrow != blank %}
              <p class="slider__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="slider__heading">{{ block.settings.heading | escape }}</h2>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="slider__description">
                {{ block.settings.description }}
              </div>
            {% endif %}

            {% if block.settings.primary_button_label != blank or block.settings.secondary_button_label != blank %}
              <div class="slider__actions">
                {% if block.settings.primary_button_label != blank and block.settings.primary_button_link != blank %}
                  <a class="slider__button slider__button--primary" href="{{ block.settings.primary_button_link }}">
                    {{ block.settings.primary_button_label | escape }}
                  </a>
                {% endif %}

                {% if block.settings.secondary_button_label != blank and block.settings.secondary_button_link != blank %}
                  <a class="slider__button slider__button--secondary" href="{{ block.settings.secondary_button_link }}">
                    {{ block.settings.secondary_button_label | escape }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="slider__controls">
        <button
          class="slider__arrow slider__arrow--previous"
          type="button"
          data-slider-previous
          aria-label="Previous slide"
        >
          <span aria-hidden="true">‹</span>
        </button>

        <div class="slider__pagination" data-slider-pagination>
          {% for block in section.blocks %}
            <button
              class="slider__dot"
              type="button"
              data-slider-dot="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
            ></button>
          {% endfor %}
        </div>

        <button
          class="slider__arrow slider__arrow--next"
          type="button"
          data-slider-next
          aria-label="Next slide"
        >
          <span aria-hidden="true">›</span>
        </button>
      </div>
    {% endif %}
  </div>

  <div
    class="visually-hidden slider__announcement"
    data-slider-announcement
    aria-live="polite"
    aria-atomic="true"
  ></div>
</div>

{% stylesheet %}
  .hero-slider {
    --slider-transition: 500ms;
    --slider-content-width: 720px;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .slider__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .slider__track {
    display: flex;
    width: 100%;
    transform: translate3d(0, 0, 0);
    transition: transform var(--slider-transition) ease;
    touch-action: pan-y;
    user-select: none;
    will-change: transform;
  }

  .slider__slide {
    position: relative;
    flex: 0 0 100%;
    min-width: 0;
    overflow: hidden;
    isolation: isolate;
  }

  .slider__media {
    position: relative;
    width: 100%;
    height: 560px;
    overflow: hidden;
    background: #111;
  }

  .hero-slider--height-small .slider__media {
    height: 420px;
  }

  .hero-slider--height-medium .slider__media {
    height: 560px;
  }

  .hero-slider--height-large .slider__media {
    height: 700px;
  }

  .slider__media picture,
  .slider__media img,
  .slider__media video {
    display: block;
    width: 100%;
    height: 100%;
  }

  .slider__media img,
  .slider__media video {
    object-fit: cover;
    object-position: center;
  }

  .slider__media-placeholder {
    width: 100%;
    height: 100%;
    background: #f3f3f3;
  }

  .slider__content {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(var(--slider-content-width), calc(100% - 48px));
    margin-inline: auto;
    padding: 40px 24px;
    pointer-events: none;
  }

  .slider__content--top-left,
  .slider__content--center-left,
  .slider__content--bottom-left {
    margin-left: max(24px, calc((100% - var(--slider-content-width)) / 2));
    margin-right: auto;
    text-align: left;
    align-items: flex-start;
  }

  .slider__content--top-center,
  .slider__content--center,
  .slider__content--bottom-center {
    text-align: center;
    align-items: center;
  }

  .slider__content--top-right,
  .slider__content--center-right,
  .slider__content--bottom-right {
    margin-left: auto;
    margin-right: max(24px, calc((100% - var(--slider-content-width)) / 2));
    text-align: right;
    align-items: flex-end;
  }

  .slider__content--top-left,
  .slider__content--top-center,
  .slider__content--top-right {
    justify-content: flex-start;
    padding-top: 72px;
  }

  .slider__content--bottom-left,
  .slider__content--bottom-center,
  .slider__content--bottom-right {
    justify-content: flex-end;
    padding-bottom: 88px;
  }

  .slider__eyebrow,
  .slider__heading,
  .slider__description,
  .slider__actions {
    pointer-events: auto;
  }

  .slider__eyebrow {
    margin: 0 0 10px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .slider__heading {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2rem, 5vw, 4.5rem);
    line-height: 1.05;
  }

  .slider__description {
    max-width: 620px;
    margin-top: 18px;
    line-height: 1.6;
  }

  .slider__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 26px;
  }

  .slider__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 22px;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .slider__button--primary {
    background: #111;
    color: #fff;
  }

  .slider__button--secondary {
    background: transparent;
    color: inherit;
    border-color: currentColor;
  }

  .slider__controls {
    position: absolute;
    z-index: 5;
    right: 24px;
    bottom: 24px;
    left: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    pointer-events: none;
  }

  .slider__arrow,
  .slider__dot {
    pointer-events: auto;
    cursor: pointer;
  }

  .slider__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 45%);
    background: rgb(0 0 0 / 35%);
    color: #fff;
    font-size: 28px;
    line-height: 1;
    backdrop-filter: blur(8px);
  }

  .slider__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .slider__dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 55%);
  }

  .slider__dot.is-active {
    width: 28px;
    border-radius: 999px;
    background: #fff;
  }

  .slider__arrow:focus-visible,
  .slider__dot:focus-visible,
  .slider__button:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .hero-slider--mobile-height-small .slider__media {
      height: 320px;
    }

    .hero-slider--mobile-height-medium .slider__media {
      height: 420px;
    }

    .hero-slider--mobile-height-large .slider__media {
      height: 520px;
    }

    .slider__content {
      width: calc(100% - 32px);
      padding: 28px 16px 82px;
    }

    .slider__content--top-left,
    .slider__content--center-left,
    .slider__content--bottom-left {
      margin-inline: auto;
      text-align: left;
      align-items: flex-start;
    }

    .slider__content--top-right,
    .slider__content--center-right,
    .slider__content--bottom-right {
      margin-inline: auto;
      text-align: right;
      align-items: flex-end;
    }

    .slider__heading {
      font-size: clamp(1.8rem, 9vw, 3rem);
    }

    .slider__actions {
      gap: 10px;
    }

    .slider__button {
      min-height: 44px;
      padding-inline: 18px;
    }

    .slider__controls {
      right: 16px;
      bottom: 16px;
      left: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slider__track {
      transition: none;
    }
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    class HeroSlider {
      constructor(element) {
        this.element = element;
        this.track = element.querySelector('.slider__track');
        this.viewport = element.querySelector('.slider__viewport');
        this.slides = [...element.querySelectorAll('.slider__slide')];
        this.dots = [...element.querySelectorAll('[data-slider-dot]')];
        this.previousButton = element.querySelector('[data-slider-previous]');
        this.nextButton = element.querySelector('[data-slider-next]');
        this.announcement = element.querySelector('[data-slider-announcement]');

        this.currentIndex = 0;
        this.visualIndex = this.slides.length > 1 ? 1 : 0;
        this.isAnimating = false;
        this.isDragging = false;
        this.hasDragged = false;
        this.dragAxis = null;
        this.pointerId = null;
        this.startX = 0;
        this.currentX = 0;
        this.startY = 0;
        this.currentY = 0;

        this.autoplayTimer = null;
        this.autoplayEnabled = element.dataset.autoplay === 'true';
        this.autoplayDelay = Number(element.dataset.autoplayDelay) || 5000;

        this.pause = {
          hover: false,
          focus: false,
          visibility: document.hidden,
          drag: false
        };

        this.motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.prefersReducedMotion = this.motionQuery.matches;

        this.boundTransitionEnd = this.handleTransitionEnd.bind(this);
        this.boundVisibilityChange = this.handleVisibilityChange.bind(this);
        this.boundMotionChange = this.handleMotionChange.bind(this);
        this.boundResize = this.handleResize.bind(this);

        if (!this.track || !this.viewport || !this.slides.length) return;

        this.element.sliderInstance = this;

        if (this.slides.length > 1) {
          this.createClones();
          this.setupNavigation();
          this.setupKeyboard();
          this.setupTransition();
          this.setupDrag();
          this.setupAutoplay();
          this.setupVisibility();
          this.setupMotionPreference();
          this.setupResize();

          this.goToVisualIndex(1, false);
        } else {
          this.setupVisibility();
          this.setupMotionPreference();
          this.setupResize();
          this.goToVisualIndex(0, false);

          this.previousButton?.setAttribute('disabled', '');
          this.nextButton?.setAttribute('disabled', '');
        }

        this.updatePagination();
        this.updateAccessibility();
        this.updateVideos();
        this.updateAutoplay();
      }

      setTransition(enabled) {
        this.track.style.transition = enabled ? '' : 'none';
      }

      goToVisualIndex(index, animate = true) {
        this.visualIndex = index;

        const offset = index * -100;
        const shouldAnimate = animate && !this.prefersReducedMotion;

        this.setTransition(shouldAnimate);
        this.track.style.transform = `translate3d(${offset}%, 0, 0)`;

        if (!shouldAnimate) {
          void this.track.offsetWidth;
          this.setTransition(true);
        }
      }

      createClones() {
        const first = this.slides[0];
        const last = this.slides[this.slides.length - 1];

        const firstClone = first.cloneNode(true);
        const lastClone = last.cloneNode(true);

        [firstClone, lastClone].forEach((clone) => {
          clone.dataset.clone = 'true';
          clone.setAttribute('aria-hidden', 'true');
          clone.inert = true;

          clone.querySelectorAll('a, button, input, select, textarea, [tabindex]').forEach((control) => {
            control.setAttribute('tabindex', '-1');
          });
        });

        this.track.append(lastClone);
        this.track.insertBefore(firstClone, this.track.firstChild);
      }

      setupNavigation() {
        this.previousButton?.addEventListener('click', () => this.previous());
        this.nextButton?.addEventListener('click', () => this.next());

        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const index = Number(dot.dataset.sliderDot);
            if (!Number.isInteger(index) || index === this.currentIndex) return;
            this.goToSlide(index);
          });
        });
      }

      setupKeyboard() {
        this.element.addEventListener('keydown', (event) => {
          if (!this.element.contains(document.activeElement)) return;

          if (event.key === 'ArrowRight') {
            event.preventDefault();
            this.next();
          }

          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            this.previous();
          }
        });
      }

      setupTransition() {
        this.track.addEventListener('transitionend', this.boundTransitionEnd);
      }

      handleTransitionEnd(event) {
        if (event.target !== this.track || event.propertyName !== 'transform') return;

        if (this.visualIndex === this.slides.length + 1) {
          this.currentIndex = 0;
          this.goToVisualIndex(1, false);
        } else if (this.visualIndex === 0) {
          this.currentIndex = this.slides.length - 1;
          this.goToVisualIndex(this.slides.length, false);
        }

        this.isAnimating = false;
        this.updatePagination();
        this.updateAccessibility();
        this.updateVideos();
        this.updateAutoplay();
      }

      goToSlide(index, visualIndex = index + 1, announce = true) {
        if (this.slides.length < 2 || this.isAnimating) return;
        if (index < 0 || index >= this.slides.length) return;

        this.currentIndex = index;
        this.visualIndex = visualIndex;

        if (this.prefersReducedMotion) {
          this.goToVisualIndex(visualIndex, false);
          this.isAnimating = false;
        } else {
          this.isAnimating = true;
          this.goToVisualIndex(visualIndex, true);
        }

        this.updatePagination();
        this.updateAccessibility();
        this.updateVideos();

        if (announce) this.announceSlide();

        this.updateAutoplay();
      }

      next(announce = true) {
        if (this.isAnimating || this.slides.length < 2) return;

        const nextIndex = (this.currentIndex + 1) % this.slides.length;
        this.goToSlide(nextIndex, this.visualIndex + 1, announce);
      }

      previous(announce = true) {
        if (this.isAnimating || this.slides.length < 2) return;

        const previousIndex =
          (this.currentIndex - 1 + this.slides.length) % this.slides.length;

        this.goToSlide(previousIndex, this.visualIndex - 1, announce);
      }

      updatePagination() {
        this.dots.forEach((dot, index) => {
          const active = index === this.currentIndex;
          dot.classList.toggle('is-active', active);

          if (active) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      }

      updateAccessibility() {
        this.slides.forEach((slide, index) => {
          const active = index === this.currentIndex;

          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
          slide.inert = !active;
        });
      }

      announceSlide() {
        if (!this.announcement) return;
        this.announcement.textContent = `Slide ${this.currentIndex + 1} of ${this.slides.length}`;
      }

      updateVideos() {
        const allVideos = [...this.element.querySelectorAll('video')];

        allVideos.forEach((video) => {
          const slide = video.closest('.slider__slide');
          const active = slide && !slide.hasAttribute('data-clone') &&
            Number(slide.dataset.slideIndex) === this.currentIndex;

          if (active && !this.prefersReducedMotion) {
            const playPromise = video.play();
            if (playPromise?.catch) playPromise.catch(() => {});
          } else {
            video.pause();
            try {
              video.currentTime = 0;
            } catch (_) {}
          }
        });
      }

      setupAutoplay() {
        this.element.addEventListener('mouseenter', () => {
          this.pause.hover = true;
          this.updateAutoplay();
        });

        this.element.addEventListener('mouseleave', () => {
          this.pause.hover = false;
          this.updateAutoplay();
        });

        this.element.addEventListener('focusin', () => {
          this.pause.focus = true;
          this.updateAutoplay();
        });

        this.element.addEventListener('focusout', (event) => {
          if (!this.element.contains(event.relatedTarget)) {
            this.pause.focus = false;
            this.updateAutoplay();
          }
        });
      }

      updateAutoplay() {
        if (!this.autoplayEnabled || this.slides.length < 2) {
          this.stopAutoplay();
          return;
        }

        const shouldPause =
          this.pause.hover ||
          this.pause.focus ||
          this.pause.visibility ||
          this.pause.drag ||
          this.prefersReducedMotion ||
          this.isAnimating;

        if (shouldPause) {
          this.stopAutoplay();
          return;
        }

        this.startAutoplay();
      }

      startAutoplay() {
        if (this.autoplayTimer) return;

        this.autoplayTimer = window.setTimeout(() => {
          this.autoplayTimer = null;
          this.next(false);
          this.updateAutoplay();
        }, this.autoplayDelay);
      }

      stopAutoplay() {
        if (!this.autoplayTimer) return;
        window.clearTimeout(this.autoplayTimer);
        this.autoplayTimer = null;
      }

      setupVisibility() {
        document.addEventListener('visibilitychange', this.boundVisibilityChange);
      }

      handleVisibilityChange() {
        this.pause.visibility = document.hidden;
        this.updateAutoplay();
      }

      setupMotionPreference() {
        if (this.motionQuery.addEventListener) {
          this.motionQuery.addEventListener('change', this.boundMotionChange);
        } else {
          this.motionQuery.addListener(this.boundMotionChange);
        }
      }

      handleMotionChange(event) {
        this.prefersReducedMotion = event.matches;

        if (this.prefersReducedMotion) {
          this.isAnimating = false;
          this.goToVisualIndex(this.visualIndex, false);
          this.updateVideos();
        }

        this.updateAutoplay();
      }

      setupResize() {
        window.addEventListener('resize', this.boundResize, { passive: true });
      }

      handleResize() {
        if (this.isDragging) return;

        this.setTransition(false);
        this.track.style.transform = `translate3d(${this.visualIndex * -100}%, 0, 0)`;
        void this.track.offsetWidth;
        this.setTransition(true);
      }

      setupDrag() {
        this.track.addEventListener('pointerdown', (event) => {
          if (this.isAnimating || event.isPrimary === false) return;

          this.isDragging = true;
          this.hasDragged = false;
          this.dragAxis = null;
          this.pointerId = event.pointerId;

          this.startX = this.currentX = event.clientX;
          this.startY = this.currentY = event.clientY;

          this.setTransition(false);

          this.pause.drag = true;
          this.updateAutoplay();

          this.track.setPointerCapture(event.pointerId);
        });

        this.track.addEventListener('pointermove', (event) => {
          if (!this.isDragging || event.pointerId !== this.pointerId) return;

          this.currentX = event.clientX;
          this.currentY = event.clientY;

          const distanceX = this.currentX - this.startX;
          const distanceY = this.currentY - this.startY;

          if (this.dragAxis === null) {
            if (Math.max(Math.abs(distanceX), Math.abs(distanceY)) < 8) return;
            this.dragAxis = Math.abs(distanceX) > Math.abs(distanceY) ? 'x' : 'y';
          }

          if (this.dragAxis !== 'x') return;

          this.hasDragged = true;

          const width = this.viewport.offsetWidth;
          if (!width) return;

          const percentage = Math.max(
            -100,
            Math.min((distanceX / width) * 100, 100)
          );

          const offset = this.visualIndex * -100 + percentage;

          this.track.style.transform = `translate3d(${offset}%, 0, 0)`;
        });

        this.track.addEventListener('pointerup', (event) => this.finishDrag(event));
        this.track.addEventListener('pointercancel', (event) => this.cancelDrag(event));
        this.track.addEventListener('lostpointercapture', () => {
          if (this.isDragging) this.cancelDrag();
        });

        this.track.addEventListener(
          'click',
          (event) => {
            if (!this.hasDragged) return;

            event.preventDefault();
            event.stopPropagation();
            this.hasDragged = false;
          },
          true
        );
      }

      finishDrag(event) {
        if (!this.isDragging) return;

        const distance = this.currentX - this.startX;
        const horizontal = this.dragAxis === 'x';
        const threshold = this.viewport.offsetWidth * 0.2;

        this.releasePointer(event.pointerId);
        this.resetDrag();

        this.pause.drag = false;
        this.updateAutoplay();

        if (!horizontal || Math.abs(distance) < threshold) {
          this.snapBack();
          return;
        }

        if (distance < 0) this.next();
        else this.previous();
      }

      cancelDrag(event) {
        if (!this.isDragging) return;

        if (event?.pointerId != null) {
          this.releasePointer(event.pointerId);
        }

        this.resetDrag();
        this.pause.drag = false;
        this.updateAutoplay();
        this.snapBack();
      }

      snapBack() {
        this.isAnimating = false;
        this.goToVisualIndex(this.visualIndex, !this.prefersReducedMotion);
      }

      releasePointer(pointerId) {
        if (pointerId == null) return;

        if (this.track.hasPointerCapture(pointerId)) {
          this.track.releasePointerCapture(pointerId);
        }

        this.pointerId = null;
      }

      resetDrag() {
        this.isDragging = false;
        this.dragAxis = null;
        this.pointerId = null;
        this.startX = 0;
        this.currentX = 0;
        this.startY = 0;
        this.currentY = 0;
      }

      destroy() {
        this.stopAutoplay();

        document.removeEventListener('visibilitychange', this.boundVisibilityChange);
        window.removeEventListener('resize', this.boundResize);

        this.track?.removeEventListener('transitionend', this.boundTransitionEnd);

        if (this.motionQuery.removeEventListener) {
          this.motionQuery.removeEventListener('change', this.boundMotionChange);
        } else {
          this.motionQuery.removeListener(this.boundMotionChange);
        }

        this.element.sliderInstance = null;
      }
    }

    const initSliders = (container = document) => {
      container.querySelectorAll('[data-slider]').forEach((element) => {
        if (!element.sliderInstance) {
          new HeroSlider(element);
        }
      });
    };

    initSliders();

    document.addEventListener('shopify:section:load', (event) => {
      initSliders(event.target);
    });

    document.addEventListener('shopify:section:unload', (event) => {
      event.target.querySelectorAll('[data-slider]').forEach((element) => {
        element.sliderInstance?.destroy();
      });
    });
  })();
{% endjavascript %}

