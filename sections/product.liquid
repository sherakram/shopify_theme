{{ 'product.css' | asset_url | stylesheet_tag }}


<section id="product-section-{{ section.id }}" class="product-section
         product-section--media-{{ section.settings.media_position }}"
         style="--product-padding-top: {{ section.settings.padding_top }}px;
         --product-padding-bottom: {{ section.settings.padding_bottom }}px;
         --media-info-gap: {{ section.settings.media_info_gap }}px;">
  <div class="product-inner" role="region" aria-label="Product details">

    {%- comment -%} column layout: media + info {%- endcomment -%}
    <div class="product-columns">
      <div class="product-media-column">
        <!-- Swiper main -->
        <div class="product-swiper product-swiper-{{ section.id }}">
          <div class="swiper-wrapper">
            {% for media in product.media %}
              <div class="swiper-slide" data-media-id="{{ media.id }}">
                {% render 'product-media', media: media %}
              </div>
            {% endfor %}
          </div>

          <!-- zoom / nav -->
          <button type="button" class="product-zoom-btn" aria-label="Zoom image">
            <!-- inline magnifier SVG -->
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M21 21l-4.35-4.35" />
              <circle cx="11" cy="11" r="6" stroke="currentColor" stroke-width="2" fill="none"/>
            </svg>
          </button>

          <div class="swiper-button-prev" aria-hidden="true"></div>
          <div class="swiper-button-next" aria-hidden="true"></div>
        </div>

        {% if section.settings.show_thumbnails %}
          <div class="product-thumbs product-thumbs-{{ section.id }}">
            <div class="swiper-wrapper">
              {% for media in product.media %}
                <div class="swiper-slide" data-thumb-id="{{ media.id }}">
                  {{ media.preview_image | image_url: width: 200 | image_tag: alt: media.alt }}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>

      <div class="product-info-column">
        {% comment %} Render blocks chosen in customizer (merchant can reorder) {% endcomment %}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'title' %}
              <h1 class="product-title">{{ product.title }}</h1>

            {% when 'price' %}
              <div class="product-price" data-product-price>
                {% if product.compare_at_price_max > product.price %}
                  <span class="price--compare">{{ product.compare_at_price_max | money }}</span>
                {% endif %}
                <span class="price--current">{{ product.price | money }}</span>
              </div>

            {% when 'divider' %}
              <hr class="product-divider" />

            {% when 'variant_picker' %}
              <variant-picker
                    class="variant-picker spacing-style variant-picker--left"
                    style="--color-strikethrough-mix: #000; --padding-block-start: 0px;--padding-block-end: 0px;--padding-inline-start: 0px;--padding-inline-end: 0px;"
                    data-section-id="{{ section.id }}"
                    data-product-id="{{ product.id }}"
                    data-block-id="{{ section.id }}__variant_picker"
                    data-product-url="{{ product.url }}"
                    ref="mainVariantPicker"
                    data-template-product-match="true">

                    <form class="variant-picker__form">
                      {% for option in product.options_with_values %}
                        <div class="variant-option variant-option--dropdowns">
                          <label for="Option-{{ section.id }}-{{ forloop.index0 }}">
                            {{ option.name }}
                          </label>
                          <div class="variant-option__select-wrapper">
                            <select
                              id="Option-{{ section.id }}-{{ forloop.index0 }}"
                              name="options[{{ option.name }}]"
                              class="variant-option__select">
                              {% for value in option.values %}
                                <option
                                  value="{{ value | escape }}"
                                  {% if option.selected_value == value %}selected{% endif %}>
                                  {{ value }}
                                </option>
                              {% endfor %}
                            </select>
                            <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
                              <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"></path>
                            </svg>
                          </div>
                        </div>
                      {% endfor %}

                       <noscript>
                          <select name="id" class="variant-picker__noscript">
                            {% for variant in product.variants %}
                              <option value="{{ variant.id }}">
                                {{ variant.title }} — {{ variant.price | money }}
                              </option>
                            {% endfor %}
                          </select>
                        </noscript>
                      </form>      
              </variant-picker>

            {% when 'buy_buttons' %}
              <div class="product-buy">
                {% render 'buy-buttons', product: product, section_id: section.id %}
              </div>

            {% when 'product_description' %}
              <div class="product-description">
                <div class="product-desc-content" data-desc-content>
                  {{ product.description }}
                </div>
                <button class="product-desc-toggle" data-desc-toggle>Read more</button>
              </div>

            {% when 'recommended_products' %}
              <div class="product-recommendations">
                {% if recommendations.performed and recommendations.products_count > 0 %}
                  {% for rec in recommendations.products limit: section.settings.recommendation_count %}
                    <a href="{{ rec.url }}" class="recommendation">
                      {{ rec.featured_image | image_url: width: 300, height: 300, crop: 'center' | image_tag: class: 'rec-thumb' }}
                      <span>{{ rec.title }}</span>
                    </a>
                  {% endfor %}
                  {% else %}
                    <p class="muted">Recommendations load when the Product Recommendations API is used</p>
                {% endif %}
              </div>

            {% when 'product_inventory' %}
              <product-inventory class="product-inventory spacing-style" style="--padding-block-start: 0px; --padding-block-end: 0px; --padding-inline-start: 0px; --padding-inline-end: 0px;" data-product-id="{{ product.id }}">
                {% assign total_qty = 0 %}
                {% for variant in product.variants %}
                  {% if variant.inventory_management != nil %}
                    {% assign total_qty = total_qty | plus: variant.inventory_quantity %}
                  {% endif %}
                {% endfor %}

                {% if total_qty > 0 %}
                  <span class="product-inventory__status product-inventory__status--in-stock">
                    <span class="svg-wrapper product-inventory__icon product-inventory__icon-in_stock">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15" fill="none" width="15" height="15">
                        <circle cx="7.5" cy="7.5" r="7.5" fill="currentColor"></circle>
                        <circle cx="7.5" cy="7.5" r="5" fill="currentColor" stroke="#FFF"></circle>
                      </svg>
                    </span>
                    <span class="product-inventory__text" role="status" aria-label="Inventory status">
                      In stock: {{ total_qty }}
                    </span>
                  </span>
                {% else %}
                  <span class="product-inventory__status product-inventory__status--out-of-stock">
                    <span class="svg-wrapper product-inventory__icon product-inventory__icon-out_stock">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15" fill="none" width="15" height="15">
                        <circle cx="7.5" cy="7.5" r="7.5" fill="currentColor"></circle>
                        <path d="M4 4L11 11M11 4L4 11" stroke="#FFF" stroke-width="1.5"/>
                      </svg>
                    </span>
                    <span class="product-inventory__text" role="status" aria-label="Inventory status">
                      Out of stock
                    </span>
                  </span>
                {% endif %}
              </product-inventory>


            {% when 'payment_icons' %}
              <div class="payment-icons">
                {% if section.settings.payment_icons_image %}
                  {% for type in shop.enabled_payment_types %}
                    {{ type | payment_type_svg_tag }}
                  {% endfor %}
                {% elsif section.settings.custom_payment_icons != blank %}
                  {% assign icons = section.settings.custom_payment_icons | split: ',' %}
                  {% for icon in icons %}
                    {{ icon | strip | payment_type_svg_tag }}
                  {% endfor %}
                {% endif %}
              </div>

            {% when 'product_size' %}
              <div class="product-size">
                <button class="product-size-trigger" data-size-trigger>
                  {{ block.settings.size_label | default: 'Size guide' }}
                </button>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Size popup (Dawn-like modal) -->
  <div class="product-size-modal" id="product-size-modal-{{ section.id }}" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="product-size-modal__panel" role="document">
      <button class="product-size-modal__close" data-size-close aria-label="Close size guide">&times;</button>
      <div class="product-size-modal__content">
        {% if section.settings.size_popup_image != blank %}
          {{ section.settings.size_popup_image | image_url: width: 1200 | image_tag }}
        {% else %}
          <h2>Size guide</h2>
          <p>Add an image or content via the section settings.</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "t:general.product",
  "settings": [
      { "id": "media_position", "type": "select", "label": "Media position", "options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"},{"value":"top","label":"Top"}], "default":"left" },
      { "id": "media_info_gap", "type":"range", "label":"Media — Info gap (px)", "min":0, "max":80, "step":2, "default":28 },
      { "id": "padding_top", "type":"range", "label":"Top padding (px)", "min":0, "max":200, "step":4, "default":40 },
      { "id": "padding_bottom", "type":"range", "label":"Bottom padding (px)", "min":0, "max":200, "step":4, "default":40 },
      { "id":"show_thumbnails","type":"checkbox","label":"Show thumbnails","default":true },
      { "id":"payment_icons_image","type":"checkbox","label":"Show Payment icons", "default":false },
      { "type": "text","id": "custom_payment_icons","label": "Custom payment icons (comma separated)","default": "visa,master,american-express,paypal" },
      { "id":"size_popup_image","type":"image_picker","label":"Size popup image" },
      { "id":"recommendation_count","type":"number","label":"Recommendation count","default":4}
    ],
    "blocks": [
      { "type":"title","name":"Title","limit": 1 },
      { "type":"price","name":"Price","limit": 1 },
      { "type":"divider","name":"Divider" },
      { "type":"variant_picker","name":"Variant Picker","limit": 1 },
      { "type":"buy_buttons","name":"Buy Buttons","limit": 1 },
      { "type":"product_description","name":"Product Description","limit": 1 },
      { "type":"recommended_products","name":"Recommended products" },
      { "type":"product_inventory","name":"Product inventory","limit": 1 },
      { "type":"payment_icons","name":"Payment icons","limit": 1 },
      { "type":"product_size","name":"Product size","limit": 1,"settings":[ { "id":"size_label","type":"text","label":"Button label","default":"Size guide" } ] }
    ],
    "presets": [{ "name": "Product (Swiper)", "category": "Products" }],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}