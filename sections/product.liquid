{% comment %} <div class="product-container">
  <div class="product-grid">
    <div class="product-media">
      {% for media in product.media %}
        <div class="product-images">
          {% for image in product.images %}
            {% render 'image', class: 'product-image', image: image %}
          {% else %}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'product-image' }}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
    <div class="product-info"></div>
  </div>
</div> {% endcomment %}



{% comment %} <div class="product-info">
  <h1>{{ product.title }}</h1>
  <p>{{ product.price | money }}</p>
  <p>{{ product.description }}</p>
</div> {% endcomment %}

{% comment %} <div class="product-form">
  {% form 'product', product %}
    {% assign current_variant = product.selected_or_first_available_variant %}

    <select name="id">
      {% for variant in product.variants %}
        <option
          value="{{ variant.id }}"
          {% if variant == current_variant %}
            selected="selected"
          {% endif %}
        >
          {{ variant.title }} - {{ variant.price | money }}
        </option>
      {% endfor %}
    </select>

    <input type="text" name="quantity" min="1" value="1">

    <input type="submit" value="Add to cart">
    {{ form | payment_button }}
  {% endform %}
</div> {% endcomment %}

{%- comment -%}
  sections/product.liquid
  - Swiper gallery with zoom button & thumbnails
  - Customizer settings: media position, gap, paddings
  - Blocks for title, price, divider, variant picker, buy buttons, description,
    recommended products, inventory, payment icons, product size (opens pop-up)
{%- endcomment -%}

<section id="product-section-{{ section.id }}" class="product-section
  product-section--media-{{ section.settings.media_position }}"
  style="--product-padding-top: {{ section.settings.padding_top }}px;
         --product-padding-bottom: {{ section.settings.padding_bottom }}px;
         --media-info-gap: {{ section.settings.media_info_gap }}px;">
  <div class="product-inner" role="region" aria-label="Product details">

    {%- comment -%} column layout: media + info {%- endcomment -%}
    <div class="product-columns">
      <div class="product-media-column">
        <!-- Swiper main -->
        <div class="product-swiper product-swiper-{{ section.id }}">
          <div class="swiper-wrapper">
            {% for media in product.media %}
              <div class="swiper-slide" data-media-id="{{ media.id }}">
                {% render 'product-media', media: media %}
              </div>
            {% endfor %}
          </div>

          <!-- zoom / nav -->
          <button type="button" class="product-zoom-btn" aria-label="Zoom image">
            <!-- inline magnifier SVG -->
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M21 21l-4.35-4.35" />
              <circle cx="11" cy="11" r="6" stroke="currentColor" stroke-width="2" fill="none"/>
            </svg>
          </button>

          <div class="swiper-button-prev" aria-hidden="true"></div>
          <div class="swiper-button-next" aria-hidden="true"></div>
        </div>

        {% if section.settings.show_thumbnails %}
          <div class="product-thumbs product-thumbs-{{ section.id }}">
            <div class="swiper-wrapper">
              {% for media in product.media %}
                <div class="swiper-slide" data-thumb-id="{{ media.id }}">
                  {{ media.preview_image | image_url: width: 200 | image_tag: alt: media.alt }}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>

      <div class="product-info-column">
        {% comment %} Render blocks chosen in customizer (merchant can reorder) {% endcomment %}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'title' %}
              <h1 class="product-title">{{ product.title }}</h1>

            {% when 'price' %}
              <div class="product-price" data-product-price>
                {% if product.compare_at_price_max > product.price %}
                  <span class="price--compare">{{ product.compare_at_price_max | money }}</span>
                {% endif %}
                <span class="price--current">{{ product.price | money }}</span>
              </div>

            {% when 'divider' %}
              <hr class="product-divider" />

            {% when 'variant_picker' %}
              <div class="product-variants">
                <label for="product-select-{{ section.id }}" class="visually-hidden">Choose an option</label>
                <select id="product-select-{{ section.id }}" class="product-variant-select" aria-label="Variant">
                  {% for variant in product.variants %}
                    <option value="{{ variant.id }}" data-variant-title="{{ variant.title }}" {% if forloop.first %}selected{% endif %}>
                      {{ variant.title }} — {{ variant.price | money }}
                    </option>
                  {% endfor %}
                </select>
              </div>

            {% when 'buy_buttons' %}
              <div class="product-buy">
                {% render 'buy-buttons', product: product, section_id: section.id %}
              </div>

            {% when 'product_description' %}
              <div class="product-description">
                {{ product.description | truncatewords: 80 }}
                <button class="product-desc-toggle" data-desc-toggle>Read more</button>
              </div>

            {% when 'recommended_products' %}
              <div class="product-recommendations">
                {% if recommendations.performed? %}
                  {% for rec in recommendations.products limit: section.settings.recommendation_count %}
                    <a href="{{ rec.url }}" class="recommendation">
                      {{ rec | image_url: width: 300, height: 300, crop: 'center' | image_tag: class: 'rec-thumb' }}
                      <span>{{ rec.title }}</span>
                    </a>
                  {% endfor %}
                {% else %}
                  <p class="muted">Recommendations load when the Product Recommendations API is used</p>
                {% endif %}
              </div>

            {% when 'product_inventory' %}
              <div class="product-inventory" data-inventory>
                {% assign total_qty = 0 %}
                {% for variant in product.variants %}
                  {% if variant.inventory_management != nil %}
                    {% assign total_qty = total_qty | plus: variant.inventory_quantity %}
                  {% endif %}
                {% endfor %}
                <span>In stock: {{ total_qty }}</span>
              </div>

            {% when 'payment_icons' %}
              <div class="payment-icons">
                {% if section.settings.payment_icons_image != blank %}
                  {{ section.settings.payment_icons_image | image_url | image_tag }}
                {% else %}
                  <!-- Placeholder merchant can replace -->
                  <span>Payment icons here</span>
                {% endif %}
              </div>

            {% when 'product_size' %}
              <div class="product-size">
                <button class="product-size-trigger" data-size-trigger>
                  {{ block.settings.size_label | default: 'Size guide' }}
                </button>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Size popup (Dawn-like modal) -->
  <div class="product-size-modal" id="product-size-modal-{{ section.id }}" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="product-size-modal__panel" role="document">
      <button class="product-size-modal__close" data-size-close aria-label="Close size guide">&times;</button>
      <div class="product-size-modal__content">
        {% if section.settings.size_popup_image != blank %}
          {{ section.settings.size_popup_image | image_url: width: 1200 | image_tag }}
        {% else %}
          <h2>Size guide</h2>
          <p>Add an image or content via the section settings.</p>
        {% endif %}
      </div>
    </div>
  </div>


{% schema %}
{
  "name": "t:general.product",
  "settings": [
      { "id": "media_position", "type": "select", "label": "Media position", "options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"},{"value":"top","label":"Top"}], "default":"left" },
      { "id": "media_info_gap", "type":"range", "label":"Media — Info gap (px)", "min":0, "max":80, "step":2, "default":28 },
      { "id": "padding_top", "type":"range", "label":"Top padding (px)", "min":0, "max":200, "step":4, "default":40 },
      { "id": "padding_bottom", "type":"range", "label":"Bottom padding (px)", "min":0, "max":200, "step":4, "default":40 },
      { "id":"show_thumbnails","type":"checkbox","label":"Show thumbnails","default":true },
      { "id":"payment_icons_image","type":"image_picker","label":"Payment icons image" },
      { "id":"size_popup_image","type":"image_picker","label":"Size popup image" },
      { "id":"recommendation_count","type":"number","label":"Recommendation count","default":4}
    ],
    "blocks": [
      { "type":"title","name":"Title" },
      { "type":"price","name":"Price" },
      { "type":"divider","name":"Divider" },
      { "type":"variant_picker","name":"Variant Picker" },
      { "type":"buy_buttons","name":"Buy Buttons" },
      { "type":"product_description","name":"Product Description" },
      { "type":"recommended_products","name":"Recommended products" },
      { "type":"product_inventory","name":"Product inventory" },
      { "type":"payment_icons","name":"Payment icons" },
      { "type":"product_size","name":"Product size","settings":[ { "id":"size_label","type":"text","label":"Button label","default":"Size guide" } ] }
    ],
    "presets": [{ "name": "Product (Swiper)", "category": "Products" }],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}


<style>
    /* --- minimal styles for demo (move to assets/product.css in production) --- */
    .product-section{padding-top:var(--product-padding-top);padding-bottom:var(--product-padding-bottom)}
    .product-columns{display:flex;gap:var(--media-info-gap);align-items:flex-start}
    .product-section--media-top .product-columns{flex-direction:column}
    .product-media-column{flex:1;min-width:320px}
    .product-info-column{flex:1;min-width:280px}
    .product-swiper{position:relative}
    .product-swiper .swiper-slide{display:flex;align-items:center;justify-content:center}
    .product-zoom-btn{position:absolute;top:12px;right:12px;z-index:20;background:#fff;border:1px solid #eee;padding:8px;border-radius:6px}
    .product-size-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);align-items:center;justify-content:center;padding:20px;z-index:9999}
    .product-size-modal[aria-hidden="false"]{display:flex}
    .product-size-modal__panel{background:#fff;padding:20px;border-radius:8px;max-width:900px;width:100%;max-height:90vh;overflow:auto}
    .visually-hidden{position:absolute !important;left:-9999px !important}
  </style>

</section>