{{ 'section-product.css' | asset_url | stylesheet_tag }}
{{ 'product-media.css' | asset_url | stylesheet_tag }}
{{ 'product-thumbnails.css' | asset_url | stylesheet_tag }}
{{ 'product-info.css' | asset_url | stylesheet_tag }}
{{ 'product-modals.css' | asset_url | stylesheet_tag }}
{{ 'accordion-default.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.product_color
  assign object_fit   = section.settings.gallery_media_object_fit | default: 'cover'
  assign auto_height  = section.settings.enable_slider_auto_height
  assign aspect_ratio = section.settings.gallery_aspect_ratio | default: 'auto'

  if aspect_ratio == 'square'
    assign ar_value = '1 / 1'
  elsif aspect_ratio == 'portrait'
    assign ar_value = '2 / 3'
  elsif aspect_ratio == 'landscape'
    assign ar_value = '16 / 9'
  else
    assign ar_value = 'auto'
  endif
-%}

{% style %}
  #product-section-{{ section.id }} {
    --product-padding-top: {{ section.settings.padding_top }}px;
    --product-padding-bottom: {{ section.settings.padding_bottom }}px;
    --media-info-gap: {{ section.settings.media_info_gap }}px;
    --gallery-object-fit: {{ object_fit }};
    --gallery-aspect-ratio: {{ ar_value }};
    {% if aspect_ratio == 'fit' %}--gallery-fit-viewport: 1;{% endif %}
  }

  #product-section-{{ section.id }} .product-info-column {
    --spacing-between-info-blocks: {{ section.settings.product_info_blocks_space }}rem;
  }

{% endstyle %}

<div
  id="product-section-{{ section.id }}" class="product-section color-{{ scheme }} product-section--media-{{ section.settings.media_position }}
    product-section--{{ section.settings.product_media_width }}"
  >
  <div class="product-inner page-width" role="region" aria-label="{{product.title}} details">
    
    <div class="product-columns">
      <div
        class="product-media {% if section.settings.enable_sticky_content %}product-media--sticky{% endif %}"
        data-desktop-layout="{{ section.settings.media_desktop_layout }}"
        data-mobile-layout="{{ section.settings.media_mobile_layout }}"
        data-auto-height="{{ auto_height }}"
        data-gallery-ratio="{{ aspect_ratio }}"
      >
        {%- liquid
          assign desktop_layout = section.settings.media_desktop_layout
          assign mobile_layout = section.settings.media_mobile_layout

          # Desktop Patterns mapping
          if desktop_layout == 'slideshow'
            assign d_class = 'product__media-layout--full'
          elsif desktop_layout == 'carousel'
            assign d_class = 'product__media-layout--partial'
          else
            assign d_class = 'product__media-layout--grid'
          endif

          # Mobile Patterns mapping
          if mobile_layout == 'slideshow'
            assign m_class = 'product__media-layout--full--sm'
          else
            assign m_class = 'product__media-layout--partial--sm'
          endif
        -%}

        <!-- DESKTOP Gallery -->
        <div class="media-desktop small-hide" data-layout-desktop="{{ d_class }}">
          {% if desktop_layout == 'grid' %}
            {% render 'product-media-grid', product: product %}
          {% else %}
            {% render 'product-media-slideshow', product: product, layout_type: desktop_layout %}
          {% endif %}
        </div>

        <!-- MOBILE Gallery -->
        <div class="media-mobile large-up-hide" data-layout-mobile="{{ m_class }}">
          {% render 'product-media-slideshow', product: product, layout_type: mobile_layout %}
        </div>
      </div>

      <div class="product-info-column">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when '@app' %}
              {% render block %}

            {% when 'title' %}
              <h1 class="product-title">{{ product.title }}</h1>

            {% when 'price' %}
              <div class="product-price" data-product-price>
                {% if product.compare_at_price_max > product.price %}
                  <span class="price--compare">{{ product.compare_at_price_max | money }}</span>
                {% endif %}
                <span class="price--current">{{ product.price | money }}</span>
              </div>

            {% when 'divider' %}
              <hr class="product-divider" role="separator" aria-orientation="horizontal">

            {% when 'variant_picker' %}
              {% render 'variant-picker',
                 product: product,
                 section: section,
                 block: block 
              %}

            {% when 'buy_buttons' %}
              <div class="product-buy">
                {% render 'buy-buttons', product: product, section_id: section.id, block: block %}
              </div>

            {% when 'product_description' %}
              <div class="product-description">
                <div class="product-desc-content" id="product-desc-content-{{ section.id }}" data-desc-content>
                  {{ product.description }}
                </div>
                <button
                  class="product-desc-toggle"
                  aria-expanded="false"
                  aria-controls="product-desc-content-{{ section.id }}"
                  data-desc-toggle
                >
                  Read more
                </button>
              </div>

            {% when 'sku' %}
              <div class="product__sku" id="Sku-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                {% if block.settings.show_label %}
                  <span class="product__sku-label">{{ block.settings.label_text }}</span>
                {% endif %}
                <span class="product__sku-value">
                  {{ product.selected_or_first_available_variant.sku }}
                </span>
              </div>

            {% when 'custom_liquid' %}
              <div class="product__custom-liquid" {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
              </div>

            {% when 'countdown_urgency' %}
              <div
                 class="countdown-urgency"
                 data-end-date="{{ block.settings.end_date }}"
                 data-auto-restart="{{ block.settings.auto_restart }}"
                 data-restart-hours="{{ block.settings.restart_hours }}"
                 data-hide-expired="{{ block.settings.hide_expired }}"
                 style="
                   background-color: {{ block.settings.bg_color }};
                   color: {{ block.settings.text_color }};
                   --flip-color: {{ block.settings.flip_color }};
                   border-radius: {{ block.settings.border_radius }}px;
                  "
                >
                {% if block.settings.heading_text != blank %}
                  <h3 class="countdown-heading">{{ block.settings.heading_text }}</h3>
                {% endif %}

                {% if block.settings.subheading_text != blank %}
                  <p class="countdown-subheading">{{ block.settings.subheading_text }}</p>
                {% endif %}

                <div class="countdown-timer" aria-live="polite">
                  {% assign units = 'days,hours,minutes,seconds' | split: ',' %}
                  {% for unit in units %}
                    <div class="countdown-unit" style="--unit-color:{{ block.settings.unit_color }};">
                      <span class="countdown-value {{ unit }}">00</span>
                      <span class="countdown-label">{{ unit }}</span>
                    </div>
                    {% unless forloop.last %}
                      <div class="countdown-separator" style="--unit-color:{{ block.settings.unit_color }};">:</div>
                    {% endunless %}
                  {% endfor %}
                </div>
              </div>

            {% when 'product_inventory' %}
              <div class="product-inventory spacing-style">
                {% assign total_qty = 0 %}
                {% for variant in product.variants %}
                  {% if variant.inventory_management %}
                    {% assign total_qty = total_qty | plus: variant.inventory_quantity %}
                  {% endif %}
                {% endfor %}

                {% assign low_threshold = block.settings.low_inventory_threshold | default: 10 %}
                {% assign max_value = block.settings.progress_bar_max_value | default: 50 %}
                {% assign show_bar = block.settings.show_progress_bar %}
                {% assign show_qty = block.settings.show_quantity %}

                {% if total_qty > 0 %}
                  <div class="inventory-status">
                    <span class="inventory-dot {% if show_bar %}hide-dot{% endif %}"></span>
                    <span class="inventory-text">
                      {% if show_qty %}
                        In stock: {{ total_qty }}
                      {% else %}
                        In stock
                      {% endif %}
                    </span>
                  </div>

                  {% if show_bar %}
                    {% assign progress_width = total_qty | times: 100 | divided_by: max_value %}
                    {% if progress_width > 100 %}
                      {% assign progress_width = 100 %}
                    {% endif %}
                    <div class="inventory-progress-wrapper">
                      <div
                        class="inventory-progress-bar {% if total_qty <= low_threshold %}low-stock{% endif %}"
                        style="width: {{ progress_width }}%;"
                        role="progressbar"
                        aria-valuemin="0"
                        aria-valuemax="{{ max_value }}"
                        aria-valuenow="{{ total_qty }}"
                      ></div>
                    </div>
                  {% endif %}
                {% else %}
                  <div class="inventory-status out-of-stock">
                    <span class="inventory-dot out"></span>
                    <span class="inventory-text">Out of stock</span>
                  </div>
                {% endif %}
              </div>

            {% when 'payment_icons' %}
              <div class="payment-icons">
                {% if block.settings.payment_icons_image %}
                  {% for type in shop.enabled_payment_types %}
                    {{ type | payment_type_svg_tag }}
                  {% endfor %}
                {% elsif block.settings.custom_payment_icons != blank %}
                  {% assign icons = block.settings.custom_payment_icons | split: ',' %}
                  {% for icon in icons %}
                    {{ icon | strip | payment_type_svg_tag }}
                  {% endfor %}
                {% endif %}
              </div>

            {% when 'product_size' %}
              <div class="product-size">
                <button
                  class="product-size-trigger"
                  data-size-trigger
                  aria-expanded="false"
                  aria-controls="product-size-modal-{{ section.id }}"
                >
                  {{ block.settings.size_label | default: 'Size guide' }}
                </button>

                <div
                  class="product-size-modal"
                  id="product-size-modal-{{ section.id }}"
                  role="dialog"
                  aria-modal="true"
                  aria-hidden="true"
                >
                  <div class="product-size-modal__panel" role="document">
                    <button class="product-size-modal__close" data-size-close aria-label="Close size guide">
                      &times;
                    </button>
                    <div class="product-size-modal__content">
                      {% if block.settings.size_popup_image %}
                        <img
                          src="{{ block.settings.size_popup_image | image_url: width: 1200 }}"
                          alt="Size guide"
                          class="size-guide-img"
                          loading="lazy"
                          width="auto"
                          height="auto"
                        >
                      {% else %}
                        <h2>Size guide</h2>
                        <p>Add an image or content via the section settings.</p>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>

            {%- when 'accordion' -%}
              <div itemprop="mainEntity" itemscope itemtype="https://schema.org/Question">
                <meta itemprop="name" content="{{ block.settings.title | escape }}">
                <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
                  <meta itemprop="text" content="{{ block.settings.content | strip_html | escape }}">
                </div>

                {% render 'accordion-default',
                  title: block.settings.title,
                  content: block.settings.content,
                  block: block,
                  section: section,
                  open: block.settings.open_by_default
                %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% if section.settings.show_zoom_button %}
  <!-- Zoom Lightbox -->
  <div class="product-zoom-overlay" id="product-zoom-overlay" role="dialog" aria-modal="true" aria-label="Media lightbox">
    <button class="product-zoom-overlay__close" id="product-zoom-close" aria-label="Close">&times;</button>
    <button class="product-zoom-overlay__prev" id="product-zoom-prev" aria-label="Previous">&#8249;</button>
    <div class="product-zoom-media" id="product-zoom-media"></div>
    <button class="product-zoom-overlay__next" id="product-zoom-next" aria-label="Next">&#8250;</button>
  </div>
{% endif %}

<script src="{{ 'variant-picker.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'countdown-timer.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'accordion-default.js' | asset_url }}" defer></script>

{% if product %}
  <script type="application/ld+json">
    {
        "@context": "https://schema.org/",
        "@type": "Product",
        "@id": "{{ shop.url }}{{ product.url }}#product",
        "name": {{ product.title | json }},
        "description": {{ product.description | strip_html | json }},
        "url": "{{ shop.url }}{{ product.url }}",
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        },
        "image": [
            {% for image in product.images %}
              "{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
        ],
        "offers": [
          {% for variant in product.variants %}
          {
          "@type": "Offer",
          "@id": "{{ shop.url }}{{ product.url }}?variant={{ variant.id }}#offer",
          "url": "{{ shop.url }}{{ product.url }}?variant={{ variant.id }}",
          "priceCurrency": "{{ shop.currency }}",
          "price": "{{ variant.price | divided_by: 100.0 }}",
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition",
          "sku": {{ variant.sku | json }}
          }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      {% if product.metafields.reviews.rating.value %}
        ,
          "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ product.metafields.reviews.rating.value }}",
          "reviewCount": "{{ product.metafields.reviews.rating_count }}"
        }
      {% endif %}
    }
  </script>
{% endif %}

<script type="application/ld+json">
  {
   "@context": "https://schema.org",
   "@type": "BreadcrumbList",
   "itemListElement": [
      {
       "@type": "ListItem",
       "position": 1,
       "name": "Home",
       "item": "{{ shop.url }}"
      }
      {% if collection %}
     ,{
       "@type": "ListItem",
       "position": 2,
       "name": {{ collection.title | json }},
       "item": "{{ shop.url }}{{ collection.url }}"
      }
     ,{
       "@type": "ListItem",
       "position": 3,
       "name": {{ product.title | json }},
       "item": "{{ shop.url }}{{ product.url }}"
      }
      {% else %}
     ,{
       "@type": "ListItem",
       "position": 2,
       "name": {{ product.title | json }},
       "item": "{{ shop.url }}{{ product.url }}"
      }
      {% endif %}
    ]
  }
</script>

{% schema %}
{
  "name": "t:general.product",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:general.media_settings"
    },
    {
      "type": "select",
      "id": "media_desktop_layout",
      "label": "t:general.media_desktop_layout",
      "options": [
        {
          "label": "t:general.media_grid",
          "value": "grid"
        },
        {
          "label": "t:general.media_slideshow",
          "value": "slideshow"
        },
        {
          "label": "t:general.media_carousel",
          "value": "carousel"
        }
      ],
      "default": "slideshow"
    },
    {
      "type": "select",
      "id": "media_mobile_layout",
      "label": "t:general.media_mobile_layout",
      "options": [
        {
          "label": "t:general.media_slideshow",
          "value": "slideshow"
        },
        {
          "label": "t:general.media_carousel",
          "value": "carousel"
        }
      ],
      "default": "slideshow"
    },
    {
      "type": "select",
      "id": "gallery_aspect_ratio",
      "label": "Gallery aspect ratio",
      "info": "Fit viewport works only with desktop slideshow and carousel layouts.",
      "options": [
        { "value": "auto",      "label": "Auto" },
        { "value": "square",    "label": "Square (1:1)" },
        { "value": "portrait",  "label": "Portrait (2:3)" },
        { "value": "landscape", "label": "Landscape (16:9)" },
        { "value": "fit",       "label": "Fit viewport" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "gallery_media_object_fit",
      "label": "Gallery media object fit",
      "info": "This is not effective with auto aspect ratio.",
      "options": [
        { "value": "cover",   "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "enable_slider_auto_height",
      "label": "Enable slider auto height",
      "info": "Do not enable unless product medias have different ratios — it will overwrite your aspect ratio setting.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_zoom_button",
      "label": "t:labels.zoom_behavior",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.thumbnails_settings"
    },
    {
      "id": "show_thumbnails",
      "type": "checkbox",
      "label": "t:labels.Show_thumbnails",
      "default": true,
      "info": "t:informative_content.info_about_thumbs"
    },
    {
      "type": "select",
      "id": "thumb_position",
      "label": "t:labels.thumbnail_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        },
        {
          "value": "bottom",
          "label": "t:options.alignment.bottom"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_content",
      "label": "Enable sticky content on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sticky_cart",
      "label": "Enable sticky add to cart bar",
      "default": true,
      "info": "Shows a sticky bar with an add to cart button when the main buy button scrolls out of view."
    },
    {
      "id": "media_position",
      "type": "select",
      "label": "t:general.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "left"
    },
    {
      "id": "media_info_gap",
      "type": "range",
      "label": "t:general.gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 30
    },
    {
      "id": "product_info_blocks_space",
      "type": "range",
      "label": "t:general.space",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "rem",
      "default": 1
    },
    {
      "type": "select",
      "id": "product_media_width",
      "label": "t:general.product_media_width",
      "options": [
        {
          "value": "small-media",
          "label": "Small"
        },
        {
          "value": "equal",
          "label": "Medium"
        },
        {
          "value": "large-media",
          "label": "Large"
        }
      ],
      "default": "equal"
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "color_scheme",
      "id": "product_color",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "id": "padding_top",
      "type": "range",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "id": "padding_bottom",
      "type": "range",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "divider",
      "name": "Divider"
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "label": "Style",
          "id": "style",
          "default": "dropdown",
          "options": [
            {
              "value": "dropdown",
              "label": "Dropdown"
            },
            {
              "value": "pills",
              "label": "Pills"
            }
          ]
        },
        {
          "type": "select",
          "id": "swatch",
          "label": "Swatch",
          "default": "none",
          "options": [
            {
              "value": "circle",
              "label": "Circle"
            },
            {
              "value": "square",
              "label": "Square"
            },
            {
              "value": "none",
              "label": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "qty_cart_layout",
          "label": "Quantity and buttons layout",
          "default": "inline",
          "options": [
            {
              "value": "inline",
              "label": "Inline"
            },
            {
              "value": "stacked",
              "label": "Stacked"
            }
          ]
        }
      ]
    },
    {
      "type": "product_description",
      "name": "Product Description",
      "limit": 1
    },
    {
      "type": "sku",
      "name": "SKU",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_label",
          "label": "Show label",
          "default": true
        },
        {
          "type": "text",
          "id": "label_text",
          "label": "Label text",
          "default": "SKU:"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid",
          "info": "Add Liquid code to create advanced customizations."
        }
      ]
    },
    {
      "type": "countdown_urgency",
      "name": "CountDown Timer",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading_text",
          "label": "Heading",
          "default": "Hurry up!"
        },
        {
          "type": "text",
          "id": "subheading_text",
          "label": "Subheading",
          "default": "Sale ends in:"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "unit_color",
          "label": "Timer color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "flip_color",
          "label": "Flip animation color",
          "default": "#ffcc00"
        },
        {
          "type": "text",
          "id": "end_date",
          "label": "End date/time (YYYY-MM-DD HH:MM)",
          "default": "2025-12-31 23:59"
        },
        {
          "type": "range",
          "id": "border_radius",
          "label": "Border radius (px)",
          "min": 0,
          "max": 30,
          "step": 2,
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "auto_restart",
          "label": "Auto-restart timer (evergreen mode)",
          "default": true
        },
        {
          "type": "range",
          "id": "restart_hours",
          "label": "Restart after (hours)",
          "min": 0,
          "max": 168,
          "step": 2,
          "default": 24
        },
        {
          "type": "checkbox",
          "id": "hide_expired",
          "label": "Hide when expired",
          "default": false
        }
      ]
    },
    {
      "type": "product_inventory",
