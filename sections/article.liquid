{{ 'article.css' | asset_url | stylesheet_tag }}

{% liquid
  assign has_image_block = false
  for block in section.blocks
    if block.type == 'featured_image'
      assign has_image_block = true
    endif
  endfor

  assign overlay_mode = false
  if section.settings.header_layout == 'overlay' and has_image_block and article.image
    assign overlay_mode = true
  endif
%}

{% style %}
  #post-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div class="color-{{ section.settings.color_scheme }}">
  <div class="main-article" id="post-{{ section.id }}">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'featured_image' %}
          <div class="article-image-wrapper aspect-{{ block.settings.aspect_ratio }}{% if overlay_mode %} is-overlay{% endif %}">
            {% if article.image %}
              {{
                article.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '375, 550, 750, 1100, 1500, 1600',
                  sizes: '100vw',
                  alt: article.image.alt
                | default: article.title, class: 'article-image'
              }}
            {% else %}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'article-image placeholder' }}
            {% endif %}
          </div>

        {% when 'title' %}
          <header class="article-head page-width--narrow title-align-{{ block.settings.title_align }}{% if overlay_mode %} is-overlay{% endif %}">
            {% if block.settings.show_tags and article.tags.size > 0 %}
              <div class="article-tags">
                {% for tag in article.tags limit: 5 %}
                  <span class="article-tag">{{ tag }}</span>
                {% endfor %}
              </div>
            {% endif %}

            <h1 class="title">{{ article.title | escape }}</h1>

            <div class="article-meta">
              {% if block.settings.show_date %}
                <span class="meta-item">
                  <svg
                    class="meta-ic"
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    aria-hidden="true"
                    fill="currentColor"
                  >
                    <path d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1V3a1 1 0 0 1 1-1Zm12 7H5v10h14V9Z"/>
                  </svg>
                  {{- article.published_at | time_tag: format: 'date' -}}
                </span>
              {% endif %}

              {% if block.settings.show_author %}
                <span class="meta-item author-block">
                  {% if block.settings.author_icon != blank %}
                    <img
                      src="{{ block.settings.author_icon | image_url: width: 48 }}"
                      srcset="
                        {{ block.settings.author_icon | image_url: width: 48 }} 1x,
                        {{ block.settings.author_icon | image_url: width: 96 }} 2x,
                        {{ block.settings.author_icon | image_url: width: 144 }} 3x
                      "
                      alt=""
                      class="author-icon"
                      width="24"
                      height="24"
                      loading="lazy"
                    >
                  {% endif %}
                  {{ article.author }}
                </span>
              {% endif %}

              {% if block.settings.show_reading_time %}
                {% liquid
                  assign word_count = article.content | strip_html | split: ' ' | size
                  assign read_minutes = word_count | divided_by: 200 | at_least: 1
                %}
                <span class="meta-item">{{ read_minutes }} min read</span>
              {% endif %}
            </div>
          </header>

        {% when 'content' %}
          <div class="main-content{% if block.settings.enable_dropcap %} dropcap{% endif %} page-width--narrow">
            {{ article.content }}
          </div>

        {% when 'share' %}
          <div class="social-sharing page-width--narrow">
            {% render 'share-button', block: block, article: article %}
          </div>
      {% endcase %}
    {% endfor %}

    {% if section.settings.show_prev_next and blog.previous_article or blog.next_article %}
      <nav class="article-pagination page-width--narrow" aria-label="Article navigation">
        {% if blog.previous_article %}
          <a class="article-pagination__link prev" href="{{ blog.previous_article.url }}">
            <span class="article-pagination__label">Previous</span>
            <span class="article-pagination__title">{{ blog.previous_article.title }}</span>
          </a>
        {% endif %}
        {% if blog.next_article %}
          <a class="article-pagination__link next" href="{{ blog.next_article.url }}">
            <span class="article-pagination__label">Next</span>
            <span class="article-pagination__title">{{ blog.next_article.title }}</span>
          </a>
        {% endif %}
      </nav>
    {% endif %}

    {% if section.settings.enable_comments and blog.comments_enabled? %}
      <div class="article-comments-wrapper page-width--narrow">
        {% paginate article.comments by 5 %}
          {% if article.comments_count > 0 %}
            <h2>{{ 'blog.article_comments' | t }}</h2>

            <div id="comments">
              {% for comment in article.comments %}
                <div class="article-comment">
                  <p class="comment-author">{{ comment.author }}</p>
                  <p class="comment-date">{{- comment.created_at | time_tag: format: 'date' -}}</p>
                  <div class="comment-content">{{ comment.content }}</div>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if paginate.pages > 1 %}
            <div class="pagination">
              {{ paginate | default_pagination: anchor: 'comments' }}
            </div>
          {% endif %}
        {% endpaginate %}

        {% form 'new_comment', article %}
          <h2>{{ 'blog.comment_form_title' | t }}</h2>
          {{ form.errors | default_errors }}

          <div class="comments-field">
            <div class="comment-field">
              <label for="CommentAuthor-{{ section.id }}">{{ 'blog.comment_form_name' | t }}</label>
              <input
                type="text"
                name="comment[author]"
                id="CommentAuthor-{{ section.id }}"
                value="{{ form.author }}"
                required
              >
            </div>
            <div class="comment-field">
              <label for="CommentEmail-{{ section.id }}">{{ 'blog.comment_form_email' | t }}</label>
              <input
                type="email"
                name="comment[email]"
                id="CommentEmail-{{ section.id }}"
                value="{{ form.email }}"
                required
              >
            </div>
            <div class="comment-field comment-field--full">
              <label for="CommentBody-{{ section.id }}">{{ 'blog.comment_form_body' | t }}</label>
              <textarea name="comment[body]" id="CommentBody-{{ section.id }}" required>{{ form.body }}</textarea>
            </div>
          </div>

          <input
            type="submit"
            class="comment-form-submit comment-field--full"
            value="{{ 'blog.comment_form_submit' | t }}"
          >
        {% endform %}
      </div>
    {% endif %}
  </div>
</div>

{% if template.name == 'article' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ article.title | json }},
      {% if article.image %}
      "image": "https:{{ article.image | image_url: width: 1500 }}",
      {% endif %}
      "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
      "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
      "author": {
        "@type": "Person",
        "name": {{ article.author | json }}
      },
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
        {% if settings.logo %}
        ,"logo": {
          "@type": "ImageObject",
          "url": "https:{{ settings.logo | image_url: width: 600 }}"
        }
        {% endif %}
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ shop.url }}{{ article.url }}"
      }
      {% if article.excerpt %}
      ,"description": {{ article.excerpt | default: article.content | strip_html | truncatewords: 30 | json }}
      {% endif %}
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "t:general.article",
  "tag": "article",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Header layout",
      "options": [
        { 
          "value": "stacked", 
          "label": "Classic (image, then title)" 
        },
        { 
          "value": "overlay", 
          "label": "Overlay (title on image)" 
        }
      ],
      "default": "stacked",
      "info": "Overlay only applies when the Featured Image block sits above the Title block, and only when an image is set."
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_prev_next",
      "label": "Show previous/next article links",
      "default": true
    },
    {
      "type": "header",
      "content": "Comments"
    },
    {
      "type": "checkbox",
      "id": "enable_comments",
      "label": "Enable comments section",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.section_settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "featured_image",
      "name": "Featured Image",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Aspect ratio",
          "options": [
            {
              "value": "adapt",
              "label": "Adapt to image"
            },
            {
              "value": "square",
              "label": "Square (1:1)"
            },
            {
              "value": "landscape",
              "label": "Landscape (16:9)"
            },
            {
              "value": "portrait",
              "label": "Portrait (3:4)"
            }
          ],
          "default": "landscape"
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "title_align",
          "label": "Title alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "checkbox",
          "id": "show_date",
          "label": "Show date",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_author",
          "label": "Show author",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "author_icon",
          "label": "Author icon"
        },
        {
          "type": "checkbox",
          "id": "show_reading_time",
          "label": "Show reading time",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_tags",
          "label": "Show tags",
          "default": true
        }
      ]
    },
    {
      "type": "content",
      "name": "Content",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_dropcap",
          "label": "Show drop cap",
          "default": false
        }
      ]
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "share_label",
          "label": "Label",
          "default": "Share"
        },
        {
          "type": "select",
          "id": "share_alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "flex-start",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "flex-end",
              "label": "Right"
            },
            {
              "value": "space-between",
              "label": "Space between"
            }
          ],
          "default": "flex-start"
        }
      ]
    }
  ]
}
{% endschema %}
