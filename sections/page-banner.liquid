{{ 'page-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.page_banner_color_scheme
  
  assign banner_title = collection.title
  assign banner_desc  = collection.description

  assign custom_title_stripped = section.settings.custom_title | strip_html | strip
  assign custom_desc_stripped  = section.settings.custom_description | strip_html | strip

  if custom_title_stripped != blank
    assign banner_title = section.settings.custom_title
  endif

  if custom_desc_stripped != blank
    assign banner_desc = section.settings.custom_description
  endif

  assign has_image = false
  if collection.image and section.settings.show_collection_image
    assign has_image = true
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .page-banner {
    --banner-pt: {{ section.settings.padding_top }}px;
    --banner-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div class="page-banner color-{{ scheme }} page-banner--align-{{ section.settings.title_align }} page-banner--title-{{ section.settings.title_size }}{% if has_image %} page-banner--has-image page-banner--overlay-{{ section.settings.overlay_opacity }}{% endif %}">

  {%- if has_image -%}
    <div class="page-banner__media" aria-hidden="true">
      {{- collection.image
        | image_url: width: 2000, height: 800, crop: 'center'
        | image_tag:
          class: 'page-banner__image',
          loading: 'eager',
          fetchpriority: 'high',
          alt: '',
          sizes: '100vw',
          widths: '600, 900, 1200, 1600, 2000'
      -}}
    </div>
  {%- endif -%}

  <div class="page-banner__content page-width">
    <div class="page-banner__inner">
      <h1 class="page-banner__title">{{ banner_title | escape }}</h1>

      {%- if banner_desc != blank and section.settings.show_description -%}
        <div class="page-banner__description">{{ banner_desc }}</div>
      {%- endif -%}
    </div>
  </div>

</div>


{% schema %}
{
  "name": "Page banner",
  "tag": "section",
  "class": "section-page-banner",
  "settings": [
    {
      "type": "header",
      "content": "t:labels.collection_title"
    },
    {
      "type": "inline_richtext",
      "id": "custom_title",
      "label": "Custom title",
      "info": "Overrides the default collection title."
    },
    {
      "type": "richtext",
      "id": "custom_description",
      "label": "Custom description",
      "info": "Overrides the default collection description."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:labels.show_description",
      "default": true
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "title_align",
      "label": "t:labels.alignment",
      "options": [
        { "label": "t:options.alignment.left",   "value": "left"   },
        { "label": "t:options.alignment.center", "value": "center" },
        { "label": "t:options.alignment.right",  "value": "right"  }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Heading size",
      "options": [
        { "label": "Small",  "value": "sm" },
        { "label": "Medium", "value": "md" },
        { "label": "Large",  "value": "lg" },
        { "label": "XL",     "value": "xl" }
      ],
      "default": "xl"
    },
    {
      "type": "header",
      "content": "Collection image"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image",
      "default": false
    },
    {
      "type": "select",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "options": [
        { "label": "None",   "value": "0"  },
        { "label": "Light",  "value": "30" },
        { "label": "Medium", "value": "50" },
        { "label": "Dark",   "value": "70" }
      ],
      "default": "30"
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "color_scheme",
      "id": "page_banner_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Page banner"
    }
  ]
}
{% endschema %}

