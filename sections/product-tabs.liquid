{%- liquid
  assign heading_text = section.settings.heading
  assign highlight = section.settings.heading_highlight

  if highlight != blank and heading_text contains highlight
    assign wrapped_highlight = '<span class="product-tabs__highlight">' | append: highlight | append: '</span>'
    assign heading_markup = heading_text | replace: highlight, wrapped_highlight
  else
    assign heading_markup = heading_text
  endif

  assign show_button_top = section.settings.show_button_beside_tabs
  assign has_button = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign has_button = true
  endif
-%}

<div
  class="product-tabs color-{{ section.settings.color_scheme | default: 'scheme-1' }}"
  id="product-tabs-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="product-tabs"
>
  <div class="page-width">
    <div class="product-tabs__header product-tabs__header--{{ section.settings.header_layout }}">
      {%- if heading_text != blank -%}
        <h2 class="product-tabs__heading product-tabs__heading--{{ section.settings.heading_size }}">
          {{ heading_markup }}
        </h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div
          class="product-tabs__nav product-tabs__nav--{{ section.settings.tab_style }}"
          role="tablist"
          aria-label="Product collection tabs"
        >
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="product-tabs__tab{% if forloop.first %} is-active{% endif %}"
              id="product-tabs-tab-{{ section.id }}-{{ block.id }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="product-tabs-panel-{{ section.id }}-{{ block.id }}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              data-tab-trigger="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_name | default: block.settings.collection.title }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if has_button and show_button_top -%}
        <a
          href="{{ section.settings.button_link }}"
          class="product-tabs__view-all product-tabs__view-all--top button button--{{ section.settings.button_style }}"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- assign tab_collection = block.settings.collection -%}
      <div
        class="product-tabs__panel{% if forloop.first %} is-active{% endif %}"
        id="product-tabs-panel-{{ section.id }}-{{ block.id }}"
        role="tabpanel"
        aria-labelledby="product-tabs-tab-{{ section.id }}-{{ block.id }}"
        data-tab-panel="{{ block.id }}"
        {% unless forloop.first %}hidden{% endunless %}
        {{ block.shopify_attributes }}
      >
        <ul
          class="product-tabs__grid
            product-tabs__grid--cols-mobile-{{ section.settings.columns_mobile }}
            product-tabs__grid--cols-desktop-{{ section.settings.columns_desktop }}
            {% if section.settings.enable_swipe_mobile %}product-tabs__grid--swipe{% endif %}"
          style="--tabs-col-gap: {{ section.settings.column_gap }}px; --tabs-row-gap: {{ section.settings.row_gap }}px;"
        >
          {%- if tab_collection != blank -%}
            {%- for product in tab_collection.products limit: section.settings.products_per_tab -%}
              <li class="product-tabs__item">
                {% render 'product-card', product: product, lazy: forloop.index %}
              </li>
            {%- else -%}
              <li class="product-tabs__empty">
                This collection has no products yet.
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="product-tabs__empty">
              Select a collection for this tab.
            </li>
          {%- endif -%}
        </ul>

        {%- if has_button and show_button_top == false -%}
          <div class="product-tabs__view-all-wrap">
            <a
              href="{{ section.settings.button_link }}"
              class="product-tabs__view-all button button--{{ section.settings.button_style }}"
            >
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{{ 'component-product-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-product-tabs.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product tabs",
  "tag": "section",
  "class": "section section--product-tabs",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Layout",
      "options": [
        { "value": "vertical", "label": "Vertical" },
        { "value": "horizontal", "label": "Horizontal" }
      ],
      "default": "horizontal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's hot"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlight text",
      "info": "Must exactly match a word or phrase inside the heading above."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Grid settings"
    },
    {
      "type": "range",
      "id": "products_per_tab",
      "label": "Products per tab",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "enable_swipe_mobile",
      "label": "Enable swipe on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "show_button_beside_tabs",
      "label": "Show beside tabs on desktop",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "link", "label": "Underline" }
      ],
      "default": "link"
    },
    {
      "type": "header",
      "content": "Tab settings"
    },
    {
      "type": "select",
      "id": "tab_style",
      "label": "Navigation style",
      "options": [
        { "value": "design-1", "label": "Design 1 — Underline" },
        { "value": "design-2", "label": "Design 2 — Pill" }
      ],
      "default": "design-1"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_name",
          "label": "Tab name",
          "default": "New tab"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Product tabs",
      "category": "Products",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}