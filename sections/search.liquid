{{ 'facets.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'collection-card.css' | asset_url | stylesheet_tag }}
{{ 'blog-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.search_color_scheme
  assign cols_desktop = section.settings.card_per_row
  assign cols_mobile = section.settings.card_per_row_mobile
  assign filter_layout = section.settings.filter_type | default: 'vertical'

  assign has_active_search_filters = false
  for filter in search.filters
    if filter.active_values.size > 0
      assign has_active_search_filters = true
    endif
    if filter.type == 'price_range' and filter.min_value.value != blank or filter.max_value.value != blank
      assign has_active_search_filters = true
    endif
  endfor
-%}

{% style %}
  #SearchSection-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #FacetsProductGrid-{{ section.id }} {
    --cols-desktop: {{ cols_desktop }};
    --cols-mobile: {{ cols_mobile }};
  }
{% endstyle %}

<div
  id="SearchSection-{{ section.id }}"
  class="search-section color-{{ scheme }}"
  data-section-id="{{ section.id }}"
  data-section="{{ section.id }}"
>
  <div class="page-width">
    <div class="search-results__header">
      <span class="search-results__eyebrow">{{ 'search.title' | t: default: 'Search' }}</span>

      {%- if search.performed -%}
        <h1 class="search-results__title">
          {%- if search.terms != blank -%}
            {{
              'search.results_for'
              | t: terms: search.terms, default: 'Results for “'
              | append: search.terms
              | append: '”'
            }}
          {%- else -%}
            {{ 'search.no_terms' | t: default: 'Search' }}
          {%- endif -%}
        </h1>
        <p class="search-results__count">
          {{
            'search.results_count'
            | t: count: search.results_count, default: search.results_count
            | append: ' results found'
          }}
        </p>
      {%- else -%}
        <h1 class="search-results__title">{{ 'search.title' | t: default: 'Search our store' }}</h1>
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-results__form">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t: default: 'Search products, collections, articles…' }}"
          aria-label="{{ 'search.title' | t: default: 'Search' }}"
        >
        <input type="hidden" name="type" value="product,article,page,collection">
        <button type="submit">{{ 'search.search' | t: default: 'Search' }}</button>
      </form>
    </div>

    {% paginate search.results by section.settings.products_per_page %}
      {%- if search.performed and search.results_count == 0 and has_active_search_filters == false -%}
        <div class="search-results__empty">
          <p class="search-results__empty-title">
            {{
              'search.no_results_title'
              | t: terms: search.terms, default: 'No results for “'
              | append: search.terms
              | append: '”'
            }}
          </p>
          <p class="search-results__empty-text">
            {{
              'search.no_results_text'
              | t: default: 'Check the spelling or try a more general term. Here are a few places to start instead.'
            }}
          </p>
        </div>

      {%- elsif search.performed -%}
        {%- assign show_facets = false -%}
        {%- if section.settings.enable_filtering and search.filters != empty -%}
          {%- assign show_facets = true -%}
        {%- endif -%}

        {%- capture search_hidden_inputs -%}
          <input type="hidden" name="q" value="{{ search.terms | escape }}">
          <input type="hidden" name="type" value="product,article,page,collection">
          {%- if search.sort_by != blank -%}
            <input type="hidden" name="sort_by" value="{{ search.sort_by }}">
          {%- endif -%}
        {%- endcapture -%}

        {%- capture search_clear_all_url -%}
          {{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product,article,page,collection
        {%- endcapture -%}
        {%- assign search_clear_all_url = search_clear_all_url | strip_newlines | strip -%}

        <div class="search-results__layout{% if show_facets and filter_layout == 'vertical' %} search-results__layout--sidebar{% endif %}">
          {%- if show_facets and filter_layout == 'vertical' -%}
            <aside
              class="search-results__facets"
              id="FacetsFilters-{{ section.id }}"
              aria-label="{{ 'search.filters' | t: default: 'Filters' }}"
            >
              {%- render 'facets',
                filters: search.filters,
                form_id: 'FacetsForm',
                extra_hidden_inputs: search_hidden_inputs,
                layout: 'vertical'
                clear_all_url: search_clear_all_url
              -%}
            </aside>
          {%- endif -%}

          <div class="search-results__main">
            <div
              id="FacetsAnnounce-{{ section.id }}"
              class="visually-hidden"
              aria-live="polite"
              aria-atomic="true"
              role="status"
            ></div>

            <div class="search-results__toolbar">
              <div
                class="search-results__toolbar-start"
                {% if show_facets and filter_layout != 'vertical' %}
                  id="FacetsFilters-{{ section.id }}"
                {% endif %}
              >
                {%- if show_facets and filter_layout != 'vertical' -%}
                  {%- render 'facets',
                    filters: search.filters,
                    form_id: 'FacetsForm',
                    extra_hidden_inputs: search_hidden_inputs,
                    layout: filter_layout
                    clear_all_url: search_clear_all_url
                  -%}
                {%- endif -%}
              </div>

              <div class="search-results__toolbar-end">
                {%- if section.settings.enable_sorting -%}
                  <div id="FacetsSort-{{ section.id }}">
                    <form class="search-results__sort" action="{{ routes.search_url }}" method="get">
                      <input type="hidden" name="q" value="{{ search.terms | escape }}">
                      <input type="hidden" name="type" value="product,article,page,collection">
                      <label for="FacetsSortBy">{{ 'search.sort_by' | t: default: 'Sort by' }}</label>
                      <select id="FacetsSortBy" name="sort_by">
                        {%- for option in search.sort_options -%}
                          <option
                            value="{{ option.value | escape }}"
                            {% if option.value == search.sort_by %}
                              selected
                            {% endif %}
                          >
                            {{ option.name | escape }}
                          </option>
                        {%- endfor -%}
                      </select>
                      <noscript>
                        <button type="submit">{{ 'search.apply' | t: default: 'Apply' }}</button>
                      </noscript>
                    </form>
                  </div>
                {%- endif -%}
                <div id="FacetsProductCount-{{ section.id }}">
                  <p class="search-results__count" tabindex="-1">
                    {{ search.results_count }}
                    {{ 'search.items' | t: default: 'items' }}
                  </p>
                </div>
              </div>
            </div>

            {%- if show_facets -%}
              <div id="FacetsActiveFilters-{{ section.id }}">
                {%- render 'facets-active', filters: search.filters, clear_all_url: search_clear_all_url -%}
              </div>
            {%- endif -%}

            <div
              id="FacetsProductGrid-{{ section.id }}"
              class="search-results__grid"
              tabindex="-1"
              aria-label="{{ 'search.result' | t: default: 'Search results' }}"
            >
              {%- if search.results_count == 0 -%}
                <div class="search-results__empty-inline" data-facets-empty role="status">
                  <p class="search-results__empty-inline-text">
                    {{ 'collections.general.no_matches' | t: default: 'No results match your filters.' }}
                  </p>
                </div>
              {%- else -%}
                {%- for item in search.results -%}
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      {%- render 'product-card',
                        product: item,
                        show_vendor: section.settings.show_vendor,
                        show_quick_add: settings.show_quick_add,
                        quick_add_hover_only: settings.enable_quick_button_on_hover,
                        lazy: forloop.index
                      -%}

                    {%- when 'article' -%}
                      {%- render 'blog-card',
                        article: item,
                        show_excerpt: section.settings.show_excerpt,
                        show_author: section.settings.show_author,
                        show_date: section.settings.show_date,
                        show_tags: section.settings.show_tags_on_card
                      -%}

                    {%- when 'collection' -%}
                      {%- render 'collection-card', collection: item, section: section -%}

                    {%- when 'page' -%}
                      <a href="{{ item.url }}" class="search-result-card--page">
                        <p class="search-result-card__type">{{ 'search.page' | t: default: 'Page' }}</p>
                        <p class="search-result-card__title">{{ item.title }}</p>
                      </a>
                  {%- endcase -%}
                {%- endfor -%}
              {%- endif -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <div
                id="FacetsPagination-{{ section.id }}"
                class="search-results__pagination"
                data-facets-pagination
                aria-label="{{ 'search.pagination.label' | t: default: 'Pagination' }}"
              >
                {%- render 'pagination', pagination: paginate -%}
              </div>
            {%- endif -%}
          </div>
        </div>

      {%- else -%}
        <div class="search-results__empty">
          <p class="search-results__empty-text">
            {{
              'search.prompt'
              | t: default: 'Enter a search term above to find products, collections, pages, and articles.'
            }}
          </p>
        </div>
      {%- endif -%}
    {% endpaginate %}
  </div>
</div>

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:general.search",
  "tag": "section",
  "class": "section-search",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.filter_and_sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:labels.enable_filters",
      "default": true,
      "info": "t:informative_content.filters_info"
    },
    {
      "type": "select",
      "label": "t:labels.filter_layout",
      "id": "filter_type",
      "options": [
        { 
          "value": "horizontal", 
          "label": "t:options.direction.horizontal" 
        },
        { 
          "value": "vertical", 
          "label": "t:options.direction.vertical" 
        },
        { 
          "value": "drawer", 
          "label": "t:options.direction.drawer" 
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:labels.sort_selector",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.search_results_grid"
    },
    {
      "type": "select",
      "id": "card_per_row",
      "label": "t:labels.card_per_row",
      "options": [
        { 
          "value": "2", 
          "label": "2" 
        },
        { 
          "value": "3", 
          "label": "3" 
        },
        { 
          "value": "4", 
          "label": "4" 
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "card_per_row_mobile",
      "label": "t:labels.card_per_row_mobile",
      "options": [
        { 
          "value": "1", 
          "label": "1" 
        },
        { 
          "value": "2", 
          "label": "2" 
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:labels.results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.card_content"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:labels.show_product_vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:labels.show_article_excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:labels.show_article_author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:labels.show_article_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags_on_card",
      "label": "t:labels.show_article_tag",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.section_settings"
    },
    {
      "type": "color_scheme",
      "id": "search_color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ]
}
{% endschema %}
