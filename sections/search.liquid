{{ 'facets.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'collection-card.css' | asset_url | stylesheet_tag }}
{{ 'blog-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.search_color_scheme
  assign cols_desktop = section.settings.card_per_row
  assign cols_mobile = section.settings.card_per_row_mobile
  assign filter_layout = section.settings.filter_type | default: 'vertical'
-%}

{% style %}
  #SearchSection-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #SearchResultsGrid-{{ section.id }} {
    --cols-desktop: {{ cols_desktop }};
    --cols-mobile: {{ cols_mobile }};
  }
{% endstyle %}

<div
  id="SearchSection-{{ section.id }}"
  class="search-section color-{{ scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="page-width">

    <div class="search-results__header">
      <span class="search-results__eyebrow">{{ 'search.title' | t: default: 'Search' }}</span>

      {%- if search.performed -%}
        <h1 class="search-results__title">
          {%- if search.terms != blank -%}
            {{
              'search.results_for'
              | t: terms: search.terms, default: 'Results for “'
              | append: search.terms
              | append: '”'
            }}
          {%- else -%}
            {{ 'search.no_terms' | t: default: 'Search' }}
          {%- endif -%}
        </h1>
        <p class="search-results__count">
          {{
            'search.results_count'
            | t: count: search.results_count, default: search.results_count
            | append: ' results found'
          }}
        </p>
      {%- else -%}
        <h1 class="search-results__title">{{ 'search.title' | t: default: 'Search our store' }}</h1>
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-results__form">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t: default: 'Search products, collections, articles…' }}"
          aria-label="{{ 'search.title' | t: default: 'Search' }}"
        >
        <input type="hidden" name="type" value="product,article,page,collection">
        <button type="submit">{{ 'search.search' | t: default: 'Search' }}</button>
      </form>
    </div>

    {% paginate search.results by section.settings.products_per_page %}

      {%- if search.performed and search.results_count == 0 -%}

        <div class="search-results__empty">
          <p class="search-results__empty-title">
            {{ 'search.no_results_title' | t: terms: search.terms, default: 'No results for “' | append: search.terms | append: '”' }}
          </p>
          <p class="search-results__empty-text">
            {{ 'search.no_results_text' | t: default: 'Check the spelling or try a more general term. Here are a few places to start instead.' }}
          </p>
        </div>

      {%- elsif search.performed -%}

        {%- assign has_shoppable_results = false -%}
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' or item.object_type == 'collection' -%}
            {%- assign has_shoppable_results = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign show_facets = false -%}
        {%- if section.settings.enable_filtering and has_shoppable_results and search.filters != empty -%}
          {%- assign show_facets = true -%}
        {%- endif -%}

        {%- capture search_hidden_inputs -%}
          <input type="hidden" name="q" value="{{ search.terms | escape }}">
          <input type="hidden" name="type" value="product,article,page,collection">
        {%- endcapture -%}

        <div class="search-results__layout{% if show_facets and filter_layout == 'vertical' %} search-results__layout--sidebar{% endif %}">

          {%- if show_facets and filter_layout == 'vertical' -%}
            <aside class="search-results__facets" aria-label="{{ 'search.filters' | t: default: 'Filters' }}">
              {%- render 'facets',
                filters: search.filters,
                form_id: 'FacetFiltersForm',
                extra_hidden_inputs: search_hidden_inputs,
                layout: 'vertical'
              -%}
            </aside>
          {%- endif -%}

          <div class="search-results__main">

            {% comment %} {%- if section.settings.enable_sorting -%}
              <div class="search-results__toolbar">
                <p class="search-results__count">{{ search.results_count }} {{ 'search.items' | t: default: 'items' }}</p>
                <form class="search-results__sort" action="{{ routes.search_url }}" method="get">
                  <input type="hidden" name="q" value="{{ search.terms | escape }}">
                  <input type="hidden" name="type" value="product,article,page,collection">
                  <label for="SearchSortBy">{{ 'search.sort_by' | t: default: 'Sort by' }}</label>
                  <select id="SearchSortBy" name="sort_by" onchange="this.form.submit()">
                    {%- for option in search.sort_options -%}
                      <option value="{{ option.value | escape }}" {% if option.value == search.sort_by %}selected{% endif %}>
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                </form>
              </div>
            {%- endif -%} {% endcomment %}

            <div class="search-results__toolbar">
              <div class="search-results__toolbar-start">
                {%- if show_facets and filter_layout != 'vertical' -%}
                  {%- render 'facets',
                    filters: search.filters,
                    form_id: 'FacetFiltersForm',
                    extra_hidden_inputs: search_hidden_inputs,
                    layout: filter_layout
                  -%}
                {%- endif -%}
              </div>

              <div class="search-results__toolbar-end">
                {%- if section.settings.enable_sorting -%}
                  <form class="search-results__sort" action="{{ routes.search_url }}" method="get">
                    <input type="hidden" name="q" value="{{ search.terms | escape }}">
                    <input type="hidden" name="type" value="product,article,page,collection">
                    <label for="SearchSortBy">{{ 'search.sort_by' | t: default: 'Sort by' }}</label>
                    <select id="SearchSortBy" name="sort_by" onchange="this.form.submit()">
                      {%- for option in search.sort_options -%}
                        <option value="{{ option.value | escape }}" {% if option.value == search.sort_by %}selected{% endif %}>
                          {{ option.name | escape }}
                        </option>
                      {%- endfor -%}
                    </select>
                  </form>
                {%- endif -%}
                <p class="search-results__count">{{ search.results_count }} {{ 'search.items' | t: default: 'items' }}</p>
              </div>
            </div>

            <div
              id="SearchResultsGrid-{{ section.id }}"
              class="search-results__grid"
              tabindex="-1"
              aria-label="{{ 'search.result' | t: default: 'Search results' }}"
            >
              {%- for item in search.results -%}
                {%- case item.object_type -%}

                  {%- when 'product' -%}
                    {%- render 'product-card',
                      product: item,
                      show_vendor: section.settings.show_vendor,
                      show_quick_add: settings.show_quick_add,
                      quick_add_hover_only: settings.enable_quick_button_on_hover,
                      lazy: forloop.index
                    -%}

                  {%- when 'article' -%}
                    {%- render 'blog-card',
                      article: item,
                      show_excerpt: section.settings.show_excerpt,
                      show_author: section.settings.show_author,
                      show_date: section.settings.show_date,
                      show_tags: section.settings.show_tags_on_card
                    -%}

                  {%- when 'collection' -%}
                    {%- render 'collection-card', collection: item, section: section -%}

                  {%- when 'page' -%}
                    <a href="{{ item.url }}" class="search-result-card--page">
                      <p class="search-result-card__type">{{ 'search.page' | t: default: 'Page' }}</p>
                      <p class="search-result-card__title">{{ item.title }}</p>
                    </a>

                {%- endcase -%}
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <div class="search-results__pagination" aria-label="{{ 'search.pagination.label' | t: default: 'Pagination' }}">
                {%- render 'pagination', pagination: paginate -%}
              </div>
            {%- endif -%}

          </div>
        </div>

      {%- else -%}

        <div class="search-results__empty">
          <p class="search-results__empty-text">
            {{ 'search.prompt' | t: default: 'Enter a search term above to find products, collections, pages, and articles.' }}
          </p>
        </div>

      {%- endif -%}

    {% endpaginate %}

  </div>
</div>

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:general.search",
  "tag": "section",
  "class": "section-search",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Search results grid"
    },
    {
      "type": "select",
      "id": "card_per_row",
      "label": "Cards per row (desktop)",
      "options": [
        { 
          "value": "3", 
          "label": "3" 
        },
        { 
          "value": "4", 
          "label": "4" 
        },
        { 
          "value": "5", 
          "label": "5" 
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "card_per_row_mobile",
      "label": "Cards per row (mobile)",
      "options": [
        { 
          "value": "1", 
          "label": "1" 
        },
        { 
          "value": "2", 
          "label": "2" 
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Results per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show article excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show article author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show article date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags_on_card",
      "label": "Show article tag",
      "default": false
    },
    {
      "type": "header",
      "content": "t:general.filter_and_sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:labels.enable_filters",
      "default": true,
      "info": "t:informative_content.filters_info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "drawer",
          "label": "Drawer"
        }
      ],
      "default": "horizontal",
      "label": "Filter layout"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:labels.sort_selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "color_scheme",
      "id": "search_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ]
}
{% endschema %}

