{%- liquid
  assign hb_image = section.settings.image
  assign hb_mobile_image = section.settings.mobile_image | default: section.settings.image
  assign hb_has_image = false
  if hb_image != blank
    assign hb_has_image = true
  endif

  assign hb_button_count = 0
  for block in section.blocks
    if block.type == 'button'
      assign hb_button_count = hb_button_count | plus: 1
    endif
  endfor

  assign hb_whole_banner_link = false
  if section.settings.banner_link != blank and hb_button_count == 0
    assign hb_whole_banner_link = true
  endif

  assign hb_wrapper_tag = 'div'
  if hb_whole_banner_link
    assign hb_wrapper_tag = 'a'
  endif
-%}

{% style %}
  .hero-{{ section.id }} {
    --hb-overlay-color: {{ section.settings.overlay_color }};
    --hb-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hb-padding-top: {{ section.settings.padding_top }}px;
    --hb-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hb-mobile-aspect-ratio: {% if hb_mobile_image != blank %}{{ hb_mobile_image.aspect_ratio }}{% else %}1{% endif %};
    --hb-desktop-aspect-ratio: {% if hb_image != blank %}{{ hb_image.aspect_ratio }}{% else %}1{% endif %};
  }
{% endstyle %}

<div
  class="hero-banner hero-{{ section.id }} color-{{ section.settings.color_scheme }}"
  data-height="{{ section.settings.desktop_height }}"
  data-height-mobile="{{ section.settings.mobile_height }}"
>
  <{{ hb_wrapper_tag }}
    class="hero-banner__wrapper hero-banner__wrapper--{{ section.settings.content_position }} hero-banner__wrapper--align-{{ section.settings.content_alignment }}"
    {% if hb_whole_banner_link %}
      href="{{ section.settings.banner_link }}"
      aria-label="{{ section.settings.heading_fallback_label | default: 'View more' | escape }}"
    {% endif %}
  >

    <div class="hero-banner__media">
      {%- if hb_has_image -%}
        <picture class="hero-banner__picture">
          {%- if section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ hb_mobile_image | image_url: width: 375 }} 375w,
                {{ hb_mobile_image | image_url: width: 750 }} 750w,
                {{ hb_mobile_image | image_url: width: 1125 }} 1125w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {{
            hb_image
            | image_url: width: 3200
            | image_tag:
              class: 'hero-banner__image',
              widths: '750, 1100, 1500, 2000, 3200',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.image_alt
          }}
        </picture>
      {%- else -%}
        <div class="hero-banner__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-banner__placeholder-svg' }}
        </div>
      {%- endif -%}
      <div class="hero-banner__overlay" aria-hidden="true"></div>
    </div>

    <div class="hero-banner__content-wrap">
      <div class="hero-banner__content hero-banner__content--{{ section.settings.content_width }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'subheading' -%}
              <p class="subheading hero-banner__subheading" {{ block.shopify_attributes }}>
                {{ block.settings.sub_texttext | escape }}
              </p>

            {%- when 'heading' -%}
              {% assign hb_tag = block.settings.heading_size | default: 'h2' %}
              {%- if hb_tag == 'h1' -%}
                <h1 class="hero-banner__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h1>
              {%- elsif hb_tag == 'h3' -%}
                <h3 class="hero-banner__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h3>
              {%- else -%}
                <h2 class="hero-banner__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
              {%- endif -%}

            {%- when 'text' -%}
              <div class="hero-banner__text" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>

            {%- when 'button' -%}
              {%- if block.settings.label != blank -%}
                <div class="hero-banner__button-wrap" {{ block.shopify_attributes }}>
                  <a
                    href="{{ block.settings.link | default: '#' }}"
                    class="btn {% if block.settings.style == 'secondary' %}btn--secondary{% elsif block.settings.style == 'link' %}hero-banner__link{% else %}btn--primary{% endif %} hero-banner__button"
                    {% if block.settings.link == blank %}aria-disabled="true" tabindex="-1"{% endif %}
                  >
                    {{ block.settings.label | escape }}
                  </a>
                </div>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

  </{{ hb_wrapper_tag }}>
</div>

{% stylesheet %}
  .hero-banner {
    position: relative;
    padding-top: var(--hb-padding-top, 0px);
    padding-bottom: var(--hb-padding-bottom, 0px);
    overflow: hidden;
  }

  .hero-banner__wrapper {
    position: relative;
    display: flex;
    min-height: 55vh;
    color: inherit;
    text-decoration: none;
  }

  a.hero-banner__wrapper {
    color: inherit;
  }

  .hero-banner[data-height-mobile="small"] .hero-banner__wrapper { 
    min-height: 40vh; 
  }
  .hero-banner[data-height-mobile="medium"] .hero-banner__wrapper { 
    min-height: 55vh; 
  }
  .hero-banner[data-height-mobile="large"] .hero-banner__wrapper { 
    min-height: 70vh; 
  }
  .hero-banner[data-height-mobile="fullscreen"] .hero-banner__wrapper { 
    min-height: 100svh; 
  }
  .hero-banner[data-height-mobile="adapt"] .hero-banner__wrapper { 
    min-height: 0; 
    aspect-ratio: var(--hb-mobile-aspect-ratio); 
  }

  @media (min-width: 750px) {
    .hero-banner[data-height="small"] .hero-banner__wrapper { 
      min-height: 45vh; 
      aspect-ratio: auto; 
    }
    .hero-banner[data-height="medium"] .hero-banner__wrapper { 
      min-height: 60vh; 
      aspect-ratio: auto; 
    }
    .hero-banner[data-height="large"] .hero-banner__wrapper { 
      min-height: 80vh; 
      aspect-ratio: auto; 
    }
    .hero-banner[data-height="fullscreen"] .hero-banner__wrapper { 
      min-height: 100svh; 
      aspect-ratio: auto; 
    }
    .hero-banner[data-height="adapt"] .hero-banner__wrapper { 
      min-height: 0; 
      aspect-ratio: var(--hb-desktop-aspect-ratio); 
    }
  }

  .hero-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero-banner__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-banner__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-border);
  }

  .hero-banner__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--hb-overlay-color, #000000);
    opacity: var(--hb-overlay-opacity, 0.3);
    pointer-events: none;
  }

  .hero-banner__content-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    width: 100%;
    padding: 2rem 1.25rem;
  }

  .hero-banner__wrapper--top-left .hero-banner__content-wrap,
  .hero-banner__wrapper--top-center .hero-banner__content-wrap,
  .hero-banner__wrapper--top-right .hero-banner__content-wrap {
    align-items: flex-start;
  }

  .hero-banner__wrapper--middle-left .hero-banner__content-wrap,
  .hero-banner__wrapper--middle-center .hero-banner__content-wrap,
  .hero-banner__wrapper--middle-right .hero-banner__content-wrap {
    align-items: center;
  }

  .hero-banner__wrapper--bottom-left .hero-banner__content-wrap,
  .hero-banner__wrapper--bottom-center .hero-banner__content-wrap,
  .hero-banner__wrapper--bottom-right .hero-banner__content-wrap {
    align-items: flex-end;
  }

  .hero-banner__wrapper--top-left .hero-banner__content-wrap,
  .hero-banner__wrapper--middle-left .hero-banner__content-wrap,
  .hero-banner__wrapper--bottom-left .hero-banner__content-wrap {
    justify-content: flex-start;
  }

  .hero-banner__wrapper--top-center .hero-banner__content-wrap,
  .hero-banner__wrapper--middle-center .hero-banner__content-wrap,
  .hero-banner__wrapper--bottom-center .hero-banner__content-wrap {
    justify-content: center;
  }

  .hero-banner__wrapper--top-right .hero-banner__content-wrap,
  .hero-banner__wrapper--middle-right .hero-banner__content-wrap,
  .hero-banner__wrapper--bottom-right .hero-banner__content-wrap {
    justify-content: flex-end;
  }

  .hero-banner__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 100%;
  }

  .hero-banner__content--narrow { 
    max-width: 26rem; 
  }
  .hero-banner__content--medium { 
    max-width: 36rem; 
  }
  .hero-banner__content--wide { 
    max-width: 48rem; 
  }

  .hero-banner__wrapper--align-left .hero-banner__content { 
    align-items: flex-start; 
    text-align: left; 
  }
  .hero-banner__wrapper--align-center .hero-banner__content { 
    align-items: center; 
    text-align: center; 
  }
  .hero-banner__wrapper--align-right .hero-banner__content { 
    align-items: flex-end; 
    text-align: right; 
  }

  .hero-banner__subheading {
    color: var(--color-primary);
    margin: 0;
  }

  .hero-banner__heading {
    color: var(--color-foreground-heading);
    margin: 0;
    line-height: 1.1;
  }

  .hero-banner__text {
    color: var(--color-foreground);
    max-width: 42ch;
  }

  .hero-banner__text p {
    margin: 0;
  }

  .hero-banner__content-wrap ~ .hero-banner__content-wrap,
  .hero-banner__content {
    row-gap: 1rem;
  }

  .hero-banner__button-wrap {
    display: inline-flex;
  }

  .hero-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.85rem 1.75rem;
    border-radius: var(--style-border-radius, 4px);
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .btn--primary.hero-banner__button {
    background-color: var(--color-btn-primary-bg);
    color: var(--color-btn-primary-text);
    border: 1px solid var(--color-btn-primary-border);
  }

  .btn--primary.hero-banner__button:hover {
    background-color: var(--color-btn-primary-hover-bg);
    color: var(--color-btn-primary-hover-text);
    border-color: var(--color-btn-primary-hover-border);
  }

  .btn--secondary.hero-banner__button {
    background-color: var(--color-btn-secondary-bg);
    color: var(--color-btn-secondary-text);
    border: 1px solid var(--color-btn-secondary-border);
  }

  .btn--secondary.hero-banner__button:hover {
    background-color: var(--color-btn-secondary-hover-bg);
    color: var(--color-btn-secondary-hover-text);
    border-color: var(--color-btn-secondary-hover-border);
  }

  .hero-banner__link {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--color-primary);
    background: none;
    border: none;
    padding: 0.5rem 0;
  }

  .hero-banner__wrapper:focus-visible,
  .hero-banner__button:focus-visible,
  .hero-banner__link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .hero-banner__content {
    --hb-buttons-row: flex-start;
  }

  @media (min-width: 480px) {
    .hero-banner__content > .hero-banner__button-wrap {
      display: inline-flex;
    }
  }
{% endstylesheet %}

{% schema %}
