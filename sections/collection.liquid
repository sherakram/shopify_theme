{{ 'collection.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign page_size = section.settings.page_size_default
  assign cols_desktop = section.settings.product_per_row
  assign cols_mobile = section.settings.product_per_row_mobile
  assign scheme = section.settings.collection_color_scheme
-%}

{% style %}
  #CollectionSection-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
  }

  #CollectionProductGrid-{{ section.id }} {
    --cols-desktop: {{ cols_desktop }};
    --cols-mobile: {{ cols_mobile }};
  }
{% endstyle %}

<div
  id="CollectionSection-{{ section.id }}"
  class="collection-section color-{{ scheme }}"
  data-section-id="{{ section.id }}"
>
  
  {%- render 'filters-sorting' -%}
  
  <div class="page-width">

    {%- assign has_active = false -%}
    {%- for f in collection.filters -%}
      {%- if f.active_values.size > 0 -%}
        {%- assign has_active = true -%}
      {%- endif -%}

      {%- if f.type == 'price_range' -%}
        {%- if f.min_value.value or f.max_value.value -%}
          {%- assign has_active = true -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_active -%}
      <div class="collection-active-filters">
        <span>{{ collection.products_count }} results</span>

        {%- for f in collection.filters -%}
          {%- for v in f.active_values -%}
            <a href="{{ v.url_to_remove }}" class="filter-pill fs-filter-remove">
              {{ f.label }}: {{ v.label }}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="10"
                height="10"
                viewBox="0 0 10 10"
                fill="none"
                aria-hidden="true"
              >
                <path d="M1 1L9 9M9 1L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          {%- endfor -%}

          {%- if f.type == 'price_range' -%}
            {%- if f.min_value.value or f.max_value.value -%}
              {%- assign pill_min = f.min_value.value | default: f.range_min | money_without_trailing_zeros -%}
              {%- assign pill_max = f.max_value.value | default: f.range_max | money_without_trailing_zeros -%}
              <a href="{{ f.url_to_remove }}" class="filter-pill fs-filter-remove">
                {{ f.label }}: {{ pill_min }} – {{ pill_max }}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="10"
                  height="10"
                  viewBox="0 0 10 10"
                  fill="none"
                  aria-hidden="true"
                >
                  <path d="M1 1L9 9M9 1L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- paginate collection.products by page_size -%}
      <div
        id="CollectionProductGrid-{{ section.id }}"
        class="collection-grid"
        tabindex="-1"
        aria-label="{{ collection.title }} products"
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection-empty" role="status">
            <p class="collection-empty__text">{{ 'collections.general.no_matches' | t }}</p>
          </div>

        {%- else -%}
          {%- for product in collection.products -%}
            {%- render 'product-card',
              product: product,
              show_quick_add: settings.show_quick_add,
              quick_add_hover_only: settings.enable_quick_button_on_hover,
              lazy: forloop.index
            -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div
          id="CollectionPagination-{{ section.id }}"
          class="collection-pagination"
          aria-label="{{ 'accessibility.pagination_label' | t }}"
        >
          {%- render 'pagination', pagination: paginate -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.collection",
  "tag": "section",
  "class": "section-collection",
  "settings": [
    {
      "type": "header",
      "content": "t:general.filter_and_sorting"
    },
    {
      "type": "checkbox",
      "id": "filters_use_drawer",
      "label": "t:labels.drawer_popup",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "t:labels.enable_filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sort",
      "label": "t:labels.sort_selector",
      "default": true
    },
    {
      "type": "text",
      "id": "sort_options",
      "label": "t:labels.sort_options",
      "default": "Featured:manual, Best selling:best-selling, Price, low to high:price-ascending, Price, high to low:price-descending, Newest:created-descending"
    },
    {
      "type": "header",
      "content": "t:general.product_grid"
    },
    {
      "type": "select",
      "id": "product_per_row",
      "label": "Products per row (desktop)",
      "options": [
        {
          "label": "2",
          "value": "2"
        },
        {
          "label": "3",
          "value": "3"
        },
        {
          "label": "4",
          "value": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "product_per_row_mobile",
      "label": "Products per row (mobile)",
      "options": [
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "page_size_default",
      "label": "t:labels.items_per_page",
      "min": 12,
      "max": 50,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "color_scheme",
      "id": "collection_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ]
}
{% endschema %}
