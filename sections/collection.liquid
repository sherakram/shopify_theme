{{ 'facets.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign page_size = section.settings.page_size_default
  assign cols_desktop = section.settings.product_per_row
  assign cols_mobile = section.settings.product_per_row_mobile
  assign scheme = section.settings.collection_color_scheme
  assign filter_layout = section.settings.filter_type | default: 'vertical'
-%}

{% style %}
  #CollectionSection-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
  }

  #CollectionProductGrid-{{ section.id }} {
    --cols-desktop: {{ cols_desktop }};
    --cols-mobile: {{ cols_mobile }};
  }
{% endstyle %}

<div
  id="CollectionSection-{{ section.id }}"
  class="collection-section color-{{ scheme }}"
  data-section-id="{{ section.id }}"
  data-section="{{ section.id }}"
>
  <div class="page-width">
    {%- paginate collection.products by page_size -%}
      {%- assign show_facets = false -%}
      {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
        {%- assign show_facets = true -%}
      {%- endif -%}

      {%- capture extra_hidden_inputs -%}
        {%- if collection.sort_by != blank -%}
          <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
        {%- endif -%}
      {%- endcapture -%}

      <div class="collection-products__layout{% if show_facets and filter_layout == 'vertical' %} collection-products__layout--sidebar{% endif %}">
        {%- if show_facets and filter_layout == 'vertical' -%}
          <aside
            class="collection-products__facets"
            id="FacetsFilters-{{ section.id }}"
            aria-label="{{ 'search.filters' | t: default: 'Filters' }}"
          >
            {%- render 'facets',
              filters: collection.filters,
              form_id: 'FacetsForm',
              extra_hidden_inputs: extra_hidden_inputs,
              layout: 'vertical'
            -%}
          </aside>
        {%- endif -%}

        <div class="collection-products__main">
          <div
            id="FacetsAnnounce-{{ section.id }}"
            class="visually-hidden"
            aria-live="polite"
            aria-atomic="true"
            role="status"
          ></div>
          <div class="collection-products__toolbar">
            <div
              class="collection-products__toolbar-start"
              {% if show_facets and filter_layout != 'vertical' %}
                id="FacetsFilters-{{ section.id }}"
              {% endif %}
            >
              {%- if show_facets and filter_layout != 'vertical' -%}
                {%- render 'facets',
                  filters: collection.filters,
                  form_id: 'FacetsForm',
                  extra_hidden_inputs: extra_hidden_inputs,
                  layout: filter_layout
                -%}
              {%- endif -%}
            </div>

            <div class="collection-products__toolbar-end">
              {%- if section.settings.enable_sorting -%}
                <div id="FacetsSort-{{ section.id }}">
                  <form class="collection-products__sort" action="{{ collection.url }}" method="get">
                    <label for="FacetsSortBy">{{ 'search.sort_by' | t: default: 'Sort by' }}</label>
                    <select id="FacetsSortBy" name="sort_by">
                      {%- for option in collection.sort_options -%}
                        <option
                          value="{{ option.value | escape }}"
                          {% if option.value == collection.sort_by %}
                            selected
                          {% endif %}
                        >
                          {{ option.name | escape }}
                        </option>
                      {%- endfor -%}
                    </select>
                    <noscript>
                      <button type="submit">{{ 'search.apply' | t: default: 'Apply' }}</button>
                    </noscript>
                  </form>
                </div>
              {%- endif -%}
              <div id="FacetsProductCount-{{ section.id }}">
                <p class="collection-products__count" tabindex="-1">
                  {{ collection.products_count }}
                  {{ 'search.items' | t: default: 'items' }}
                </p>
              </div>
            </div>
          </div>

          <div id="FacetsActiveFilters-{{ section.id }}">
            {%- render 'facets-active', filters: collection.filters -%}
          </div>

          <div
            id="FacetsProductGrid-{{ section.id }}"
            class="collection-grid"
            tabindex="-1"
            aria-label="{{ collection.title }} products"
          >
            {%- if collection.products.size == 0 -%}
              <div class="collection-empty" data-facets-empty role="status">
                <p class="collection-empty__text">{{ 'collections.general.no_matches' | t }}</p>
              </div>

            {%- else -%}
              {%- for product in collection.products -%}
                {%- render 'product-card',
                  product: product,
                  show_quick_add: settings.show_quick_add,
                  quick_add_hover_only: settings.enable_quick_button_on_hover,
                  lazy: forloop.index
                -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- if paginate.pages > 1 -%}
        <div
          id="FacetsPagination-{{ section.id }}"
          class="collection-pagination"
          data-facets-pagination
          aria-label="{{ 'accessibility.pagination_label' | t }}"
        >
          {%- render 'pagination', pagination: paginate -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:general.collection",
  "tag": "section",
  "class": "section-collection",
  "settings": [
    {
      "type": "header",
      "content": "t:general.filter_and_sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:labels.enable_filters",
      "default": true,
      "info": "t:informative_content.filters_info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "drawer",
          "label": "Drawer"
        }
      ],
      "default": "horizontal",
      "label": "Filter layout"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:labels.sort_selector",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.product_grid"
    },
    {
      "type": "select",
      "id": "product_per_row",
      "label": "Products per row (desktop)",
      "options": [
        {
          "label": "2",
          "value": "2"
        },
        {
          "label": "3",
          "value": "3"
        },
        {
          "label": "4",
          "value": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "product_per_row_mobile",
      "label": "Products per row (mobile)",
      "options": [
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "page_size_default",
      "label": "t:labels.items_per_page",
      "min": 12,
      "max": 50,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "color_scheme",
      "id": "collection_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ]
}
{% endschema %}
