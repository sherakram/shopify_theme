{{ 'page.css' | asset_url | stylesheet_tag }}

{% liquid
  assign scheme = section.settings.page_color_scheme
%}

{%- style -%}
  #page-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="page-wrapper color-{{ scheme }}">
  <div class="main-page" id="page-{{ section.id }}">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'title' %}
            <h1
              class="main-page-title page-width--narrow"
              style="margin-bottom: {{ section.settings.title_gap }}px; --text-align:{{ block.settings.title_alignment }};"
            >
              {{ page.title | escape }}
            </h1>
          {% when 'content' %}
            <div class="page-content page-width--narrow">
              {{ page.content }}
            </div>
          {% else %}

        {% endcase %}
      {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.page",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "title_gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:labels.title_gap",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.section_settings"
    },
    {
      "type": "color_scheme",
      "id": "page_color_scheme",
      "label": "t:sections.all.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "t:blocks.labels.title",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:general.layout"
        },
        {
          "type": "select",
          "id": "title_alignment",
          "label": "t:labels.alignment",
          "options": [
            {
              "value": "left",
              "label": "t:blocks.options.left"
            },
            {
              "value": "center",
              "label": "t:blocks.options.left"
            },
            {
              "value": "right",
              "label": "t:blocks.options.right"
            }
          ],
          "default": "left"
        }
      ]
    },
    {
      "type": "content",
      "name": "t:blocks.names.content",
      "limit": 1
    }
  ]
}
{% endschema %}
