{%- liquid
  assign heading_block = section.blocks | where: 'type', 'heading' | first
  assign heading_level = heading_block.settings.heading_size | default: 'h1'
-%}

{%- style -%}
  .hero-{{ section.id }} {
    position: relative;
    display: flex;
    align-items: {{ section.settings.content_position | default: 'center' }};
    justify-content: center;
    min-height: {{ section.settings.image_height | default: 60 }}vh;
    color: var(--color-foreground, #fff);
    overflow: hidden;
  }

  .hero-{{ section.id }}__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-{{ section.id }}__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 9; /* CLS: reserves space before decode */
  }

  .hero-{{ section.id }}__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | default: 30 | divided_by: 100.0 }});
  }

  .hero-{{ section.id }}__content {
    position: relative;
    z-index: 1;
    max-width: 640px;
    text-align: center;
    padding: 2rem 1.5rem;
  }

  .hero-{{ section.id }}__content h1,
  .hero-{{ section.id }}__content h2 {
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }

  .hero-{{ section.id }}__content p {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    margin: 0 0 1.5rem;
  }

  .hero-{{ section.id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px; /* WCAG 2.5.8 target size */
    min-width: 44px;
    padding: 0.75rem 1.75rem;
    border-radius: var(--button-radius, 4px);
    background: var(--color-button, #111);
    color: var(--color-button-text, #fff);
    text-decoration: none;
    font-weight: 600;
  }

  /* WCAG 2.4.7 - never remove focus outlines, use focus-visible for keyboard-only */
  .hero-{{ section.id }}__button:focus {
    outline: none;
  }
  .hero-{{ section.id }}__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-{{ section.id }} * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
{%- endstyle -%}

<section
  class="hero-{{ section.id }} color-{{ section.settings.color_scheme }}"
  aria-label="{{ heading_block.settings.heading | default: 'Hero banner' | strip_html | escape }}"
>
  <div class="hero-{{ section.id }}__media">
    {%- if section.settings.image -%}
      {{-
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          decoding: 'sync',
          widths: '375, 750, 1100, 1500, 2200, 3000',
          sizes: '100vw',
          alt: section.settings.image.alt
      -}}
    {%- else -%}
      {{- 'hero-apparel-1' | placeholder_svg_tag: 'hero-placeholder' -}}
    {%- endif -%}
    <div class="hero-{{ section.id }}__overlay" aria-hidden="true"></div>
  </div>

  <div class="hero-{{ section.id }}__content">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          {%- if block.settings.heading != blank -%}
            <{{ heading_level }} {{ block.shopify_attributes }}>
              {{- block.settings.heading -}}
            </{{ heading_level }}>
          {%- endif -%}

        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endif -%}

        {%- when 'button' -%}
          {%- if block.settings.button_label != blank -%}
            <a
              href="{{ block.settings.button_link | default: '#' }}"
              class="hero-{{ section.id }}__button"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.button_label -}}
            </a>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Section height (vh)",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 60
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content vertical position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "info": "Keep enough contrast so text meets WCAG AA (4.5:1) over the image."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Your Brand Headline"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading level",
          "info": "Use H1 only if this is the first heading on the page (SEO + screen reader outline).",
          "options": [
            { "value": "h1", "label": "H1 — page title" },
            { "value": "h2", "label": "H2 — section heading" }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>A short, benefit-driven subheading.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
