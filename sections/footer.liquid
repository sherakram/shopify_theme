{{ 'footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_year = 'now' | date: '%Y'
  assign has_newsletter = section.settings.newsletter_enable
  assign has_locale_form = false
  if localization.available_countries.size > 1 or localization.available_languages.size > 1
    assign has_locale_form = true
  endif
-%}

{% style %}
  #footer-{{ section.id }} {
    --footer-padding-top: {{ section.settings.padding_top }}px;
    --footer-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<footer id="footer-{{ section.id }}" class="footer color-{{ section.settings.color_scheme }}" role="contentinfo">
  {%- if has_newsletter -%}
    <div class="footer__newsletter">
      <div class="page-width">
        <div class="footer__newsletter-inner">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="footer__newsletter-heading">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <div class="footer__newsletter-text">{{ section.settings.newsletter_text }}</div>
          {%- endif -%}

          {%- form 'customer', id: 'FooterNewsletterForm', class: 'footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">

            <div class="footer__newsletter-field">
              <label class="visually-hidden" for="FooterNewsletterEmail">
                {{ 'footer.newsletter_form.email_placeholder' | t: default: 'Email address' }}
              </label>
              <input
                type="email"
                id="FooterNewsletterEmail"
                name="contact[email]"
                class="footer__newsletter-input"
                value="{{ form.email }}"
                placeholder="{{ 'footer.newsletter_form.email_placeholder' | t: default: 'Email address' }}"
                autocomplete="email"
                required
                aria-invalid="{% if form.errors %}true{% else %}false{% endif %}"
                {% if form.errors %}
                  aria-describedby="FooterNewsletterError"
                {% endif %}
              >
              <button
                type="submit"
                class="footer__newsletter-submit btn"
                aria-label="{{ 'footer.newsletter_form.submit' | t: default: 'Subscribe' }}"
              >
                {{ 'footer.newsletter_form.submit' | t: default: 'Subscribe' }}
              </button>
            </div>

            {%- if form.errors -%}
              <p
                id="FooterNewsletterError"
                class="footer__newsletter-message footer__newsletter-message--error"
                role="alert"
                tabindex="-1"
              >
                {{ form.errors.messages.email | default: 'Please enter a valid email address.' }}
              </p>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <p class="footer__newsletter-message footer__newsletter-message--success" role="status" tabindex="-1">
                {{ 'footer.newsletter_form.confirmation' | t: default: 'Thanks for subscribing!' }}
              </p>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="footer__main page-width">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'app' -%}
            {% render block %}
          {%- when 'link_list' -%}
            <div class="footer__block footer__block--menu" {{ block.shopify_attributes }}>
              <details
                class="footer__disclosure"
                {% if block.settings.heading == blank %}
                  open
                {% endif %}
              >
                <summary class="footer__heading">
                  <h2>{{ block.settings.heading | default: block.settings.menu.title }}</h2>
                  <span class="footer__disclosure-icon" aria-hidden="true"></span>
                </summary>
                <nav
                  class="footer__menu-nav"
                  aria-label="{{ block.settings.heading | default: block.settings.menu.title }}"
                >
                  <ul class="footer__menu-list" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li class="footer__menu-item">
                        <a
                          href="{{ link.url }}"
                          class="footer__menu-link"
                          {% if link.active %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
              </details>
            </div>

          {%- when 'text' -%}
            <div class="footer__block footer__block--text" {{ block.shopify_attributes }}>
              <details
                class="footer__disclosure"
                {% if block.settings.heading == blank %}
                  open
                {% endif %}
              >
                <summary class="footer__heading">
                  <h2>{{ block.settings.heading }}</h2>
                  <span class="footer__disclosure-icon" aria-hidden="true"></span>
                </summary>
                <div class="footer__rich-text">
                  {{ block.settings.text }}
                </div>
              </details>
            </div>
          {%- when 'brand_info' -%}
            <div class="footer__block footer__block--brand">
              {%- if block.settings.logo != blank -%}
                {%- assign logo_alt = block.settings.logo.alt | default: shop.name -%}
                {%- assign logo_height = block.settings.logo_width | divided_by: block.settings.logo.aspect_ratio -%}
                <a href="{{ routes.root_url }}" class="footer__logo-link" aria-label="{{ shop.name }}">
                  {{
                    block.settings.logo
                    | image_url: width: 400
                    | image_tag:
                      loading: 'lazy',
                      width: block.settings.logo_width,
                      height: logo_height,
                      alt: logo_alt,
                      class: 'footer__logo'
                  }}
                </a>
              {%- else -%}
                <a href="{{ routes.root_url }}" class="footer__brand-name">{{ shop.name }}</a>
              {%- endif -%}

              {%- if block.settings.brand_text != blank -%}
                <div class="footer__brand-text">{{ block.settings.brand_text }}</div>
              {%- endif -%}

              {%- if section.settings.show_social_icons -%}
                <div class="footer__social">
                  {%- render 'social-icons' -%}
                </div>
              {%- endif -%}

              {%- if section.settings.enable_follow_on_shop and shop.features.follow_on_shop? -%}
                <div class="footer__follow-on-shop">
                  {{ shop | login_button: action: 'follow' }}
                </div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="footer__bottom">
    <div class="page-width footer__bottom-inner">
      <div class="footer__copyright">
        <small class="copyright__content">
          &copy; {{ current_year }}
          {{ shop.name | link_to: routes.root_url }}
          {%- if section.settings.copyright_text != blank %} &mdash; {{ section.settings.copyright_text }}{% endif -%}
        </small>
        {%- if section.settings.show_policy -%}
          <ul class="policies list-unstyled">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <small class="copyright__content">
                    <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                  </small>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if has_locale_form -%}
        <div class="footer__localization">
          {%- form 'localization', id: 'FooterLocalizationForm' -%}
            {% if section.settings.enable_country_selector %}
              {%- if localization.available_countries.size > 1 -%}
                <div class="footer__locale-field">
                  <label class="visually-hidden" for="FooterCountry">
                    {{- 'localization.country_label' | t: default: 'Country/region' -}}
                  </label>
                  <select name="country_code" id="FooterCountry" class="footer__locale-select" data-locale-form-submit>
                    {%- for country in localization.available_countries -%}
                      <option
                        value="{{ country.iso_code }}"
                        {% if country.iso_code == localization.country.iso_code %}
                          selected
                        {% endif %}
                      >
                        {{ country.name }} ({{ country.currency.iso_code }}
                        {{ country.currency.symbol }})
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}
            {% endif %}

            {% if section.settings.enable_language_selector %}
              {%- if localization.available_languages.size > 1 -%}
                <div class="footer__locale-field">
                  <label class="visually-hidden" for="FooterLanguage">
                    {{- 'localization.language_label' | t: default: 'Language' -}}
                  </label>
                  <select name="locale_code" id="FooterLanguage" class="footer__locale-select" data-locale-form-submit>
                    {%- for language in localization.available_languages -%}
                      <option
                        value="{{ language.iso_code }}"
                        {% if language.iso_code == localization.language.iso_code %}
                          selected
                        {% endif %}
                      >
                        {{ language.endonym_name | capitalize }}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}
            {% endif %}

            <noscript>
              <button type="submit" class="btn footer__locale-submit">
                {{ 'localization.update' | t: default: 'Update' }}
              </button>
            </noscript>
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul
          class="footer__payment-list"
          role="list"
          aria-label="{{ 'footer.payment.methods' | t: default: 'Payment methods' }}"
        >
          {%- for type in shop.enabled_payment_types -%}
            <li class="footer__payment-item">
              {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section--footer",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Text",
      "default": "<p>Get first access to new arrivals, sales and more.</p>"
    },
    {
      "type": "header",
      "content": "t:content.footer_utilities"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "label": "t:blocks.labels.follow_on_shop",
      "default": true,
      "info": "t:blocks.informative_content.follow_on_shop_info"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "social media icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "t:blocks.labels.country_selector",
      "default": true,
      "info": "t:blocks.informative_content.country_selector_info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "t:blocks.labels.language_selector",
      "default": true,
      "info": "t:blocks.informative_content.language_selector_info"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "Policy links",
      "default": true,
      "info": "t:blocks.informative_content.policy_links_info"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Additional copyright text",
      "info": "Appears after the shop name and year"
    },
    {
      "type": "header",
      "content": "t:content.section_settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "Menu",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About us"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add store hours, contact info, or address here.</p>"
        }
      ]
    },
    {
      "type": "brand_info",
      "name": "Brand information",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Brand"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Logo width",
          "min": 60,
          "max": 300,
          "step": 10,
          "unit": "px",
          "default": 140
        },
        {
          "type": "richtext",
          "id": "brand_text",
          "label": "Text",
          "default": "<p>Add a short brand statement here.</p>"
        }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      {
        "type": "link_list",
        "settings": {
          "heading": "Quick links"
        }
      },
      {
        "type": "text",
        "settings": {
          "heading": "Contact"
        }
      }
    ]
  }
}
{% endschema %}
