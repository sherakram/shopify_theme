<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" />
    {% endif %}


    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}
    
    {% # Search %}
    {{ 'search.css' | asset_url | stylesheet_tag }}
    
    {% # Social Media %}
    {{ 'social-icons.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    {{ 'vendor-swiper-bundle.min.css' | asset_url | stylesheet_tag }}

  </head>

  <body>
    <div id="skiptocontent" role="region" aria-label="Keyboard Navigation links" tabindex="-1">
      <a class="skip-to-content-link button visually-hidden" href="#MainContent">
        {{ 'accessibility.skip_to_text' | t }}
      </a>
    </div>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script src="{{ 'search.js' | asset_url }}" defer></script>
    
    <script src="{{ 'vendor-swiper-bundle.min.js' | asset_url }}" defer></script>
    <script src="{{ 'product-info.js' | asset_url }}" defer></script>
    
    <!--Global JS-->
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
