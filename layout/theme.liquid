<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">

    {%- liquid
      assign is_filtered_collection = false
      if template.name == 'collection' and collection.filters.size > 0
        for filter in collection.filters
          if filter.active_values.size > 0
            assign is_filtered_collection = true
          endif
          if filter.type == 'price_range' and filter.min_value.value != blank or filter.max_value.value != blank
            assign is_filtered_collection = true
          endif
        endfor
      endif
    -%}

    {%- if is_filtered_collection -%}
      <link rel="canonical" href="{{ collection.url }}">
      <meta name="robots" content="noindex, follow">
    {%- else -%}
      <link rel="canonical" href="{{ canonical_url }}">
    {%- endif -%}

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" />
    {% endif %}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}


    {{ 'search.css' | asset_url | stylesheet_tag }}
    {{ 'social-icons.css' | asset_url | stylesheet_tag }}
    {{ 'vendor-swiper-bundle.min.css' | asset_url | stylesheet_tag }}

    <!-- Global JS -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body>
    <div id="skiptocontent" role="region" aria-label="Keyboard Navigation links" tabindex="-1">
      <a class="skip-to-content-link button visually-hidden" href="#MainContent">
        {{ 'accessibility.skip_to_text' | t }}
      </a>
    </div>

    {% sections 'header-group' %}
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}

    <script src="{{ 'search.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'vendor-swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
