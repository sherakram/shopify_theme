{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <meta name="robots" content="noindex, nofollow">
    <link rel="canonical" href="{{ canonical_url }}">

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" />
    {% endif %}

    <title>{{ 'gift_card.title' | t: shop: shop.name }}</title>

    <meta name="description" content="{{ 'gift_card.subtext' | t }}">

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'gift-card.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>

    {% style %}
      :root {
        --transition:   0.28s cubic-bezier(0.4, 0, 0.2, 1);

        --gc-card-bg-1: {{ settings.gc_card_bg_1 }};
        --gc-card-bg-2: {{ settings.gc_card_bg_2 }};
        --gc-card-bg-3: {{ settings.gc_card_bg_3 }};

        --gc-card-heading: {{ settings.gc_card_heading }};
        --gc-card-muted: {{ settings.gc_card_muted }};
        --gc-card-border: {{ settings.gc_card_border }};
        --gc-card-accent: {{ settings.gc_card_accent }};
        --gc-card-status: {{ settings.gc_card_status }};
      }
    {% endstyle %}
  </head>

  <body
    class="color-{{ settings.gift_card_scheme | default: 'scheme-1' }}"
    data-copied-text="{{ 'gift_card.copied' | t | default: 'Copied!' }}"
  >

    {% assign gc_status = 'active' %}

    {% unless gift_card.enabled %}
      {% assign gc_status = 'disabled' %}
    {% elsif gift_card.expired %}
      {% assign gc_status = 'expired' %}
    {% elsif gift_card.balance <= 0 %}
      {% assign gc_status = 'used' %}
    {% endunless %}
    
    {% assign display_balance = gift_card.balance %}

    {% if gc_status == 'disabled' or gc_status == 'used' %}
      {% assign display_balance = 0 %}
    {% endif %}

    <div id="skiptocontent" role="region" aria-label="Keyboard Navigation links" tabindex="-1">
      <a class="skip-to-content-link button visually-hidden" href="#MainContent">
        {{ 'accessibility.skip_to_text' | t }}
      </a>
    </div>

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      <div class="gc-wrapper">
        <header class="gc-shop-header">
          {% if settings.logo_image %}
            <div class="gc-shop-logo">
              <h1>
                {{
                  settings.logo_image
                  | image_url: width: 200
                  | image_tag:
                    alt: shop.name,
                    widths: '100, 150, 200',
                    sizes: '200px',
                    width: 200,
                    height: 36,
                    loading: 'eager'
                }}
              </h1>
            </div>
          {% else %}
            <div class="gc-shop-name">
              <h1>{{ shop.name }}</h1>
            </div>
          {% endif %}
        </header>

        <div
          class="gc-card {% if settings.gift_card_shimmer %}has-shimmer{% endif %}"
          role="region"
          aria-label="{{ 'gift_card.gift_card' | t }}"
        >
          <div class="gc-card-circle" aria-hidden="true"></div>

          <div class="gc-card-top">
            <div>
              <span class="gc-card-label">{{ 'gift_card.gift_card' | t | default: 'Gift Card' }}</span>
            </div>

            {% case gc_status %}
              {% when 'disabled' %}
                <span class="gc-card-status inactive">
                  {{ 'gift_card.disabled' | t | default: 'Disabled' }}
                </span>

              {% when 'expired' %}
                <span class="gc-card-status inactive">
                  {{ 'gift_card.expired' | t | default: 'Expired' }}
                </span>

              {% when 'used' %}
                <span class="gc-card-status inactive">
                  {{ 'gift_card.used' | t | default: 'Used' }}
                </span>

              {% else %}
                <span class="gc-card-status active">
                  {{ 'gift_card.active' | t | default: 'Active' }}
                </span>
              {% endcase %}
            
          </div>

          <div class="gc-card-balance-area">
            <p class="gc-balance-label">{{ 'gift_card.remaining_balance' | t | default: 'Remaining Balance' }}</p>
            <h2 class="gc-balance">{{ display_balance | money }}</h2>
            {% if gift_card.balance != gift_card.initial_value %}
              <div class="gc-initial-value">
                {{ 'gift_card.original_value' | t | default: 'Original' }}:
                {{ gift_card.initial_value | money }}
              </div>
            {% endif %}
          </div>

          <div class="gc-card-bottom">
            <p class="gc-code-masked" aria-hidden="true">
              •••• •••• •••• <span class="gc-code-last4">{{ gift_card.last_four_characters }}</span>
            </p>
            {% if gift_card.expires_on %}
              {%- assign expires_formatted = gift_card.expires_on | date: '%m / %y' -%}
              <div class="gc-expiry-area">
                <span class="gc-expiry-label">{{ 'gift_card.valid_thru' | t | default: 'Valid Thru' }}</span>
                <div class="gc-expiry-value">{{ expires_formatted }}</div>
              </div>
            {% else %}
              <div class="gc-expiry-area">
                <p class="gc-expiry-label">{{ 'gift_card.valid_thru' | t | default: 'Valid Thru' }}</p>
                <p class="gc-expiry-value">No Expiry</p>
              </div>
            {% endif %}
          </div>
        </div>

        <div class="gc-panels">
          {% if gc_status == 'disabled' %}
            <div class="gc-panel gc-expired-panel" role="alert">
              <div class="gc-expired-label">
                {{ 'gift_card.disabled' | t | default: 'This gift card has been disabled' }}
              </div>
            </div>
          {% elsif gc_status == 'expired' %}
            <div class="gc-panel gc-expired-panel" role="alert">
              <div class="gc-expired-label">
                {%- assign expires_on = gift_card.expires_on | date: '%B %-d, %Y' -%}
                {{- 'gift_card.expires_on' | t: expires_on: expires_on | default: expires_on -}}
              </div>
            </div>
          {% endif %}

          <div class="gc-panel">
            <div class="gc-code-panel">
              <div class="gc-code-panel-left">
                <p class="gc-code-panel-label">{{ 'gift_card.redeem_code' | t | default: 'Redeem Code' }}</p>
                <code class="gc-code-full" id="gc-code-text">{{ gift_card.code | format_code }}</code>
              </div>
              <button
                type="button"
                class="gc-copy-btn"
                id="gc-copy-btn"
                aria-label="{{ 'gift_card.copy_code' | t | default: 'Copy code' }}"
                data-code="{{ gift_card.code }}"
              >
                {{ 'gift_card.copy' | t | default: 'Copy' }}
              </button>
            </div>
          </div>

          {% if gift_card.expires_on and gc_status == 'active' %}
            {%- assign expires_on = gift_card.expires_on | date: '%B %-d, %Y' -%}
            <div class="gc-panel gc-expiry-panel">
              <div class="gc-expiry-info">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                {{- 'gift_card.expires_on' | t: expires_on: expires_on | default: expires_on -}}
              </div>
            </div>
          {% endif %}

          {% if gift_card.recipient %}
            <div class="gc-panel">
              <div class="gc-recipient-row">
                <div>
                  <div class="gc-recipient-label">{{ 'gift_card.recipient' | t | default: 'Gift For' }}</div>
                  <div class="gc-recipient-value">{{ gift_card.recipient.email }}</div>
                </div>
                {% if gift_card.send_on %}
                  {%- assign send_on = gift_card.send_on | date: '%B %-d, %Y' -%}
                  <div class="gc-send-date">
                    <div class="gc-recipient-label">{{ 'gift_card.send_on' | t | default: 'Send Date' }}</div>
                    <div class="gc-recipient-value">{{ send_on }}</div>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% if gift_card.message != blank %}
            <div class="gc-panel">
              <div class="gc-message-panel-label">{{ 'gift_card.message' | t | default: 'Personal Message' }}</div>
              <div class="gc-message-text">"{{ gift_card.message }}"</div>
            </div>
          {% endif %}
        </div>

        <div class="gc-qr-wallet">
          <div class="gc-qr-wrap">
            <div id="gc-qr-code" data-qr-identifier="{{ gift_card.qr_identifier }}" aria-hidden="true"></div>
            <div class="gc-qr-hint">{{ 'gift_card.scan_qr' | t | default: 'Scan to redeem' }}</div>
          </div>

          {% if gift_card.pass_url %}
            <a
              href="{{ gift_card.pass_url }}"
              class="gc-apple-wallet"
              aria-label="{{ 'gift_card.add_to_apple_wallet' | t }}"
            >
              <img
                src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
                width="180"
                height="54"
                loading="lazy"
              >
            </a>
          {% endif %}
        </div>

        <div class="gc-actions">
          <button type="button" id="gc-print-btn" class="gc-btn gc-btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="6 9 6 2 18 2 18 9"/>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
              <rect x="6" y="14" width="12" height="8"/>
            </svg>
            {{ 'gift_card.print' | t | default: 'Print' }}
          </button>

          <a href="{{ shop.url }}" class="gc-btn gc-btn-ghost">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            {{ 'gift_card.shop_link' | t | default: 'Visit Store' }}
          </a>
        </div>

        <footer class="gc-footer">
          {{ shop.name }} &bull; {{ 'gift_card.footer_note' | t | default: 'Valid for in-store and online purchases' }}
        </footer>
      </div>

      <div id="gc-live-region" class="visually-hidden" aria-live="polite"></div>
    </main>

    <script src="{{ 'gift-card.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
