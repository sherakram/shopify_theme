        "desktop_height": "medium",
        "mobile_height": "adapt",
        "content_alignment": "center",
        "content_width": "medium",
        "color_scheme": "scheme-2",
        "padding_top": 0,
        "padding_bottom": 0
      },
      "blocks": {
        "subheading": {
          "type": "subheading",
          "settings": {
            "sub_text": "New arrival"
